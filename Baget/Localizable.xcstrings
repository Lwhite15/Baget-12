        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe n'a pas pu accéder au web à l'instant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 방금 웹에 연결하지 못했어요."
          }
        }
      }
    },
    "Your squad hasn't picked anything yet. Set up a scout or rate a few finds and this fills up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón aún no ha elegido nada. Configura un explorador o califica algunos hallazgos y esto se llenará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe n'a encore rien sélectionné. Créez un éclaireur ou notez quelques trouvailles et ça se remplira."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 아직 고른 게 없어요. 스카우트를 설정하거나 발견을 몇 개 평가하면 채워져요."
          }
        }
      }
    },
    "Your squad is hunting": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón está buscando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe est en chasse"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 찾는 중이에요"
          }
        }
      }
    },
    "Your squad keeps hunting in the background and will text you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón sigue buscando en segundo plano y te enviará un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe continue la chasse en arrière-plan et vous enverra un SMS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 백그라운드에서 계속 찾고, 문자로 알려 드려요."
          }
        }
      }
    },
    "Your squad kept searching the web and found %lld new thing%@ for you.%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad kept searching the web and found %1$lld new thing%2$@ for you.%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón siguió buscando en la web y encontró %1$lld novedad%2$@ para ti.%3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a continué de fouiller le web et a trouvé %1$lld nouveauté%2$@ pour vous.%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 웹을 계속 검색해서 새로운 발견 %1$lld개%2$@를 찾았어요.%3$@"
          }
        }
      }
    },
    "Your squad looked. Nothing new fits you right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón buscó. No hay nada nuevo que te quede bien por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a cherché. Rien de nouveau qui vous corresponde pour l'instant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 살펴봤어요. 지금은 맞는 새 상품이 없어요."
          }
        }
      }
    },
    "Your squad ran %lld sweep%@, checked about %lld listings and found %lld new thing%@ for you.%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad ran %1$lld sweep%2$@, checked about %3$lld listings and found %4$lld new thing%5$@ for you.%6$@%7$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón hizo %1$lld barrido%2$@, revisó unos %3$lld anuncios y encontró %4$lld novedad%5$@ para ti.%6$@%7$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a fait %1$lld passage%2$@, vérifié environ %3$lld annonces et trouvé %4$lld nouveauté%5$@ pour vous.%6$@%7$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 %1$lld번%2$@ 검색하고, 약 %3$lld개의 상품을 확인해서 새로운 발견 %4$lld개%5$@를 찾았어요.%6$@%7$@"
          }
        }
      }
    },
    "Your squad searches on our servers even when your phone is off. Each search costs a little, so less often is cheaper. You can always pull down on Live to check now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón busca en nuestros servidores aunque tu teléfono esté apagado. Cada búsqueda cuesta un poco, así que buscar menos seguido sale más barato. Siempre puedes deslizar hacia abajo en Live para revisar ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe cherche sur nos serveurs même quand votre téléphone est éteint. Chaque recherche a un petit coût, donc moins souvent revient moins cher. Vous pouvez toujours tirer Live vers le bas pour vérifier maintenant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰이 꺼져 있어도 스카우트 팀은 우리 서버에서 검색해요. 검색할 때마다 비용이 조금 들어서, 간격이 길수록 저렴해요. 라이브에서 아래로 당겨 언제든 바로 확인할 수 있어요."
          }
        }
      }
    },
    "Your squad's best %lld right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld mejores de tu escuadrón ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld meilleures trouvailles de votre équipe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 스카우트 팀의 베스트 %lld개예요."
          }
        }
      }
    },
    "Your squad's first hunt is on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera búsqueda de tu escuadrón ya empezó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première chasse de votre équipe est lancée"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀의 첫 탐색이 시작됐어요"
          }
        }
      }
    },
    "Your taste": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estilo"
          }
        },
        "fr": {
          "stringUnit": {
