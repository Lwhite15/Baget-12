    "Opens Baget's settings, where you can pick English, Español, Français or 한국어": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los ajustes de Baget, donde puedes elegir English, Español, Français o 한국어"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages de Baget, où tu peux choisir English, Español, Français ou 한국어"
