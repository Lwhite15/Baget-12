    "Month and day only. Friends who share taste see it next to gift ideas for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mes y día. Los amigos que comparten gustos lo ven junto a ideas de regalo para ti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buwan at araw lang. Makikita ito ng mga kaibigang kapareho ng taste, katabi ng gift ideas para sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jour et mois uniquement. Les amis qui partagent leurs goûts le voient à côté des idées de cadeaux pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ महीना और तारीख़। पसंद शेयर करने वाले दोस्त इसे आपके लिए गिफ्ट आइडिया के साथ देखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya bulan dan tanggal. Teman dengan selera sama bisa melihatnya di samping ide hadiah untukmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月と日だけです。テイストを共有している友だちには、ギフトのアイデアと一緒に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월과 일만 표시돼요. 취향을 공유하는 친구에게 선물 아이디어와 함께 보여요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเดือนและวัน เพื่อนที่แชร์รสนิยมจะเห็นคู่กับไอเดียของขวัญสำหรับคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần tháng và ngày. Bạn bè cùng chia sẻ gu sẽ thấy ngày này cạnh các ý tưởng quà tặng cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示月和日。品味相同的好友会在送礼灵感旁看到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需月份和日期。分享品味的好友會在送禮靈感旁看到。"
          }
        }
      }
    },
