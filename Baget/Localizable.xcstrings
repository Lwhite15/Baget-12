    "Found one for you! The %@ is up right now at %@ for %@. It's so you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Found one for you! The %1$@ is up right now at %2$@ for %3$@. It's so you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Encontré uno para ti! El %1$@ está disponible ahora en %2$@ por %3$@. Es muy a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'en ai trouvé un pour vous ! %1$@ est dispo maintenant chez %2$@ pour %3$@. Il est fait pour vous."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱 맞는 걸 찾았어요! %1$@ 지금 %2$@에서 %3$@에 판매 중이에요. 완전 취향 저격이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけました!%1$@が今、%2$@で%3$@です。まさにあなた向け。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm được món cho bạn rồi! %1$@ đang có tại %2$@ giá %3$@. Quá hợp với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你找到啦!%1$@现在在%2$@有货,售价%3$@。太适合你了。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada nih buatmu! %1$@ lagi tersedia di %2$@ seharga %3$@. Kamu banget."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫你找到了!%1$@ 現在在 %2$@ 有貨,售價 %3$@。超適合你。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจอแล้ว! %1$@ มีขายที่ %2$@ ราคา %3$@ ใช่คุณเลย"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May nahanap ako para sa iyo! Available na ngayon ang %1$@ sa %2$@ for %3$@. Bagay na bagay sa iyo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए एक मिला! %1$@ अभी %2$@ पर %3$@ में मिल रहा है। एकदम आपके जैसा।"
          }
        }
      }
    },
    "Found something you'll like: the %@, %@ at %@. Has that %@ thing you're into.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Found something you'll like: the %1$@, %2$@ at %3$@. Has that %4$@ thing you're into."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontré algo que te va a gustar: el %1$@, %2$@ en %3$@. Tiene ese toque %4$@ que te gusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai trouvé un truc qui va vous plaire : %1$@, %2$@ chez %3$@. Il a ce côté %4$@ que vous aimez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 들 만한 걸 찾았어요: %2$@ %1$@, %3$@에서 판매 중이에요. 좋아하시는 %4$@ 느낌이 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気に入りそうなものを見つけました:%2$@の%1$@、%3$@です。好みの%4$@系ですよ。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có món bạn sẽ thích: %1$@, %2$@ tại %3$@. Đúng chất %4$@ bạn mê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现你可能喜欢的:%1$@,%2$@,在%3$@。带有你喜欢的%4$@元素。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketemu yang kamu suka: %1$@, %2$@ di %3$@. Ada unsur %4$@ yang kamu suka."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到你可能會喜歡的:%1$@,%2$@,在 %3$@。有你愛的 %4$@ 風格。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจอของที่น่าจะถูกใจ: %1$@ %2$@ ที่ %3$@ มีสไตล์ %4$@ แบบที่คุณชอบ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May nahanap akong baka magustuhan mo: ang %1$@, %2$@ sa %3$@. Meron itong %4$@ na hilig mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको पसंद आएगा: %1$@, %2$@, %3$@ पर। इसमें वो %4$@ वाली बात है जो आपको भाती है।"
          }
        }
      }
    },
