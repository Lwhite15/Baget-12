          }
        }
      }
    },
    "Your squad looked. Nothing new fits you right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón buscó. No hay nada nuevo que te quede bien por ahora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumingin ang squad mo. Wala pang bagong bagay sa iyo ngayon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a cherché. Rien de nouveau qui vous corresponde pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम ने देखा। अभी कुछ नया आप पर नहीं जँचता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu sudah mencari. Belum ada yang baru yang cocok denganmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームが探しましたが、今のところあなたに合う新着はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 살펴봤어요. 지금은 맞는 새 상품이 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณดูแล้ว ตอนนี้ยังไม่มีอะไรใหม่ที่เหมาะกับคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout đã xem. Hiện chưa có gì mới hợp với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团看过了。目前没有适合你的新品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊找過了，目前沒有適合你的新東西。"
          }
        }
      }
    },
    "Your squad ran %lld %@, checked about %lld listings and found %lld new %@ for you.%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad ran %1$lld %2$@, checked about %3$lld listings and found %4$lld new %5$@ for you.%6$@%7$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo hizo %1$lld %2$@, revisó unos %3$lld anuncios y encontró %4$lld %5$@ nuevos para ti.%6$@%7$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-run ang squad mo ng %1$lld %2$@, nag-check ng mga %3$lld listing at nakahanap ng %4$lld bagong %5$@ para sa iyo.%6$@%7$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a lancé %1$lld %2$@, analysé environ %3$lld annonces et déniché %4$lld %5$@ de plus pour vous.%6$@%7$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम ने %1$lld %2$@ चलाईं, करीब %3$lld लिस्टिंग देखीं और आपके लिए %4$lld नई %5$@ ढूँढीं।%6$@%7$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu menjalankan %1$lld %2$@, memeriksa sekitar %3$lld listingan, dan menemukan %4$lld %5$@ baru untukmu.%6$@%7$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームが%1$lld回の%2$@を実行し、約%3$lld件の出品を確認して、新しい%5$@を%4$lld件見つけました。%6$@%7$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 %2$@ %1$lld회를 진행하고 약 %3$lld개의 상품을 확인해서 새 %5$@ %4$lld개를 찾았어요.%6$@%7$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณค้นหา %1$lld %2$@ ตรวจรายการราว %3$lld รายการ และเจอ%5$@ใหม่ %4$lld ชิ้นให้คุณ%6$@%7$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout đã chạy %1$lld %2$@, kiểm tra khoảng %3$lld tin đăng và tìm được %4$lld %5$@ mới cho bạn.%6$@%7$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团进行了 %1$lld 轮%2$@,查看了约 %3$lld 条商品信息,为你找到 %4$lld 个新%5$@。%6$@%7$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊執行了 %1$lld 次%2$@，查看約 %3$lld 筆商品，為你找到 %4$lld 個新%5$@。%6$@%7$@"
          }
        }
      }
    },
    "Your squad ran %lld sweep%@, checked about %lld listings and found %lld new thing%@ for you.%@%@": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad ran %1$lld sweep%2$@, checked about %3$lld listings and found %4$lld new thing%5$@ for you.%6$@%7$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón hizo %1$lld barrido%2$@, revisó unos %3$lld anuncios y encontró %4$lld novedad%5$@ para ti.%6$@%7$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-run ang squad mo ng %1$lld sweep%2$@, nag-check ng mga %3$lld listing at nakahanap ng %4$lld bagong item%5$@ para sa iyo.%6$@%7$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a fait %1$lld passage%2$@, vérifié environ %3$lld annonces et trouvé %4$lld nouveauté%5$@ pour vous.%6$@%7$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम ने %1$lld सर्च%2$@ चलाईं, करीब %3$lld लिस्टिंग देखीं और आपके लिए %4$lld नई चीज़%5$@ ढूँढीं।%6$@%7$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 %1$lld번%2$@ 검색하고, 약 %3$lld개의 상품을 확인해서 새로운 발견 %4$lld개%5$@를 찾았어요.%6$@%7$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณค้นหา %1$lld รอบ%2$@ ตรวจรายการราว %3$lld รายการ และเจอของใหม่ %4$lld ชิ้น%5$@ให้คุณ%6$@%7$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout đã chạy %1$lld lượt quét%2$@, kiểm tra khoảng %3$lld tin đăng và tìm được %4$lld món đồ mới%5$@ cho bạn.%6$@%7$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团进行了 %1$lld 轮搜索%2$@,查看了约 %3$lld 条商品信息,为你找到 %4$lld 件新商品%5$@。%6$@%7$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊執行了 %1$lld 次搜尋%2$@，查看約 %3$lld 筆商品，為你找到 %4$lld 個新東西%5$@。%6$@%7$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのスカウトが%1$lld回%2$@巡回し、約%3$lld件の出品をチェックして、新しい発見を%4$lld件%5$@見つけました。%6$@%7$@"
          }
        }
      }
    },
    "Your squad searches on our servers even when your phone is off. Each search costs a little, so less often is cheaper. You can always pull down on Live to check now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón busca en nuestros servidores aunque tu teléfono esté apagado. Cada búsqueda cuesta un poco, así que buscar menos seguido sale más barato. Siempre puedes deslizar hacia abajo en Live para revisar ahora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghahanap ang squad mo sa mga server namin kahit patay ang phone mo. May kaunting gastos ang bawat search, kaya mas mura kung mas bihira. Puwede mo laging i-pull down ang Live para mag-check ngayon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe cherche sur nos serveurs même quand votre téléphone est éteint. Chaque recherche a un petit coût, donc moins souvent revient moins cher. Vous pouvez toujours tirer Live vers le bas pour vérifier maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम हमारे सर्वर पर खोजती है, तब भी जब आपका फ़ोन बंद हो। हर सर्च में थोड़ा खर्च आता है, इसलिए कम बार करना सस्ता पड़ता है। अभी देखने के लिए आप Live में नीचे खींच सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu mencari di server kami bahkan saat ponselmu mati. Setiap pencarian butuh biaya kecil, jadi makin jarang makin hemat. Kamu selalu bisa tarik ke bawah di Live untuk memeriksa sekarang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームは、スマホの電源が切れていてもサーバー上で検索します。検索には少しコストがかかるため、頻度が低いほどお得です。「ライブ」を引き下げれば、いつでも今すぐ確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰이 꺼져 있어도 스카우트 팀은 우리 서버에서 검색해요. 검색할 때마다 비용이 조금 들어서, 간격이 길수록 저렴해요. 라이브에서 아래로 당겨 언제든 바로 확인할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณค้นหาบนเซิร์ฟเวอร์ของเราแม้ปิดมือถืออยู่ แต่ละครั้งมีค่าใช้จ่ายเล็กน้อย ยิ่งค้นหาไม่ถี่ยิ่งประหยัด คุณดึงลงที่ Live เพื่อเช็กตอนนี้ได้เสมอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout tìm kiếm trên máy chủ của chúng tôi kể cả khi điện thoại tắt. Mỗi lần tìm tốn một chút chi phí, nên tìm thưa hơn sẽ rẻ hơn. Bạn luôn có thể kéo xuống ở Live để kiểm tra ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使手机关机,你的买手团也会在我们的服务器上搜索。每次搜索都有少许成本,所以频率越低越省。你随时可以在 Live 下拉立即查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使手機關機，你的小隊也會在我們的伺服器上搜尋。每次搜尋都有些許成本，所以頻率越低越省。你隨時可以在「即時」下拉來立即查看。"
          }
        }
      }
    },
