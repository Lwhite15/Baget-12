    "Saved to Finds. %@ learned from it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en Hallazgos. %@ aprendió de esto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save sa Finds. May natutunan dito si %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté aux trouvailles. %@ en a tiré des leçons."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds में सेव हो गया। %@ ने इससे सीखा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan di Temuan. %@ belajar dari ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発見に保存しました。%@が学習しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견에 저장했어요. %@이(가) 이를 학습했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกในของที่เจอแล้ว %@ เรียนรู้จากสิ่งนี้แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu vào Phát hiện. %@ đã học được từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到发现。%@ 已从中学习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存到發現。%@ 從中學到了新口味。"
          }
        }
      }
    },
