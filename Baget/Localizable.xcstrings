    "Free for %@, then %@/%@. Cancel any time before the trial ends and you won't be charged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Free for %1$@, then %2$@/%3$@. Cancel any time before the trial ends and you won't be charged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis por %1$@, luego %2$@/%3$@. Cancela en cualquier momento antes de que termine la prueba y no se te cobrará."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libre for %1$@, then %2$@/%3$@. Mag-cancel anumang oras bago matapos ang trial at hindi ka masisingil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant %1$@, puis %2$@/%3$@. Annulez à tout moment avant la fin de l'essai et vous ne serez pas débité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ मुफ़्त, फिर %2$@/%3$@। ट्रायल खत्म होने से पहले कभी भी कैंसल करें, कोई चार्ज नहीं लगेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis %1$@, lalu %2$@/%3$@. Batalkan kapan saja sebelum uji coba berakhir dan kamu tidak akan ditagih."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@無料、その後は%2$@/%3$@。トライアル終了前ならいつでもキャンセルでき、料金はかかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 무료, 이후 %2$@/%3$@. 체험이 끝나기 전에 언제든 취소하면 요금이 청구되지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรี %1$@ จากนั้น %2$@/%3$@ ยกเลิกได้ทุกเมื่อก่อนหมดช่วงทดลองใช้ โดยไม่ถูกเรียกเก็บเงิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí %1$@, sau đó %2$@/%3$@. Hủy bất cứ lúc nào trước khi hết dùng thử là không bị tính phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前%1$@免费,之后%2$@/%3$@。试用结束前随时取消,不会扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費體驗 %1$@,之後 %2$@/%3$@。試用期結束前隨時可取消,不會收費。"
          }
        }
      }
    },
    "Free includes 2 scouts. Go Pro for up to 5.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis incluye 2 exploradores. Hazte Pro para tener hasta 5."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May 2 scout ang Free. Mag-Pro para hanggang 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut 2 éclaireurs. Passez à Pro pour en avoir jusqu'à 5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Free में 2 स्काउट शामिल हैं। 5 तक के लिए Pro लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket Gratis termasuk 2 scout. Upgrade ke Pro untuk hingga 5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランではスカウト2体まで。Proなら最大5体まで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 스카우트 2명을 쓸 수 있어요. Pro로 최대 5명까지 쓰세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฟรีมีสเกาต์ 2 ตัว อัปเป็น Pro ได้ถึง 5 ตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói Miễn phí có 2 scout. Lên Pro để có tối đa 5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版包含2个买手。升级 Pro 最多可用5个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版包含 2 位星探。升級 Pro 最多可有 5 位。"
          }
        }
      }
    },
    "Free includes 2 scouts. You can go Pro any time for up to 5, hunting around the clock.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis incluye 2 exploradores. Puedes pasarte a Pro cuando quieras para tener hasta 5, buscando todo el día."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May 2 scout ang Free. Puwede kang mag-Pro anumang oras para hanggang 5, na nagha-hunt 24/7."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut 2 éclaireurs. Passez à Pro quand vous voulez pour en avoir jusqu'à 5, en chasse 24h/24."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Free में 2 स्काउट शामिल हैं। 5 तक के लिए कभी भी Pro लें, जो दिन-रात हंट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket Gratis termasuk 2 scout. Kamu bisa upgrade ke Pro kapan saja untuk hingga 5 scout yang berburu nonstop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランではスカウト2体まで。Proにするといつでも最大5体まで、24時間ハントできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 스카우트 2명을 쓸 수 있어요. 언제든 Pro로 올리면 최대 5명이 24시간 탐색해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฟรีมีสเกาต์ 2 ตัว อัปเป็น Pro ได้ทุกเมื่อเพื่อให้มีถึง 5 ตัว ล่าให้ตลอด 24 ชม."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói Miễn phí có 2 scout. Bạn có thể lên Pro bất cứ lúc nào để có tới 5 scout, săn suốt ngày đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版包含2个买手。随时升级 Pro,最多可用5个,全天候搜寻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版包含 2 位星探。隨時可升級 Pro,最多 5 位,全天候搜尋。"
          }
        }
      }
    },
