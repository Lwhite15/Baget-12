    "Found one for you! The %@ is up right now at %@ for %@. It's so you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Found one for you! The %1$@ is up right now at %2$@ for %3$@. It's so you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Encontré uno para ti! El %1$@ está disponible ahora en %2$@ por %3$@. Es muy a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'en ai trouvé un pour vous ! %1$@ est dispo maintenant chez %2$@ pour %3$@. Il est fait pour vous."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱 맞는 걸 찾았어요! %1$@ 지금 %2$@에서 %3$@에 판매 중이에요. 완전 취향 저격이에요."
          }
        }
      }
    },
    "Found something you'll like: the %@, %@ at %@. Has that %@ thing you're into.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Found something you'll like: the %1$@, %2$@ at %3$@. Has that %4$@ thing you're into."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontré algo que te va a gustar: el %1$@, %2$@ en %3$@. Tiene ese toque %4$@ que te gusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai trouvé un truc qui va vous plaire : %1$@, %2$@ chez %3$@. Il a ce côté %4$@ que vous aimez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 들 만한 걸 찾았어요: %2$@ %1$@, %3$@에서 판매 중이에요. 좋아하시는 %4$@ 느낌이 있어요."
          }
        }
      }
    },
