    "Pick a few. You'll get a personal scout for each, hunting drops, restocks and deals.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige algunas. Tendrás un explorador personal para cada una, buscando lanzamientos, reposiciones y ofertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en quelques-uns. Tu auras un éclaireur perso pour chacun, à l'affût des sorties, des retours en stock et des bons plans."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 가지를 골라 주세요. 각각에 맞는 개인 스카우트가 발매, 재입고, 특가를 찾아드려요."
          }
        }
      }
    },
    "Pick a photo, or this scout keeps its auto emoji.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto o este explorador mantendrá su emoji automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une photo, sinon cet éclaireur garde son emoji automatique."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 고르세요. 아니면 이 스카우트는 자동 이모지를 유지해요."
          }
        }
      }
    },
    "Pick a size": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una talla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une taille"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이즈 선택"
          }
        }
      }
    },
    "Pick a time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une heure"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 선택"
          }
        }
      }
    },
    "Pick up to %lld. You'll get a personal scout for each, hunting drops, restocks and deals.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige hasta %lld. Tendrás un explorador personal para cada una, buscando lanzamientos, reposiciones y ofertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en jusqu'à %lld. Tu auras un éclaireur perso pour chacun, à l'affût des sorties, des retours en stock et des bons plans."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld개까지 고르세요. 각각에 맞는 개인 스카우트가 발매, 재입고, 특가를 찾아드려요."
          }
        }
      }
    },
    "Pick your %@ first. Your scout only hunts what's in stock in it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elige tu %@. Tu explorador solo busca lo que hay en stock en esa opción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis d'abord ta %@. Ton éclaireur ne cherche que ce qui est en stock dans cette taille."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 %@을(를) 골라 주세요. 스카우트가 해당 사이즈 재고가 있는 상품만 찾아요."
          }
        }
      }
    },
    "Pick your %@. This scout only hunts things in stock in your size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu %@. Este explorador solo busca lo que hay en stock en tu talla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ta %@. Cet éclaireur ne cherche que ce qui est en stock dans ta taille."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 골라 주세요. 이 스카우트는 내 사이즈 재고가 있는 상품만 찾아요."
          }
        }
      }
    },
    "Picked from everything Baget's scouts have found, ranked by your taste. Every ♥ and ✕ sharpens it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado entre todo lo que han encontrado los exploradores de Baget, ordenado según tu gusto. Cada ♥ y ✕ lo afina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection parmi toutes les trouvailles des éclaireurs de Baget, classée selon tes goûts. Chaque ♥ et ✕ l'affine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 스카우트가 찾은 모든 상품 중에서 취향 순으로 골랐어요. ♥와 ✕를 누를수록 더 정확해져요."
          }
        }
      }
    },
    "Picked from today's listings that match what %@ hunts%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Picked from today's listings that match what %1$@ hunts%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado de los anuncios de hoy que coinciden con lo que %1$@ busca%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionné parmi les offres du jour qui correspondent à ce que %1$@ recherche%2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 올라온 상품 중 %1$@이(가) 찾는 %2$@에 맞는 것만 골랐어요."
          }
        }
      }
    },
