    "Teach": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseñar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseigner"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려주기"
          }
        }
      }
    },
    "Teach it your taste, not just names. It surfaces things that share these traits, even ones you've never heard of.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enséñale tu gusto, no solo nombres. Encuentra cosas con estos rasgos, incluso las que nunca has oído nombrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends-lui tes goûts, pas seulement des noms. Il déniche des articles qui partagent ces traits, même des marques dont tu n'as jamais entendu parler."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 말고 취향을 알려주세요. 이런 특징을 가진 것들을 찾아와요. 처음 듣는 것도요."
          }
        }
      }
    },
