          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多告诉它一些"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多告訴它一些"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói thêm"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan lebih banyak"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกเพิ่ม"
          }
        },
        "fil": {
          "stringUnit": {
