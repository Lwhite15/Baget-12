    "Off. Not searching or texting until you switch it back on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. No buscará ni enviará mensajes hasta que lo reactives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Aucune recherche ni message tant que tu ne le réactives pas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐. 다시 켤 때까지 검색도 문자도 하지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ。オンに戻すまで、検索もメッセージも停止中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭。重新开启前不会搜索,也不会发消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉。在你重新開啟前,不會搜尋或傳訊息。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati. Tidak mencari atau mengirim pesan sampai kamu menyalakannya lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tắt. Sẽ không tìm kiếm hay nhắn tin cho đến khi bạn bật lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดอยู่ จะไม่ค้นหาและไม่ส่งข้อความจนกว่าคุณจะเปิดอีกครั้ง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off. Hindi maghahanap o magte-text hangga't hindi mo ito ibinabalik."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद। दोबारा चालू करने तक न खोज होगी, न मैसेज आएँगे।"
          }
        }
      }
    },
