    "Heart what you'd wear or buy, ✕ what you wouldn't. Your scouts start from your answers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale ♥ a lo que te pondrías o comprarías y ✕ a lo que no. Tus exploradores parten de tus respuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ❤️ pour ce que tu porterais ou achèterais, ✕ pour le reste. Tes éclaireurs partent de tes réponses."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입고 싶거나 사고 싶은 건 하트, 아닌 건 ✕를 눌러주세요. 스카우트가 답변을 바탕으로 시작해요."
          }
        }
      }
    },
    "Herman Miller, Cassina": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Herman Miller, Cassina"
          }
        },
