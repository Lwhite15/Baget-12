    "IT'S BACK. The %@ just restocked at %@. Want me to grab it before it's gone again?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "IT'S BACK. The %1$@ just restocked at %2$@. Want me to grab it before it's gone again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VOLVIÓ. El %1$@ se reabasteció en %2$@. ¿Quieres que lo consiga antes de que se agote otra vez?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "BALIK NA! Nag-restock na ang %1$@ sa %2$@. Gusto mo bang kunin ko bago maubos ulit?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IL EST DE RETOUR. Le %1$@ vient d'être réapprovisionné chez %2$@. Je le prends avant qu'il parte ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस आ गया! %2$@ पर %1$@ फिर स्टॉक में आया है। खत्म होने से पहले ले लूँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SUDAH BALIK. %1$@ baru saja restock di %2$@. Mau kuambilkan sebelum habis lagi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再入荷!%1$@が%2$@で再入荷しました。なくなる前に確保しましょうか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재입고됐어요! %2$@에 %1$@ 다시 들어왔어요. 또 품절되기 전에 잡아줄까요?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาแล้ว! %1$@ เพิ่งรีสต็อกที่ %2$@ ให้ฉันรีบคว้าไว้ก่อนหมดอีกไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CÓ HÀNG LẠI RỒI. %1$@ vừa về hàng tại %2$@. Muốn mình chốt trước khi hết lần nữa không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它回来了!%1$@在%2$@刚刚补货。要我趁又被抢光前拿下吗?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它回來了!%1$@ 剛在 %2$@ 補貨。要我趁又被搶光前買下嗎?"
          }
        }
      }
    },
