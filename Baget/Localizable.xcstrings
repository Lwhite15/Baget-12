    "Seems like %@ is your thing lately. I'll keep an eye out for more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que últimamente te gusta %@. Seguiré atento a más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait que %@ vous plaît en ce moment. Je continue de chercher."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요즘 %@에 빠지신 것 같아요. 계속 찾아볼게요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近好像很喜欢%@。我会继续帮你留意更多。"
