    "Share your taste to see match % and swap Taste Cards.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享你的品味，查看匹配度并交换品味卡。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage tes goûts pour voir ton % d'affinité et échanger des Taste Cards."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ gu của bạn để xem % hợp gu và đổi Taste Cards."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향을 공유하면 일치율을 확인하고 취향 카드를 교환할 수 있어요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना टेस्ट शेयर करें, मैच % देखें और टेस्ट कार्ड बदलें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์เทสต์ของคุณเพื่อดู % ที่ตรงกันและแลก Taste Cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu gusto para ver el % de afinidad e intercambiar Taste Cards."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享你的品味，查看契合度並交換品味卡。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-share ang taste mo para makita ang match % at makipagpalitan ng Taste Cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テイストを共有して、一致度を確認し、Taste Cardsを交換しましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan seleramu untuk lihat % kecocokan dan tukar Taste Cards."
          }
        }
      }
    },
