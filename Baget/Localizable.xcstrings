    "You already picked up the %@. This is close. Sure you want both?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya compraste el %@. Este es muy parecido. ¿Seguro que quieres ambos?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakuha mo na ang %@. Malapit ito rito. Sigurado ka bang gusto mo pareho?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as déjà récupéré les %@. C'est très proche. Tu veux vraiment les deux ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ पहले ही ले चुके हैं। यह उसके काफ़ी करीब है। पक्का दोनों चाहिए?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah mengambil %@. Ini mirip. Yakin mau dua-duanya?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はすでに購入済みです。これはかなり近いですが、両方買いますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 %@ 샀어요. 이건 비슷한데, 둘 다 살까요?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณซื้อ %@ ไปแล้ว ชิ้นนี้คล้ายกันมาก แน่ใจนะว่าจะเอาทั้งสอง?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã mua %@ rồi. Món này khá giống. Chắc muốn lấy cả hai chứ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经入手了 %@。这款很相似。确定两个都要吗?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經入手 %@ 了。這個很相似，確定兩個都要嗎？"
          }
        }
      }
    },
