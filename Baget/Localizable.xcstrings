    "Price drop: the %@ is now %@ at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Price drop: the %1$@ is now %2$@ at %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajó de precio: el %1$@ ahora está en %2$@ en %3$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumaba ang presyo: ang %1$@ ay %2$@ na lang sa %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse de prix : le %1$@ est maintenant à %2$@ chez %3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाम गिरा: %1$@ अब %3$@ पर %2$@ में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga turun: %1$@ kini %2$@ di %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値下げ:%1$@が%3$@で%2$@になりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 인하: %1$@ 상품이 %3$@에서 %2$@로 내려갔어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาลดแล้ว: %1$@ ตอนนี้ %2$@ ที่ %3$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm giá: %1$@ nay còn %2$@ tại %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
