    " Everything else still shows up in your inbox.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Todo lo demás sigue apareciendo en tu bandeja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tout le reste arrive toujours dans ta boîte de réception."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 나머지는 모두 받은편지함에 그대로 표시돼요."
          }
        }
      }
    },
