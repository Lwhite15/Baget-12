            "value": "Sepertinya kamu lagi suka %@. Aku akan cari yang lainnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ gần đây bạn mê %@. Mình sẽ để ý thêm nhé."
