    "Non-urgent texts wait for morning. Restocks, purchases and drops starting within 90 minutes still come through.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes no urgentes esperan hasta la mañana. Reposiciones, compras y lanzamientos que empiecen en menos de 90 minutos sí llegan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les SMS non urgents attendent le matin. Réassorts, achats et drops dans moins de 90 minutes passent quand même."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급하지 않은 문자는 아침까지 기다려요. 재입고, 구매, 90분 안에 시작하는 드롭은 그대로 알려드려요."
          }
        }
      }
    },
    "Normal texts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes normales"
          }
        },
        "fr": {
