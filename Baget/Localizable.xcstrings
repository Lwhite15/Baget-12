    "Asking is %lld%% under market. If you love it, this is the moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio pedido está %lld%% por debajo del mercado. Si te encanta, es el momento."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang presyo ay %lld%% na mas mura sa market. Kung gusto mo ito, ito na ang tamang pagkakataon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix demandé : %lld %% sous le marché. Si tu l'aimes, c'est le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माँगी गई कीमत मार्केट से %lld%% कम है। पसंद है तो यही मौका है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga tawarnya %lld%% di bawah pasar. Kalau kamu suka, inilah saatnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希望価格は相場より%lld%%安いです。気に入ったなら今がチャンスです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판매가가 시세보다 %lld%% 낮아요. 마음에 든다면 지금이 기회예요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาที่ตั้งต่ำกว่าตลาด %lld%% ถ้าชอบ ตอนนี้แหละ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá đang rao thấp hơn thị trường %lld%%. Nếu bạn thích, đây là lúc nên mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要价比市场价低 %lld%%。喜欢的话,就是现在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開價低於市價 %lld%%。如果你喜歡，就是現在。"
          }
        }
      }
    },
