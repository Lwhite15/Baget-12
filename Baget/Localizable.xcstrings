        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원님 사이즈(%@) 재고가 없어요"
          }
        }
      }
    },
    "Not in your size, so it isn't in Finds": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en tu talla, por eso no aparece en Hallazgos"
