    "Off by default. Purchases and prices stay private unless you turn this on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Tus compras y precios son privados a menos que lo actives."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off bilang default. Pribado ang mga binili at presyo maliban kung i-on mo ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Tes achats et les prix restent privés sauf si tu l'actives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से बंद। आप चालू करें तभी तक खरीदारी और कीमतें प्राइवेट रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif secara default. Pembelian dan harga tetap privat kecuali kamu mengaktifkannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定ではオフです。オンにしない限り、購入と価格は非公開です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐이에요. 켜기 전에는 구매 내역과 가격이 공개되지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดไว้เป็นค่าเริ่มต้น การซื้อและราคาจะเป็นส่วนตัว เว้นแต่คุณจะเปิดไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định là tắt. Giao dịch mua và giá được giữ riêng tư trừ khi bạn bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。除非你开启,否则购买和价格都会保密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉。除非你開啟,否則購買紀錄與價格都會保密。"
          }
        }
      }
    },
    "Off-road": {
      "localizations": {
