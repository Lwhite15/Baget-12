        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@會傳簡訊給你"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nhận được tin nhắn %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan dapat SMS %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับข้อความ %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makakatanggap ka ng text %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको %@ टेक्स्ट मिलेगा"
          }
        }
      }
    },
    "You're Pro. Your scouts hunt around the clock now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres Pro. Tus exploradores ahora buscan las 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes Pro. Vos éclaireurs chassent maintenant jour et nuit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro가 되셨어요. 이제 스카우트가 24시간 찾아다녀요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已是 Pro。买手现在全天候帮你搜寻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proになりました。スカウトが24時間ハントします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已是 Pro 會員。你的探員現在全天候搜尋。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là Pro. Các scout của bạn giờ săn lùng suốt ngày đêm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah Pro. Scout-mu kini berburu sepanjang waktu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็น Pro แล้ว สเกาต์ของคุณล่าให้ตลอดเวลา"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ka na. Walang tigil nang naghahanap ang mga scout mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप Pro हैं। अब आपके स्काउट दिन-रात खोजते हैं।"
          }
        }
      }
    },
    "You're all caught up. Your squad keeps hunting in the background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás al día. Tu escuadrón sigue buscando en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à jour. Votre équipe continue la chasse en arrière-plan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 확인했어요. 스카우트 팀은 백그라운드에서 계속 찾고 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已全部看完。买手团会在后台继续搜寻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて確認済みです。チームはバックグラウンドで探し続けます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已全部看完。你的小隊會在背景繼續搜尋。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xem hết rồi. Đội scout vẫn tiếp tục săn ngầm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sudah terlihat. Timmu terus berburu di latar belakang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณดูครบหมดแล้ว ทีมของคุณยังล่าต่อเบื้องหลัง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated ka na. Patuloy na naghahanap ang squad mo sa background."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सब देख चुके हैं। आपकी टीम बैकग्राउंड में खोजती रहती है।"
          }
        }
      }
    },
    "You're looking at sample data. Signing in lets your scouts search the real web, sync across your devices and connect with friends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo datos de muestra. Si inicias sesión, tus exploradores buscarán en la web real, se sincronizarán entre tus dispositivos y podrás conectar con amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez des données d'exemple. En vous connectant, vos éclaireurs fouillent le vrai web, se synchronisent sur vos appareils et se connectent à vos amis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 샘플 데이터예요. 로그인하면 스카우트가 실제 웹을 검색하고, 기기 간에 동기화하고, 친구와 연결할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在查看示例数据。登录后,买手即可搜索真实网络、跨设备同步并与好友互动。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータを表示中です。サインインすると、スカウトが実際のWebを検索でき、デバイス間の同期や友だちとのつながりも使えます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前看到的是範例資料。登入後，探員就能搜尋真實網路、在裝置間同步，並與朋友互動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang xem dữ liệu mẫu. Đăng nhập để scout tìm trên web thật, đồng bộ giữa các thiết bị và kết nối với bạn bè."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sedang melihat data contoh. Dengan masuk, scout-mu bisa menelusuri web sungguhan, sinkron di semua perangkat, dan terhubung dengan teman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกำลังดูข้อมูลตัวอย่าง เข้าสู่ระบบเพื่อให้สเกาต์ค้นหาบนเว็บจริง ซิงก์ข้ามอุปกรณ์ และเชื่อมต่อกับเพื่อน"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data ang tinitingnan mo. Kapag nag-sign in ka, makakapaghanap ang mga scout mo sa totoong web, magsi-sync sa lahat ng device mo at makakakonek ka sa mga kaibigan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सैंपल डेटा देख रहे हैं। साइन इन करने पर आपके स्काउट असली वेब पर खोजेंगे, आपके सभी डिवाइस में सिंक होंगे और दोस्तों से जुड़ पाएँगे।"
          }
        }
      }
    },
    "You're offline. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Vérifiez votre connexion et réessayez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이에요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。请检查网络后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。接続を確認してもう一度お試しください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前離線。請檢查網路連線後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sedang offline. Periksa koneksimu lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ka. Tingnan ang koneksyon mo at subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        }
      }
    },
    "You've already added @%@.": {
