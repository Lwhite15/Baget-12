          }
        }
      }
    },
    "Notify me when it's back in stock": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame cuando vuelva a haber stock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me prévenir du retour en stock"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재입고되면 알려주세요"
          }
        }
      }
    },
    "OFF": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NO"
          }
        },
        "fr": {
          "stringUnit": {
