          }
        }
      }
    },
    "No backend set up yet, so metrics stay on this phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay backend configurado, así que las métricas se quedan en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de backend configuré : les métriques restent sur ce téléphone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 백엔드가 설정되지 않아 지표는 이 휴대폰에만 저장돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンド未設定のため、指標はこのiPhone内にのみ保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置后端,所以指标只保存在这部手机上。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thiết lập backend, nên số liệu chỉ lưu trên điện thoại này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada backend, jadi metrik tetap di ponsel ini."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定後端,所以指標只會留在這支手機上。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งค่าแบ็กเอนด์ ตัวเลขจึงเก็บไว้ในเครื่องนี้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang backend, kaya sa phone na ito lang ang metrics."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई बैकएंड सेट नहीं है, इसलिए मेट्रिक्स इसी फ़ोन पर रहते हैं।"
          }
        }
      }
    },
    "No intel right now. Droplists, release calendars and news your scouts come across land here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin novedades por ahora. Aquí llegan las listas de lanzamientos, calendarios de estrenos y noticias que encuentren tus exploradores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'infos pour l'instant. Les listes de drops, calendriers de sorties et actus repérés par tes éclaireurs arrivent ici."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 소식이 없어요. 스카우트가 찾은 드롭리스트, 발매 일정, 뉴스가 여기에 모여요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は情報がありません。スカウトが見つけたドロップリスト、発売カレンダー、ニュースがここに届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有情报。发售清单、发售日历和侦察员发现的资讯都会出现在这里。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa có tin. Danh sách drop, lịch phát hành và tin tức trinh sát tìm thấy sẽ hiện ở đây."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada info. Droplist, kalender rilis, dan berita yang ditemukan scout-mu muncul di sini."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有情報。你的探員找到的發售清單、發售日曆和新聞都會出現在這裡。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังไม่มีข่าวสาร ลิสต์ดรอป ปฏิทินวางขาย และข่าวที่สเกาต์เจอจะมาอยู่ตรงนี้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang intel ngayon. Dito lalabas ang droplists, release calendars, at balitang nakikita ng mga scout mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई इंटेल नहीं। ड्रॉपलिस्ट, रिलीज़ कैलेंडर और आपके स्काउट को मिली खबरें यहाँ आएँगी।"
          }
        }
      }
    },
    "No limit": {
      "localizations": {
        "es": {
