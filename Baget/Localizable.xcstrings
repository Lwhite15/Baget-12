            "state": "translated",
            "value": "Vos sections, dans votre ordre"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सेक्शन, आपके क्रम में"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagianmu, sesuai urutanmu"
