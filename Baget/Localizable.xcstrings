    "%@ is being picky so you only see good matches. A brand, model or budget gives it much more to go on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está filtrando con cuidado para que solo veas buenas coincidencias. Una marca, modelo o presupuesto le da mucho más en qué basarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est sélectif pour que tu ne voies que de bons résultats. Une marque, un modèle ou un budget l'aide bien plus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 까다롭게 고르는 중이에요. 좋은 매치만 보여드리려고요. 브랜드, 모델, 예산을 알려주면 훨씬 더 잘 찾아요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang selektif agar kamu hanya melihat yang cocok. Merek, model, atau budget akan sangat membantunya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang kén chọn để bạn chỉ thấy những món thật hợp. Thêm thương hiệu, mẫu hoặc ngân sách sẽ giúp nó có nhiều thông tin hơn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 很挑剔,只讓你看到合適的商品。提供品牌、型號或預算,它會更有方向。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在严格筛选,只让你看到合适的匹配。填写品牌、型号或预算,它会更有方向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は厳選中なので、良いマッチだけが表示されます。ブランド、モデル、予算を指定すると、さらに精度が上がります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เลือกมากหน่อย คุณจะได้เห็นแต่ของที่ใช่ ถ้าระบุแบรนด์ รุ่น หรืองบ จะยิ่งหาได้แม่นขึ้น"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ज़रा चुनिंदा है, ताकि आपको सिर्फ़ अच्छे मैच दिखें। ब्रांड, मॉडल या बजट बताने से उसे बहुत मदद मिलती है।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pili ang %@ para puro magandang match lang ang makita mo. Mas marami siyang magagamit kung may brand, model o budget."
          }
        }
      }
    },
