    "Done! Grabbed the %@ for %@. It's in your Finds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Done! Grabbed the %1$@ for %2$@. It's in your Finds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Listo! Conseguí el %1$@ por %2$@. Está en tus Hallazgos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapos na! Nabili ang %1$@ sa halagang %2$@. Nasa Finds mo na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est fait ! %1$@ pour %2$@ : il est dans vos Trouvailles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया! %2$@ में %1$@ ले लिया। यह आपकी खोजों में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beres! %1$@ sudah dibeli seharga %2$@. Ada di Temuan-mu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了！%1$@を%2$@で購入しました。発見に入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료! %2$@에 %1$@ 구매했어요. 발견에서 확인해 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียบร้อย! ได้ %1$@ ในราคา %2$@ แล้ว อยู่ใน ของที่เจอ ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong! Đã chốt %1$@ với giá %2$@. Món này nằm trong Phát hiện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搞定!已以%2$@拿下%1$@,就在你的发现里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搞定!已用 %2$@ 買下 %1$@,就在你的發現裡。"
          }
        }
      }
    },
    "Downloads and App Store page views are in the App Store Connect app (Trends). Usage counts come from devices with analytics on; spend uses Claude list prices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas y las vistas de la página en el App Store están en la app App Store Connect (Tendencias). Los conteos de uso vienen de dispositivos con analíticas activadas; el gasto usa los precios de lista de Claude."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang downloads at page views ng App Store ay nasa App Store Connect app (Trends). Ang usage counts ay galing sa mga device na naka-on ang analytics; ang gastos ay gumagamit ng list prices ng Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements et les vues de la page App Store sont dans l'app App Store Connect (Tendances). Les stats d'utilisation viennent des appareils avec analyses activées ; les dépenses utilisent les prix publics de Claude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड और App Store पेज व्यूज़ App Store Connect ऐप (Trends) में हैं। इस्तेमाल की गिनती उन डिवाइस से आती है जिनमें एनालिटिक्स चालू है; खर्च Claude की लिस्ट कीमतों पर आधारित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan dan tampilan halaman App Store ada di app App Store Connect (Trends). Data penggunaan berasal dari perangkat yang mengaktifkan analitik; biaya memakai harga list Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード数とApp Storeのページビュー数は、App Store Connectアプリ（トレンド）で確認できます。利用回数は分析をオンにしているデバイスから集計され、費用はClaudeの定価で計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 수와 App Store 페이지 조회수는 App Store Connect 앱(Trends)에서 볼 수 있어요. 사용 횟수는 분석을 켠 기기에서 집계되고, 지출은 Claude 정가 기준이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดดาวน์โหลดและการเข้าชมหน้า App Store ดูได้ในแอป App Store Connect (Trends) ส่วนจำนวนการใช้งานมาจากอุปกรณ์ที่เปิดการวิเคราะห์ และค่าใช้จ่ายคิดจากราคาปกติของ Claude"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt tải và lượt xem trang App Store có trong ứng dụng App Store Connect (Trends). Số lượt dùng lấy từ các thiết bị bật phân tích; chi phí tính theo giá niêm yết của Claude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载量和 App Store 页面浏览量请在 App Store Connect 应用(趋势)中查看。使用次数来自开启了分析功能的设备;花费按 Claude 标价计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載次數和 App Store 頁面瀏覽次數請見 App Store Connect App(趨勢)。使用次數來自已開啟分析功能的裝置;花費採用 Claude 定價。"
          }
        }
      }
    },
    "Drag the handles to reorder. Swipe left to remove. Don't care about shoes or clothes? Remove them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controles para reordenar. Desliza a la izquierda para quitar. ¿No te interesan los zapatos ni la ropa? Quítalos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-drag ang handles para ayusin ang pagkakasunod. I-swipe pakaliwa para alisin. Walang pakialam sa sapatos o damit? Alisin mo na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées pour réorganiser. Balayez vers la gauche pour supprimer. Les chaussures ou les vêtements ne vous intéressent pas ? Supprimez-les."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए हैंडल खींचें। हटाने के लिए बाएँ स्वाइप करें। जूतों या कपड़ों में दिलचस्पी नहीं? उन्हें हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret gagang untuk mengurutkan. Geser ke kiri untuk menghapus. Tidak tertarik sepatu atau baju? Hapus saja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグして並べ替え。左にスワイプで削除。靴や服に興味がなければ削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 순서를 바꾸세요. 왼쪽으로 밀면 삭제돼요. 신발이나 옷에 관심 없다면 삭제해 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากที่จับเพื่อเรียงลำดับ ปัดซ้ายเพื่อนำออก ไม่สนใจรองเท้าหรือเสื้อผ้า? นำออกได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các tay cầm để sắp xếp lại. Vuốt trái để xóa. Không quan tâm giày hay quần áo? Hãy xóa chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄可重新排序,左滑可移除。不关心鞋或衣服?把它们移除吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳把手可重新排序,向左滑動可移除。不在意鞋子或衣服?把它們移除吧。"
          }
        }
      }
    },
