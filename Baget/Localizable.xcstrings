    "Nice taste. %lld noted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen gusto. %lld anotados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon goût. %lld enregistrés."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향 좋네요. %lld개 기억했어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいセンスですね。%lld件を記録しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "品味不错。已记录%lld项。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gu tốt đấy. Đã ghi nhận %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selera bagus. %lld tercatat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好品味。已記下 %lld 件。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รสนิยมดี บันทึกแล้ว %lld"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganda ng taste. %lld na ang naitala."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अच्छी पसंद। %lld नोट किए।"
          }
        }
      }
    },
    "Nice. It's off your list, and %@ will find more like it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genial. Ya no está en tu lista y %@ encontrará más como este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super. C'est retiré de ta liste, et %@ en trouvera d'autres du même genre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요. 목록에서 뺐고, %@가 비슷한 걸 더 찾아볼게요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解です。リストから外して、%@が似たアイテムをもっと探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好的。已从清单移除,%@ 会找更多类似的。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt. Đã xóa khỏi danh sách, và %@ sẽ tìm thêm món tương tự."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oke. Sudah dihapus dari daftarmu, dan %@ akan mencari yang serupa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好的,已從清單移除,%@ 會找更多類似的。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เยี่ยม ลบออกจากรายการแล้ว และ %@ จะหาแบบนี้เพิ่ม"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice. Wala na ito sa list mo, at hahanap pa si %@ ng kapareho."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया। यह आपकी लिस्ट से हट गया, और %@ ऐसी और खोजें लाएगा।"
          }
        }
      }
    },
    "No Baget Pro subscription found for this Apple ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una suscripción a Baget Pro para este Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement Baget Pro trouvé pour cet identifiant Apple."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple ID로 가입된 Baget Pro 구독이 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple IDではBaget Proのサブスクリプションが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
