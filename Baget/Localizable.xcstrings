    "Never miss what you'd love.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te pierdas lo que te encantaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne rate rien de ce que tu aimerais."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아할 만한 건 놓치지 마세요."
