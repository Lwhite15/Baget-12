            "value": "Merci ! Envoyé directement à l'équipe Baget."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사해요! Baget 팀에 바로 전달했어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます!Bagetチームに届きました。"
