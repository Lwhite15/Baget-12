            "state": "translated",
            "value": "%@ ปิดอยู่ ไม่ค้นหา ไม่ส่งข้อความ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang tắt. Không tìm kiếm, không nhắn tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭。不搜索,不发短信。"
