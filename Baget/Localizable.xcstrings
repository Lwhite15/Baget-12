          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊겼어요. 다시 보내줄래요?"
          }
        }
      }
    },
    "I won't flag anything until I know it, so you only see things that fit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te avisaré de nada hasta conocerte, así solo verás lo que va contigo."
          }
