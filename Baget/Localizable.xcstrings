    "@%@ is taken. Try another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ya está en uso. Prueba otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ est déjà pris. Essaie un autre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용 중인 핸들이에요: @%@. 다른 핸들을 써보세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sudah dipakai. Coba yang lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ đã có người dùng. Thử tên khác nhé."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 已被使用,請換一個。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 已被占用,换一个试试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@は使用済みです。別のものをお試しください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ มีคนใช้แล้ว ลองชื่ออื่นนะ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ पहले से लिया जा चुका है। कोई और आज़माएं।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamit na ang @%@. Subukan ang iba."
          }
        }
      }
    },
