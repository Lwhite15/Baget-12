    },
    "What do you love about it? e.g. suede, earth tones": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo que más te gusta? Ej.: gamuza, tonos tierra"
          }
        },
