            "state": "translated",
            "value": "Binili mo ito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez acheté celui-ci"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपने खरीद लिया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membeli yang ini"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを購入しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸 구매하셨어요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณซื้อชิ้นนี้แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã mua món này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你买了这件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你買過這個"
          }
        }
      }
    },
    "You buy it at %@; Baget never charges you. Tap \"I bought it\" afterwards so your scout learns from it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo compras en %@; Baget nunca te cobra. Toca \"Lo compré\" después para que tu explorador aprenda de eso."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibilhin mo ito sa %@; hindi ka kailanman sisingilin ng Baget. Pindutin ang \"Nabili ko na\" pagkatapos para matuto ang scout mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'achetez sur %@ ; Baget ne vous facture jamais. Touchez « Je l'ai acheté » ensuite pour que votre éclaireur apprenne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे %@ पर खरीदते हैं; Baget आपसे कभी कोई चार्ज नहीं लेता। बाद में \"मैंने खरीद लिया\" दबाएँ ताकि आपका स्काउट इससे सीखे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu beli di %@; Baget tidak pernah menagihmu. Ketuk \"Sudah kubeli\" setelahnya agar scout-mu belajar darinya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は%@で行われ、Bagetが課金することはありません。購入後に「買いました」をタップすると、スカウトが学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 직접 구매해요. Baget은 절대 결제하지 않아요. 구매 후 \"샀어요\"를 눌러 주세요. 스카우트가 보고 배워요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณซื้อที่ %@ Baget ไม่เก็บเงินคุณ หลังซื้อแล้วแตะ “ซื้อแล้ว” เพื่อให้สเกาต์เรียนรู้จากสิ่งนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mua tại %@; Baget không bao giờ tính phí bạn. Sau đó hãy nhấn \"Tôi đã mua\" để scout học hỏi từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %@ 下单,Baget 不会向你收费。买完后点“我已购买”,买手会从中学习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %@ 購買，Baget 絕不會向你收費。買完後請點「我買了」，讓你的探員從中學習。"
          }
        }
      }
    },
    "You sent": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaste"
          }
        },
        "fil": {
