    "Tell Baget what you're hunting on Today and a scout starts right away.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Baget qué buscas en Hoy y un explorador empieza de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Baget ce que tu chasses dans Aujourd'hui et un éclaireur se lance aussitôt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 탭에서 찾는 걸 Baget에 알려주면 스카우트가 바로 시작해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」画面で探しているものをBagetに伝えると、すぐにスカウトが動き出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“今日”告诉 Baget 你想找什么,猎手马上开工。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「今日」告訴 Baget 你想找什麼，偵察員馬上開始行動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho Baget biết bạn đang săn gì ở Hôm nay, trinh sát sẽ bắt đầu ngay."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu Baget apa yang kamu cari di Hari Ini, dan scout langsung mulai bekerja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอก Baget ในหน้าวันนี้ว่ากำลังตามหาอะไร สเคาต์จะเริ่มทันที"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin sa Baget kung ano'ng hinahanap mo sa Today at agad magsisimula ang scout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Today पर Baget को बताएँ कि आप क्या ढूँढ रहे हैं, और स्काउट तुरंत शुरू हो जाएगा।"
          }
        }
      }
    },
    "Tell Baget what you're into and this fills up with picks for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Baget qué te gusta y aquí verás selecciones para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Baget ce qui te plaît et cet espace se remplira de sélections pour toi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심사를 Baget에 알려주면 여기에 추천이 가득 채워져요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好みをBagetに伝えると、ここにあなた向けのおすすめが並びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉 Baget 你的喜好,这里就会为你精选好物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 Baget 你的喜好，這裡就會充滿為你挑選的精選。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho Baget biết bạn thích gì, mục này sẽ đầy các gợi ý dành cho bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu Baget apa yang kamu suka, dan halaman ini akan terisi pilihan untukmu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอก Baget ว่าคุณชอบอะไร แล้วที่นี่จะเต็มไปด้วยของที่เลือกมาให้คุณ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin sa Baget ang mga gusto mo at mapupuno ito ng mga pick para sa iyo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget को बताएँ कि आपको क्या पसंद है, और यहाँ आपके लिए चुनी हुई चीज़ें भर जाएँगी।"
          }
        }
      }
    },
    "Tell it more": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntale más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-lui en plus"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 알려주기"
