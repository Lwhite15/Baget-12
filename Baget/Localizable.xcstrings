            "state": "translated",
            "value": "आप: आइकन, सेटिंग्स और अकाउंट"
          }
        }
      }
    },
    "Your bar is empty.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu barra está vacía."
          }
        },
