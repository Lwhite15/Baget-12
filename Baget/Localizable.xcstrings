    "%@ checks the price twice a day and texts you if it drops%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ checks the price twice a day and texts you if it drops%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ revisa el precio dos veces al día y te envía un mensaje si baja%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vérifie le prix deux fois par jour et t'envoie un SMS s'il baisse%2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스카우트가 하루 두 번 가격을 확인하고, 내려가면 문자로 알려드려요%2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cek harga dua kali sehari dan kirim SMS kalau turun%2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kiểm tra giá hai lần mỗi ngày và nhắn tin cho bạn nếu giá giảm%2$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 每天查價兩次,降價時會傳訊息給你%2$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@每天查两次价格,降价时发短信通知你%2$@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は1日2回価格をチェックし、値下がりしたらテキストでお知らせします%2$@。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เช็กราคาวันละสองครั้ง และส่งข้อความหาคุณถ้าราคาลด%2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ दिन में दो बार कीमत चेक करता है और गिरने पर आपको टेक्स्ट करता है%2$@।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalawang beses sa isang araw chine-check ng %1$@ ang presyo at magte-text sa'yo kapag bumaba%2$@."
          }
        }
      }
    },
