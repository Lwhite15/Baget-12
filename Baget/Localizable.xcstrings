    },
    "You've passed on things at this price before. Flagging it anyway because it fits you so well.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes has descartado cosas a este precio. Te lo marco igual porque va muy bien contigo."
