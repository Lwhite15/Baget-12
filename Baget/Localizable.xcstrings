    "Your squad couldn't reach the web just now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón no pudo acceder a la web hace un momento."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ng squad mo ang web kanina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe n'a pas pu accéder au web à l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम अभी वेब तक नहीं पहुँच पाई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu tidak bisa menjangkau web barusan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームは今、Webに接続できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 방금 웹에 연결하지 못했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณเข้าเว็บไม่ได้ในตอนนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout vừa không vào được web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团刚才无法连接网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊剛剛連不上網路。"
          }
        }
      }
    },
    "Your squad does the hunting": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo hace la búsqueda"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang squad mo ang naghahanap"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bande s'occupe de la chasse"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ढूँढने का काम आपकी स्काउट टोली करती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu yang berburu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "探すのはスカウトチームにおまかせ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 대신 찾아줘요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมสเกาต์ของคุณล่าให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout của bạn lo việc săn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的侦察小队替你搜寻"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊負責搜尋"
          }
        }
      }
    },
    "Your squad hasn't picked anything yet. Set up a scout or rate a few finds and this fills up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón aún no ha elegido nada. Configura un explorador o califica algunos hallazgos y esto se llenará."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang napipili ang squad mo. Mag-set up ng scout o mag-rate ng ilang finds para mapuno ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe n'a encore rien sélectionné. Créez un éclaireur ou notez quelques trouvailles et ça se remplira."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम ने अभी कुछ नहीं चुना है। कोई स्काउट सेट करें या कुछ खोजों को रेट करें, फिर यह भर जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu belum memilih apa pun. Atur scout atau nilai beberapa temuan agar ini terisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームはまだ何も選んでいません。スカウトを設定するか、発見をいくつか評価すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 아직 고른 게 없어요. 스카우트를 설정하거나 발견을 몇 개 평가하면 채워져요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณยังไม่ได้เลือกอะไร ตั้งสเกาต์หรือให้คะแนนของที่เจอสักสองสามชิ้น แล้วตรงนี้จะเต็มเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout chưa chọn được gì. Hãy tạo một scout hoặc đánh giá vài phát hiện là chỗ này sẽ đầy lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团还没有挑出任何东西。设置一个买手或给几个发现打分,这里就会丰富起来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊還沒挑出任何東西。設定一位探員或評分幾個發現，這裡就會充實起來。"
          }
        }
      }
    },
    "Your squad is hunting": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón está buscando"
          }
        },
        "fil": {
