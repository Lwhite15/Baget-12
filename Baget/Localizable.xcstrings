    "Is this a good price?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es un buen precio?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maganda ba ang presyong ito?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un bon prix ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या यह अच्छी कीमत है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harganya bagus?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはお得な価格?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "괜찮은 가격일까요?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคานี้ดีไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá này ổn không?"
          }
        },
        "zh-Hans": {
