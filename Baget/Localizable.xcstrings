            "state": "translated",
            "value": "Sans limite"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 없음"
          }
        }
      }
    },
    "No new finds right now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay hallazgos nuevos por ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune nouvelle trouvaille pour l'instant"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 새 발견이 없어요"
          }
        }
      }
    },
    "No one on Baget goes by @%@. Check the spelling.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie en Baget usa @%@. Revisa la ortografía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne sur Baget ne s'appelle @%@. Vérifie l'orthographe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget에 @%@ 님은 없어요. 철자를 확인해 주세요."
          }
        }
      }
    },
    "No scouts yet. Tell Baget what you're hunting above.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay exploradores. Cuéntale arriba a Baget qué estás buscando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'éclaireur. Dis à Baget ce que tu cherches ci-dessus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스카우트가 없어요. 위에 찾는 걸 알려주세요."
          }
        }
      }
    },
    "No scouts yet. Tell Baget what you're hunting on Today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay exploradores. Cuéntale a Baget qué buscas en Hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'éclaireur. Dis à Baget ce que tu cherches sur Today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스카우트가 없어요. 투데이에서 찾는 걸 알려주세요."
          }
        }
      }
    },
