    "Market's below the asking price right now. I'd wait or buy it secondhand.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mercado está por debajo del precio pedido ahora. Esperaría o lo compraría de segunda mano."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mababa ang market sa presyong hinihingi ngayon. Maghintay ka muna o bilhin mo secondhand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le marché est sous le prix demandé pour l'instant. J'attendrais ou je l'achèterais d'occasion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी मार्केट भाव माँगी गई कीमत से कम है। रुकना या सेकंडहैंड लेना ठीक रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga pasar sekarang di bawah harga yang diminta. Sebaiknya tunggu atau beli bekas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は相場が希望価格より下です。待つか、中古で買うのがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 시세가 판매가보다 낮아요. 기다리거나 중고로 사는 게 좋겠어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ราคาตลาดต่ำกว่าราคาที่ตั้งขาย รอก่อนหรือซื้อมือสองดีกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện giá thị trường thấp hơn giá chào bán. Mình sẽ đợi hoặc mua đồ cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前市场价低于标价。建议再等等,或者买二手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前市價低於開價。建議再等等,或買二手。"
          }
        }
      }
    },
