          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเพิ่ม @%@ แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã thêm @%@ rồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已添加 @%@。"
          }
