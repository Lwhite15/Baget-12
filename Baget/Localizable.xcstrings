        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已關閉。不搜尋,也不傳訊息。"
          }
        }
      }
    },
    "%@ is on it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en eso"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaasikaso na ng %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'en occupe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ इसी काम में लगा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang mengerjakannya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が対応中です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 바로 찾는 중이에요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ กำลังจัดการ"
          }
        },
        "vi": {
