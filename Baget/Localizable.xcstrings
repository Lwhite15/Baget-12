        }
      }
    },
    "Tell Baget what you're hunting on Today and a scout starts right away.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Baget qué buscas en Hoy y un explorador empieza de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Baget ce que tu chasses dans Aujourd'hui et un éclaireur se lance aussitôt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 탭에서 찾는 걸 Baget에 알려주면 스카우트가 바로 시작해요."
          }
        }
      }
    },
    "Tell Baget what you're into and this fills up with picks for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Baget qué te gusta y aquí verás selecciones para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Baget ce qui te plaît et cet espace se remplira de sélections pour toi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심사를 Baget에 알려주면 여기에 추천이 가득 채워져요."
          }
        }
      }
    },
