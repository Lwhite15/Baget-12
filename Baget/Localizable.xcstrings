          "stringUnit": {
            "state": "translated",
            "value": "¡Ey! El %1$@ sale %2$@ en %3$@. Pura energía %4$@. ¿Quieres que prepare la compra?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hé ! Le %1$@ sort %2$@ à %3$@. Grosse énergie %4$@. Je prépare le paiement ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야! %1$@ %2$@에 %3$@에서 출시돼요. 완전 %4$@ 느낌이에요. 결제 준비해 둘까요?"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú"
          }
        },
