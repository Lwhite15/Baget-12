    "Free for %@, then %@/%@. Cancel any time before the trial ends and you won't be charged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Free for %1$@, then %2$@/%3$@. Cancel any time before the trial ends and you won't be charged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis por %1$@, luego %2$@/%3$@. Cancela en cualquier momento antes de que termine la prueba y no se te cobrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant %1$@, puis %2$@/%3$@. Annulez à tout moment avant la fin de l'essai et vous ne serez pas débité."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 무료, 이후 %2$@/%3$@. 체험이 끝나기 전에 언제든 취소하면 요금이 청구되지 않아요."
          }
        }
      }
    },
    "Free includes 2 scouts. Go Pro for up to 5.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis incluye 2 exploradores. Hazte Pro para tener hasta 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut 2 éclaireurs. Passez à Pro pour en avoir jusqu'à 5."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 스카우트 2명을 쓸 수 있어요. Pro로 최대 5명까지 쓰세요."
          }
        }
      }
    },
    "Free includes 2 scouts. You can go Pro any time for up to 5, hunting around the clock.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis incluye 2 exploradores. Puedes pasarte a Pro cuando quieras para tener hasta 5, buscando todo el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut 2 éclaireurs. Passez à Pro quand vous voulez pour en avoir jusqu'à 5, en chasse 24h/24."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 스카우트 2명을 쓸 수 있어요. 언제든 Pro로 올리면 최대 5명이 24시간 탐색해요."
          }
        }
      }
    },
