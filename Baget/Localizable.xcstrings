    "Pro includes up to %lld scouts. Retire one to add another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro incluye hasta %lld exploradores. Retira uno para agregar otro."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasama sa Pro ang hanggang %lld scout. Mag-retire ng isa para makapagdagdag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro inclut jusqu'à %lld éclaireurs. Retires-en un pour en ajouter un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro में ज़्यादा से ज़्यादा %lld स्काउट मिलते हैं। नया जोड़ने के लिए एक को रिटायर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro mencakup hingga %lld scout. Pensiunkan satu untuk menambah yang lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proではスカウトを最大%lld人まで持てます。追加するには1人引退させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro는 스카우트를 최대 %lld개까지 쓸 수 있어요. 하나를 은퇴시키면 추가할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro มีสเคาท์ได้สูงสุด %lld ตัว เลิกใช้หนึ่งตัวเพื่อเพิ่มตัวใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro gồm tối đa %lld scout. Cho một scout nghỉ để thêm scout mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 最多包含 %lld 个侦察员。撤下一个才能再添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 最多包含 %lld 位偵察員。請先撤換一位才能新增。"
          }
        }
      }
    },
