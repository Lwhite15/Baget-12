          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OUI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜짐"
          }
        }
      }
    },
    "OTHER STORES": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OTRAS TIENDAS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AUTRES BOUTIQUES"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 스토어"
          }
        }
      }
    },
    "Off by default. Purchases and prices stay private unless you turn this on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Tus compras y precios son privados a menos que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Tes achats et les prix restent privés sauf si tu l'actives."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐이에요. 켜기 전에는 구매 내역과 가격이 공개되지 않아요."
          }
        }
      }
    },
    "Off-road": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todoterreno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout-terrain"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프로드"
          }
        }
      }
    },
    "Off. Not searching or texting until you switch it back on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. No buscará ni enviará mensajes hasta que lo reactives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Aucune recherche ni message tant que tu ne le réactives pas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐. 다시 켤 때까지 검색도 문자도 하지 않아요."
          }
        }
      }
    },
    "Office": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oficina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bureau"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오피스"
          }
        }
      }
    },
    "Okay this is a steal: the %@ is %@, about %lld%% under what it trades for. Don't sleep on it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Okay this is a steal: the %1$@ is %2$@, about %3$lld%% under what it trades for. Don't sleep on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es una ganga: el %1$@ está en %2$@, cerca de %3$lld%% menos de lo que suele costar. No lo dejes pasar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là, c'est une affaire : le %1$@ est à %2$@, environ %3$lld %% sous son prix habituel. À ne pas rater."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이건 진짜 득템이에요: %1$@ 가격이 %2$@로, 시세보다 약 %3$lld%%나 저렴해요. 놓치지 마세요."
          }
        }
      }
    },
    "On something not out yet, tap Remind me and pick when. On something sold out, tap Notify me and you'll get a text when it's back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aún no sale, toca Recuérdame y elige cuándo. Si está agotado, toca Avísame y recibirás un mensaje cuando vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un article pas encore sorti, touche Me rappeler et choisis quand. Pour un article épuisé, touche Me prévenir et tu recevras un message dès son retour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 출시 전이면 '알림 받기'를 눌러 시간을 정하세요. 품절이면 '재입고 알림'을 누르세요. 다시 들어오면 문자를 보내드려요."
          }
        }
      }
    },
    "Once a day": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번"
          }
        }
      }
    },
    "Only standout finds buzz your phone": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los mejores hallazgos hacen vibrar tu teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les trouvailles exceptionnelles font vibrer ton téléphone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈에 띄는 발견만 알려드려요"
          }
        }
      }
