    "Added %@. Set up a scout to hunt it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agregó %@. Configura un explorador para buscarlo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naidagdag ang %@. Mag-set up ng scout para hanapin ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajouté. Crée un éclaireur pour le traquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ जोड़ा गया। इसे खोजने के लिए स्काउट सेट करें।"
          }
        },
        "id": {
