    "Your handle is @%@. Friends can send you things and see what you share.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu usuario es @%@. Tus amigos pueden enviarte cosas y ver lo que compartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identifiant est @%@. Vos amis peuvent vous envoyer des choses et voir ce que vous partagez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 아이디는 @%@예요. 친구가 아이템을 보내고 내가 공유한 것을 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的用户名是 @%@。好友可以给你发送商品,并查看你分享的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルは@%@です。友だちはあなたにアイテムを送ったり、シェアした内容を見たりできます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號是 @%@。朋友可以傳東西給你，也能看到你分享的內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người dùng của bạn là @%@. Bạn bè có thể gửi đồ cho bạn và xem những gì bạn chia sẻ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle-mu @%@. Teman bisa mengirimimu barang dan melihat apa yang kamu bagikan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อผู้ใช้ของคุณคือ @%@ เพื่อนส่งของให้คุณและดูสิ่งที่คุณแชร์ได้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ang handle mo. Makakapagpadala sa iyo ang mga kaibigan mo at makikita nila ang mga ishi-share mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हैंडल @%@ है। दोस्त आपको चीज़ें भेज सकते हैं और आपका शेयर किया हुआ देख सकते हैं।"
          }
        }
      }
    },
