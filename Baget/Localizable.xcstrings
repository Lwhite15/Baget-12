    "Use 3 to 24 letters, numbers, dots or underscores.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa de 3 a 24 letras, números, puntos o guiones bajos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng 3 hanggang 24 na letra, numero, tuldok o underscore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise 3 à 24 lettres, chiffres, points ou tirets bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 से 24 अक्षर, नंबर, डॉट या अंडरस्कोर इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan 3–24 huruf, angka, titik, atau garis bawah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3〜24文字の英数字、ドット、アンダースコアを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영문, 숫자, 마침표, 밑줄을 3~24자로 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตัวอักษร ตัวเลข จุด หรืออันเดอร์สกอร์ 3 ถึง 24 ตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 3 đến 24 chữ cái, số, dấu chấm hoặc dấu gạch dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 3 到 24 个字母、数字、点或下划线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 3 到 24 個字母、數字、句點或底線。"
          }
        }
      }
    },
