    "Heads up, the %@ drops %@ at %@. It's very your %@ thing. Want me to get checkout ready?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Heads up, the %1$@ drops %2$@ at %3$@. It's very your %4$@ thing. Want me to get checkout ready?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: el %1$@ sale el %2$@ en %3$@. Va muy con tu estilo %4$@. ¿Quieres que prepare el pago?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Info : le %1$@ sort %2$@ chez %3$@. Très ton style %4$@. Je prépare le paiement ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려드려요, %3$@에서 %1$@ 제품이 %2$@에 출시돼요. 딱 %4$@ 취향이에요. 결제 준비해 둘까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お知らせです。%1$@が%3$@で%2$@に発売されます。まさにあなた好みの%4$@系。購入の準備をしましょうか?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ý nhé, %1$@ sẽ ra mắt %2$@ tại %3$@. Rất hợp gu %4$@ của bạn. Muốn mình chuẩn bị sẵn thanh toán không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒一下,%1$@将于%2$@在%3$@发售。特别符合你的%4$@风格。要我准备好结账吗?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Info nih, %1$@ rilis %2$@ di %3$@. Ini banget gaya %4$@-mu. Mau kusiapkan checkout?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意,%1$@ 將於 %2$@ 在 %3$@ 發售。超符合你的 %4$@ 風格。要我先準備好結帳嗎?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนไว้ก่อน %1$@ จะวางขาย %2$@ ที่ %3$@ ใช่สาย %4$@ ของคุณเลย ให้เตรียมชำระเงินไว้ไหม"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads up, mag-drop ang %1$@ %2$@ sa %3$@. Bagay na bagay sa %4$@ mong hilig. Gusto mo bang ihanda ko ang checkout?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान दें, %1$@ %3$@ पर %2$@ को आ रहा है। एकदम आपके %4$@ वाले अंदाज़ का। चेकआउट तैयार रखूँ?"
          }
        }
      }
    },
