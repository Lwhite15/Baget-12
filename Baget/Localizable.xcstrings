    "What should it hunt? Vinyl, vintage Levi's, Pokémon cards…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué debe buscar? Vinilos, Levi's vintage, cartas Pokémon…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano'ng dapat niyang hanapin? Vinyl, vintage Levi's, Pokémon cards…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que doit-il chercher ? Vinyles, Levi's vintage, cartes Pokémon…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या खोजना है? विनाइल, विंटेज Levi's, Pokémon कार्ड…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang harus dicari? Vinyl, Levi's vintage, kartu Pokémon…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を探しますか?レコード、ヴィンテージLevi's、ポケモンカード…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 찾을까요? 바이닐, 빈티지 Levi's, 포켓몬 카드…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ล่าอะไรดี? แผ่นเสียง Levi's วินเทจ การ์ด Pokémon…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nên săn gì? Vinyl, Levi's cổ điển, thẻ Pokémon…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要找什么?黑胶、复古 Levi's、宝可梦卡牌…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要搜尋什麼？黑膠、古著 Levi's、寶可夢卡…"
          }
        }
      }
    },
    "What the people whose taste you trust are finding.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que están encontrando las personas en cuyo gusto confías."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga nahahanap ng mga taong pinagkakatiwalaan mo ang taste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que trouvent les gens dont tu aimes les goûts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनकी पसंद पर आप भरोसा करते हैं, वे क्या खोज रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang ditemukan orang-orang yang seleranya kamu percaya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが信頼する好みの人たちの発見です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향을 믿는 사람들이 발견한 것들이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คนที่คุณเชื่อรสนิยมกำลังเจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì người có gu bạn tin tưởng đang tìm thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你信赖的品味达人们正在发现的好物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你信任其品味的人正在發現的好物。"
          }
        }
      }
    },
    "What was off? %@ will learn from it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué falló? %@ aprenderá de esto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang mali? Matututo rito ang %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui n'allait pas ? %@ en tirera des leçons."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या गड़बड़ थी? इससे %@ सीखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang kurang pas? %@ akan belajar darinya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が違いましたか?%@が学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뭐가 아쉬웠나요? %@가 참고할게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอะไรไม่ใช่? %@ จะเรียนรู้จากเรื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có gì chưa ổn? %@ sẽ học từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪里不对?%@ 会从中学习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪裡不對？%@ 會從中學習。"
          }
        }
      }
    },
    "What would make Baget better for you?": {
      "localizations": {
        "es": {
          "stringUnit": {
