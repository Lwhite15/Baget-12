    "Like a friend texting you a photo of the thing. You choose how often in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como un amigo que te manda una foto del producto. Tú eliges la frecuencia en Ajustes."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Parang friend na nagte-text ng photo ng item. Ikaw ang pipili kung gaano kadalas sa Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme un ami qui t'envoie une photo du produit. Tu choisis la fréquence dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे कोई दोस्त उस चीज़ की फ़ोटो टेक्स्ट करे। कितनी बार, यह आप सेटिंग्स में चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti teman yang mengirim foto barangnya lewat chat. Atur seberapa sering di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちが気になるものの写真をメッセージで送ってくれる感じです。頻度は設定で選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 사진을 문자로 보내주는 것처럼요. 빈도는 설정에서 정할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือนเพื่อนส่งรูปของชิ้นนั้นมาให้ ตั้งความถี่ได้ในการตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như một người bạn nhắn tin gửi ảnh món đồ cho bạn. Bạn chọn tần suất trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就像朋友给你发来一张心仪好物的照片。你可以在“设置”中选择提醒频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就像朋友傳商品照片給你。頻率可在「設定」中選擇。"
          }
        }
      }
    },
    "Like and pass a few more finds and this gets sharper.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale «me gusta» o descarta unos hallazgos más y esto será más preciso."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-like at mag-pass ng ilan pang nahanap para mas tumpak ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Likez et ignorez encore quelques trouvailles pour affiner tout ça."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ और खोज लाइक करें या पास करें, तो यह और सटीक हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukai dan lewati beberapa temuan lagi, hasilnya jadi makin tajam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し発見にいいねやパスをすると、精度が上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견을 좋아요 하거나 패스하면 더 정확해져요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดถูกใจและข้ามของที่เจออีกหน่อย แล้วจะแม่นขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thích và bỏ qua thêm vài món tìm thấy để gu rõ nét hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再多喜欢或略过几个发现,结果会更精准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多喜歡或略過幾個發現，這裡會更精準。"
          }
        }
      }
    },
    "Like it, or Pass and say why": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale Me gusta, o Paso y cuéntanos por qué"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Like, o i-Pass at sabihin kung bakit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aime, ou passe et dis pourquoi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंद करें, या पास करें और वजह बताएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suka, atau Lewati dan beri alasannya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いいね」か、理由を添えて「パス」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요를 누르거나, 패스하고 이유를 알려 주세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกใจ หรือ ข้าม แล้วบอกเหตุผล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thích, hoặc Bỏ qua và cho biết lý do"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢就点赞,不喜欢就“略过”并说明原因"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜歡就按「喜歡」,不喜歡就按「略過」並告訴我們原因"
          }
        }
      }
    },
    "Like or pass what they bring, and they learn your taste fast": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale me gusta o descarta lo que traen y aprenderán tu estilo rápido"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-like o i-pass ang dala nila, at mabilis nilang matututunan ang taste mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aime ou refuse ce qu'ils trouvent, et ils apprennent vite tes goûts"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे जो लाएँ उसे लाइक या पास करें, वे आपकी पसंद जल्दी सीख लेंगे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukai atau lewati hasil buruan mereka, dan mereka cepat paham seleramu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトが見つけたものにいいね・パスをすると、好みをすばやく学習します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 가져온 것에 좋아요나 패스를 누르면 취향을 빠르게 배워요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดถูกใจหรือข้ามสิ่งที่สเกาต์หามา แล้วมันจะเรียนรู้สไตล์คุณไว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thích hoặc bỏ qua những gì trinh sát mang về, họ sẽ nhanh chóng hiểu gu của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢或略过它们找来的东西,它们会很快了解你的品味"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對探員帶回的東西按喜歡或略過,他們很快就會摸清你的品味"
          }
        }
      }
    },
