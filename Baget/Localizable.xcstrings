          }
        }
      }
    },
    "The %@ is going for %@, roughly %lld%% under market. Worth a look if you still want one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The %1$@ is going for %2$@, roughly %3$lld%% under market. Worth a look if you still want one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ está a %2$@, aproximadamente %3$lld%% por debajo del mercado. Vale la pena verlo si aún lo quieres."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa %2$@ ang %1$@, mga %3$lld%% na mas mura sa market. Sulit silipin kung gusto mo pa rin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %1$@ est à %2$@, soit environ %3$lld%% sous le prix du marché. Ça vaut le coup d'œil si tu en veux encore un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ अभी %2$@ में मिल रहा है, मार्केट से करीब %3$lld%% कम। अगर अब भी चाहिए तो देखने लायक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sedang dijual %2$@, sekitar %3$lld%% di bawah harga pasar. Layak dilirik kalau kamu masih mau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@で出ています。相場より約%3$lld%%安いです。まだ欲しいならチェックを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 가격은 %2$@로, 시세보다 약 %3$lld%%  저렴해요. 아직 관심 있다면 확인해 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ตอนนี้ราคา %2$@ ต่ำกว่าตลาดประมาณ %3$lld%% น่าดูถ้ายังอยากได้อยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang bán giá %2$@, thấp hơn thị trường khoảng %3$lld%%. Đáng xem nếu bạn vẫn muốn mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@现价 %2$@,比市场价低约 %3$lld%%。如果你还想要,值得看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 現價 %2$@，比市價低約 %3$lld%%。如果你還想要，值得看看。"
          }
        }
      }
    },
    "The %@ is sold out right now. I'll keep watching and tell you the second it's back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %@ está agotado por ahora. Seguiré vigilando y te aviso en cuanto vuelva."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sold out ngayon ang %@. Patuloy kong babantayan at sasabihan kita agad pag bumalik na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %@ est en rupture de stock. Je continue de surveiller et je te préviens dès son retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी स्टॉक में नहीं है। मैं नज़र रखूँगा और वापस आते ही बता दूँगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang habis. Aku akan terus memantau dan langsung mengabarimu begitu tersedia lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は現在売り切れです。引き続き見張って、戻りしだいすぐお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 지금 품절이에요. 계속 지켜보다가 재입고되면 바로 알려드릴게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ หมดในตอนนี้ จะคอยดูต่อและบอกคุณทันทีที่กลับมา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiện đã hết hàng. Mình sẽ tiếp tục canh và báo bạn ngay khi có lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前已售罄。我会继续盯着,一到货马上告诉你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前已售完。我會持續盯著，一有貨就馬上通知你。"
          }
        }
      }
    },
    "The Market Is Cooling on the %@": {
      "localizations": {
