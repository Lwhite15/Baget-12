    "%@ Is Trading %lld%% Above Asking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Is Trading %2$lld%% Above Asking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se cotiza %2$lld%% por encima del precio original"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld%% na Mas Mataas sa Asking"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se revend %2$lld%% au-dessus du prix demandé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ मांगी कीमत से %2$lld%% ऊपर बिक रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Diperdagangkan %2$lld%% di Atas Harga Tawar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が希望価格より%2$lld%%高く取引中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 판매가보다 %2$lld%% 높게 거래 중"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ซื้อขายสูงกว่าราคาตั้ง %2$lld%%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang được bán cao hơn giá niêm yết %2$lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 转售价高出原价 %2$lld%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 市價比開價高出 %2$lld%%"
          }
        }
      }
    },
    "%@ Sold Out Fast. Here's the Restock Play": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se agotó rápido. Este es el plan de reposición"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubos Agad ang %@. Ito ang Restock Plan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : rupture express. Voici le plan réassort"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ जल्दी बिक गया। ये रहा रीस्टॉक प्लान"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cepat Habis. Ini Strategi Restock-nya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は即完売。再入荷の狙い方はこちら"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 빠르게 품절됐어요. 재입고 공략법이에요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ หมดเร็ว มาดูแผนรอของเข้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cháy hàng nhanh. Đây là cách canh hàng về"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 很快售罄,补货攻略来了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 迅速完售,補貨攻略來了"
          }
        }
      }
    },
    "%@ accepted your friend request. You can now swap suggestions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceptó tu solicitud de amistad. Ya pueden intercambiar sugerencias."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggap ni %@ ang friend request mo. Pwede na kayong magpalitan ng suggestions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a accepté ta demande d'ami. Vous pouvez maintenant échanger des suggestions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने आपकी फ़्रेंड रिक्वेस्ट मान ली। अब आप सुझाव शेयर कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menerima permintaan pertemananmu. Sekarang kalian bisa bertukar saran."
          }
        },
        "ja": {
          "stringUnit": {
