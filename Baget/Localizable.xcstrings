    "Sign in to start hunting for real": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para empezar a buscar de verdad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi pour vraiment lancer la chasse"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하고 본격적으로 찾아보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后开始真正搜寻"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインして本格的に探し始めましょう"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入以開始真正的搜尋"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk untuk mulai berburu sungguhan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để bắt đầu săn thật"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบเพื่อเริ่มล่าจริง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in para magsimulang manghanap nang totoo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असली खोज शुरू करने के लिए साइन इन करें"
          }
        }
      }
    },
    "Sign in to talk to your scouts. They need the internet to search.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para hablar con tus exploradores. Necesitan internet para buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi pour parler à tes éclaireurs. Ils ont besoin d'internet pour chercher."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하고 스카우트와 대화해 보세요. 검색하려면 인터넷이 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后即可与你的侦察员对话。它们需要联网才能搜索。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトと話すにはサインインしてください。検索にはインターネット接続が必要です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後即可與你的偵察員對話。它們需要網路才能搜尋。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk untuk mengobrol dengan scout-mu. Mereka butuh internet untuk mencari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để trò chuyện với các scout. Chúng cần internet để tìm kiếm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบเพื่อคุยกับสเกาต์ของคุณ สเกาต์ต้องใช้อินเทอร์เน็ตในการค้นหา"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in para makausap ang mga scout mo. Kailangan nila ng internet para maghanap."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने स्काउट से बात करने के लिए साइन इन करें। खोजने के लिए उन्हें इंटरनेट चाहिए।"
          }
        }
      }
    },
