    "%@ Is Available Now via %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Is Available Now via %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya está disponible en %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est disponible maintenant via %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 지금 %2$@에서 구매할 수 있어요"
          }
        }
      }
    },
    "%@ Is Trading %lld%% Above Asking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Is Trading %2$lld%% Above Asking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se cotiza %2$lld%% por encima del precio original"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se revend %2$lld%% au-dessus du prix demandé"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 판매가보다 %2$lld%% 높게 거래 중"
          }
        }
      }
    },
    "%@ Sold Out Fast. Here's the Restock Play": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se agotó rápido. Este es el plan de reposición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : rupture express. Voici le plan réassort"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 빠르게 품절됐어요. 재입고 공략법이에요"
          }
        }
      }
    },
    "%@ accepted your friend request. You can now swap suggestions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceptó tu solicitud de amistad. Ya pueden intercambiar sugerencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a accepté ta demande d'ami. Vous pouvez maintenant échanger des suggestions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 친구 요청을 수락했어요. 이제 추천을 주고받을 수 있어요."
          }
        }
      }
    },
    "%@ also lists it for %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ also lists it for %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ también lo ofrece por %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ le propose aussi à %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서도 %2$@에 판매 중이에요"
          }
        }
      }
    },
    "%@ at %@, %lld%% less": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at %2$@, %3$lld%% less"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$@, %3$lld%% menos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chez %2$@, %3$lld%% moins cher"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@, %3$lld%% 저렴해요"
          }
        }
      }
    },
    "%@ checks the price twice a day and texts you if it drops%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ checks the price twice a day and texts you if it drops%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ revisa el precio dos veces al día y te envía un mensaje si baja%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vérifie le prix deux fois par jour et t'envoie un SMS s'il baisse%2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스카우트가 하루 두 번 가격을 확인하고, 내려가면 문자로 알려드려요%2$@."
          }
        }
      }
    },
    "%@ deployed and sweeping": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en acción y rastreando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est lancé et ratisse le web"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 출동해서 탐색 중이에요"
          }
        }
      }
    },
    "%@ deployed. Searching the web now…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en marcha. Buscando en la web…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est lancé. Recherche sur le web en cours…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 출동! 지금 웹을 검색하고 있어요…"
          }
        }
      }
    },
    "%@ is available at %@ for %@.%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is available at %2$@ for %3$@.%4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está disponible en %2$@ por %3$@.%4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est disponible chez %2$@ pour %3$@.%4$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 상품을 %2$@에서 %3$@에 구매할 수 있어요.%4$@"
          }
        }
      }
    },
    "%@ is back on the hunt": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a la caza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est de retour en chasse"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 다시 사냥에 나섰어요"
          }
        }
      }
    },
    "%@ is being picky so you only see good matches. A brand, model or budget gives it much more to go on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está filtrando con cuidado para que solo veas buenas coincidencias. Una marca, modelo o presupuesto le da mucho más en qué basarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est sélectif pour que tu ne voies que de bons résultats. Une marque, un modèle ou un budget l'aide bien plus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 까다롭게 고르는 중이에요. 좋은 매치만 보여드리려고요. 브랜드, 모델, 예산을 알려주면 훨씬 더 잘 찾아요."
          }
        }
      }
    },
    "%@ is off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivé"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 꺼짐"
          }
        }
      }
    },
    "%@ is off. No searching, no texts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivado. Sin búsquedas ni mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivé. Ni recherche, ni SMS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 꺼짐. 검색도 문자도 없어요."
          }
        }
      }
    },
    "%@ is on it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en eso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'en occupe"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 바로 찾는 중이에요"
          }
        }
      }
    },
    "%@ is out hunting. Finds land here as it spots them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ anda de caza. Los hallazgos llegan aquí en cuanto los encuentra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en chasse. Les trouvailles arrivent ici au fur et à mesure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사냥 중이에요. 발견한 상품은 바로 여기에 도착해요."
          }
        }
      }
    },
    "%@ is sold out. Restock watch is on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está agotado. Vigilancia de reposición activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est épuisé. Suivi du réassort activé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 품절이에요. 재입고 알림이 켜져 있어요."
          }
        }
      }
    },
    "%@ learned from your photo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aprendió de tu foto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a appris grâce à ta photo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사진으로 학습했어요"
          }
        }
      }
    },
    "%@ only flags %@ in stock in your size, and it doesn't know yours yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ only flags %2$@ in stock in your size, and it doesn't know yours yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ solo avisa de %2$@ en existencia en tu talla, y aún no conoce la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne signale que les %2$@ en stock dans ta taille, et ne connaît pas encore la tienne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스카우트는 내 사이즈 재고가 있는 %2$@만 알려주는데, 아직 사이즈를 몰라요."
          }
        }
      }
    },
    "%@ releases %@ at %@, %@. Matches your %@ preference.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ releases %2$@ at %3$@, %4$@. Matches your %5$@ preference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lanza %2$@ en %3$@, %4$@. Coincide con tu preferencia de %5$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sort %2$@ chez %3$@, %4$@. Correspond à ta préférence %5$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 출시: %3$@, %4$@. %5$@ 취향에 맞아요."
          }
        }
      }
    },
    "%@ suggested it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lo sugirió"
          }
        },
        "fr": {
