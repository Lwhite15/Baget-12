    "You've passed on things at this price before. Flagging it anyway because it fits you so well.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes has descartado cosas a este precio. Te lo marco igual porque va muy bien contigo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinalampas mo na dati ang mga ganitong presyo. Ipinapakita pa rin namin dahil bagay na bagay ito sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà passé votre tour à ce prix. Je le signale quand même, il vous correspond tellement bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने पहले इस कीमत की चीज़ें छोड़ी हैं। फिर भी दिखा रहे हैं क्योंकि यह आप पर बहुत जँचती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu pernah melewatkan barang di harga segini. Tetap kami tandai karena sangat cocok denganmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前この価格帯は見送っていますが、あなたにぴったりなのでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 이 가격대는 넘기셨어요. 그래도 너무 잘 맞아서 알려 드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเคยข้ามของราคานี้มาก่อน แต่ขอแจ้งไว้เพราะเหมาะกับคุณมาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn từng bỏ qua những món ở mức giá này. Vẫn báo vì nó quá hợp với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前放过这个价位的商品。但它太适合你了,还是提醒你一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你以前會略過這個價位的商品，但它真的很適合你，所以還是提醒你。"
          }
        }
      }
    },
