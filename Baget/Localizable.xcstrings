    "Optional. Use a photo, an emoji, or its initials. You can change it later by tapping the icon on its card.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Usa una foto, un emoji o sus iniciales. Puedes cambiarlo después tocando el ícono en su tarjeta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Gumamit ng photo, emoji, o initials. Puwede mo itong palitan mamaya sa pag-tap ng icon sa card nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Utilise une photo, un emoji ou ses initiales. Tu pourras le changer plus tard en touchant l'icône sur sa carte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। फ़ोटो, इमोजी या नाम के पहले अक्षर लगाएँ। बाद में कार्ड पर आइकन दबाकर बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Pakai foto, emoji, atau inisialnya. Bisa diubah nanti dengan mengetuk ikon di kartunya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。写真、絵文字、イニシャルのどれかを使えます。あとでカードのアイコンをタップして変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 사진, 이모지, 이니셜 중에서 고르세요. 카드의 아이콘을 눌러 나중에 바꿀 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ ใช้รูปภาพ อีโมจิ หรืออักษรย่อก็ได้ เปลี่ยนทีหลังได้โดยแตะไอคอนบนการ์ด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn. Dùng ảnh, emoji hoặc chữ cái đầu. Bạn có thể đổi sau bằng cách chạm vào biểu tượng trên thẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选填。可用照片、表情符号或首字母。之后点它卡片上的图标即可更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。可使用照片、表情符號或名稱縮寫。之後點擊卡片上的圖示即可更改。"
          }
        }
      }
    },
