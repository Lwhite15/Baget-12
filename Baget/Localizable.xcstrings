    "%@ Sold Out Fast. Here's the Restock Play": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se agotó rápido. Este es el plan de reposición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : rupture express. Voici le plan réassort"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 빠르게 품절됐어요. 재입고 공략법이에요"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cepat Habis. Ini Strategi Restock-nya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cháy hàng nhanh. Đây là cách canh hàng về"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 迅速完售,補貨攻略來了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 很快售罄,补货攻略来了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は即完売。再入荷の狙い方はこちら"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ หมดเร็ว มาดูแผนรอของเข้า"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ जल्दी बिक गया। ये रहा रीस्टॉक प्लान"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubos Agad ang %@. Ito ang Restock Plan"
          }
        }
      }
    },
    "%@ accepted your friend request. You can now swap suggestions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceptó tu solicitud de amistad. Ya pueden intercambiar sugerencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a accepté ta demande d'ami. Vous pouvez maintenant échanger des suggestions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 친구 요청을 수락했어요. 이제 추천을 주고받을 수 있어요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menerima permintaan pertemananmu. Sekarang kalian bisa bertukar saran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã chấp nhận lời mời kết bạn. Giờ hai bạn có thể trao đổi gợi ý."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 接受了你的好友邀請。現在可以互相交換推薦了。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已接受你的好友请求。现在可以互相推荐了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんがフレンド申請を承認しました。おすすめを交換できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ตอบรับคำขอเป็นเพื่อนของคุณแล้ว ตอนนี้แลกเปลี่ยนคำแนะนำกันได้เลย"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने आपकी फ़्रेंड रिक्वेस्ट मान ली। अब आप सुझाव शेयर कर सकते हैं।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggap ni %@ ang friend request mo. Pwede na kayong magpalitan ng suggestions."
          }
        }
      }
    },
