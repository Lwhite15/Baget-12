            "value": "Kausapin si %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler à %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से बात करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngobrol dengan %@"
          }
        },
        "ja": {
