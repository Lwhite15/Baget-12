    "%@ is being picky so you only see good matches. A brand, model or budget gives it much more to go on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está filtrando con cuidado para que solo veas buenas coincidencias. Una marca, modelo o presupuesto le da mucho más en qué basarse."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pili ang %@ para puro magandang match lang ang makita mo. Mas marami siyang magagamit kung may brand, model o budget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est sélectif pour que tu ne voies que de bons résultats. Une marque, un modèle ou un budget l'aide bien plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ज़रा चुनिंदा है, ताकि आपको सिर्फ़ अच्छे मैच दिखें। ब्रांड, मॉडल या बजट बताने से उसे बहुत मदद मिलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang selektif agar kamu hanya melihat yang cocok. Merek, model, atau budget akan sangat membantunya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は厳選中なので、良いマッチだけが表示されます。ブランド、モデル、予算を指定すると、さらに精度が上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 까다롭게 고르는 중이에요. 좋은 매치만 보여드리려고요. 브랜드, 모델, 예산을 알려주면 훨씬 더 잘 찾아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เลือกมากหน่อย คุณจะได้เห็นแต่ของที่ใช่ ถ้าระบุแบรนด์ รุ่น หรืองบ จะยิ่งหาได้แม่นขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang kén chọn để bạn chỉ thấy những món thật hợp. Thêm thương hiệu, mẫu hoặc ngân sách sẽ giúp nó có nhiều thông tin hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在严格筛选,只让你看到合适的匹配。填写品牌、型号或预算,它会更有方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 很挑剔,只讓你看到合適的商品。提供品牌、型號或預算,它會更有方向。"
          }
        }
      }
    },
    "%@ is into %@. A good way to find something new.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is into %2$@. A good way to find something new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %1$@ le gusta %2$@. Una buena forma de descubrir algo nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ay mahilig sa %2$@. Magandang paraan para makahanap ng bago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aime %2$@. Une bonne façon de découvrir du nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को %2$@ पसंद है। कुछ नया खोजने का अच्छा तरीका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ suka %2$@. Cara bagus buat menemukan hal baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんは%2$@が好きです。新しい発見のきっかけになりますよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님은 %2$@에 푹 빠져 있어요. 새로운 걸 찾기 좋은 방법이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ชอบ%2$@ เป็นวิธีเจอของใหม่ๆ ที่ดีเลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mê %2$@. Một cách hay để tìm món mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@喜欢%2$@。发现新好物的好办法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 喜歡 %2$@，是發現新鮮好物的好方法。"
          }
        }
      }
    },
