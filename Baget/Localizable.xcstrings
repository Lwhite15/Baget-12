          "stringUnit": {
            "state": "translated",
            "value": "Pas dans ta taille, donc absent des Trouvailles"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이즈가 맞지 않아 발견에 없어요"
          }
