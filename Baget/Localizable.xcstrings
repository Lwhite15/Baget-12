        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 %@ 聊聊"
          }
        }
      }
    },
    "Talk to a scout or open Detailed setup to fine-tune it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con un explorador o abre Configuración detallada para afinarlo"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kausapin ang scout o buksan ang Detalyadong setup para i-fine-tune ito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à un éclaireur ou ouvrez la configuration détaillée pour l'affiner"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्काउट से बात करें या डिटेल्ड सेटअप खोलकर उसे बारीकी से सेट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngobrol dengan scout atau buka Pengaturan detail untuk menyetelnya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトに話しかけるか、「詳細設定」を開いて細かく調整できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트와 대화하거나 세부 설정을 열어 세밀하게 조정해 보세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุยกับสเกาต์ หรือเปิด \"การตั้งค่าแบบละเอียด\" เพื่อปรับแต่งเพิ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện với scout hoặc mở Detailed setup để tinh chỉnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与侦察员聊聊,或打开“详细设置”进行微调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和獵手聊聊,或開啟「詳細設定」進行微調"
          }
        }
      }
    },
    "Talk to a scout to tell it brands, sizes or a budget": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con un explorador para indicarle marcas, tallas o un presupuesto"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kausapin ang scout para sabihin ang brands, sizes o budget"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle à un éclaireur pour lui indiquer marques, tailles ou budget"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्काउट से बात करके ब्रांड, साइज़ या बजट बताएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngobrol dengan scout untuk memberi tahu merek, ukuran, atau budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトに話しかけて、ブランドやサイズ、予算を伝えましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트에게 브랜드, 사이즈, 예산을 알려 주세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุยกับสเกาต์เพื่อบอกแบรนด์ ไซส์ หรืองบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện với scout để cho nó biết thương hiệu, cỡ hoặc ngân sách"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和侦察员聊聊,告诉它品牌、尺码或预算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和偵察員聊聊,告訴它品牌、尺寸或預算"
          }
        }
      }
    },
    "Tap Hunt now in Finds when you can't wait": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Buscar ahora en Hallazgos cuando no puedas esperar"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang Hunt now sa Mga Nahanap kapag hindi ka na makapaghintay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur Chasser maintenant dans Trouvailles si tu ne peux pas attendre"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब इंतज़ार न हो, खोजें में \"अभी ढूँढें\" दबाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Buru sekarang di Temuan kalau sudah tak sabar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ちきれないときは、「発見」で「今すぐ探す」をタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "못 기다리겠다면 발견에서 지금 찾기를 탭하세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่อยากรอ แตะ ล่าเลย ในหน้าของที่เจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Săn ngay trong Phát hiện khi bạn không thể chờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等不及时,点“发现”里的“立即搜寻”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等不及時,到「發現」點「立即搜尋」"
          }
        }
      }
    },
    "Tap Like on anything that's your taste. Your scout leans into that brand and style and finds more like it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Me gusta en todo lo que va con tu estilo. Tu explorador se enfoca en esa marca y estilo, y encuentra más como eso."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang Like sa lahat ng type mo. Tututukan ng scout mo ang brand at style na iyon at hahanap ng mas marami pang katulad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur J'aime pour tout ce qui te plaît. Ton éclaireur se concentre sur cette marque et ce style, et t'en trouve d'autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो भी आपकी पसंद का हो, उस पर Like दबाएँ। आपका स्काउट उस ब्रांड और स्टाइल को समझकर ऐसी और चीज़ें ढूँढेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Suka pada apa pun yang sesuai seleramu. Scout-mu akan fokus ke merek dan gaya itu, lalu mencari lebih banyak yang serupa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好みのものには「いいね」をタップ。スカウトがそのブランドやスタイルを重視して、似た商品をもっと探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 드는 건 좋아요를 눌러 주세요. 스카우트가 그 브랜드와 스타일을 파악해 비슷한 걸 더 찾아와요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะถูกใจกับทุกอย่างที่ตรงรสนิยมคุณ สเคาต์จะเน้นแบรนด์และสไตล์นั้น แล้วหาของที่คล้ายกันมาให้เพิ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Thích vào món hợp gu bạn. Trinh sát sẽ nghiêng về thương hiệu và phong cách đó và tìm thêm món tương tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对你喜欢的点“赞”。你的猎手会偏向该品牌和风格,找到更多类似的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到喜歡的就點「喜歡」。你的偵察員會偏重該品牌與風格，找出更多類似的。"
          }
        }
      }
    },
    "Tap one to hunt it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno para buscarlo"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang isa para i-hunt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-en un pour le chasser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तलाश शुरू करने के लिए एक पर टैप करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk memburunya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてハント"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 찾아보세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเริ่มล่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một món để săn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按即可搜寻"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下開始搜尋"
          }
        }
      }
    },
    "Tap the brands you love and the vibe you're after. New to a brand? Your scouts will tell you about every one they find.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las marcas que amas y el estilo que buscas. ¿Una marca nueva? Tus exploradores te avisarán de cada una que encuentren."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang mga brand na gusto mo at ang vibe na hanap mo. Bago sa iyo ang brand? Sasabihin ng mga scout mo ang bawat mahahanap nila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche les marques que tu adores et l'ambiance que tu recherches. Une marque est nouvelle pour toi ? Tes éclaireurs te présenteront chacune de celles qu'ils trouvent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा ब्रांड और मनचाहा वाइब चुनें। कोई ब्रांड आपके लिए नया है? आपके स्काउट हर नए ब्रांड के बारे में बताएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk merek favoritmu dan vibe yang kamu cari. Merek baru buatmu? Scout-mu akan memberi tahu setiap kali menemukannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなブランドと求める雰囲気をタップしてください。初めてのブランドは、見つけるたびにスカウトが教えてくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 브랜드와 원하는 분위기를 눌러 주세요. 처음 보는 브랜드라면 스카우트가 발견할 때마다 알려줘요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแบรนด์ที่คุณรักและแนวที่อยากได้ ถ้าเป็นแบรนด์ใหม่ สเคาต์จะบอกคุณทุกครั้งที่เจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào thương hiệu bạn yêu và phong cách bạn muốn. Thương hiệu mới? Các trinh sát sẽ báo bạn mọi thương hiệu họ tìm thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点选你喜欢的品牌和想要的风格。遇到新品牌?猎手找到后都会告诉你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選你喜愛的品牌和想要的風格。遇到沒接觸過的品牌，你的偵察員都會告訴你。"
          }
        }
      }
    },
    "Tap to unlike": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para quitar Me gusta"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap para i-unlike"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie pour retirer ton J'aime"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलाइक करने के लिए टैप करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk batal suka"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしていいねを取り消し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 좋아요 취소"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเลิกถูกใจ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để bỏ thích"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按取消赞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下取消喜歡"
          }
        }
      }
    },
    "Tap ♥ on what you love, ✕ on what you don't": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ♥ en lo que te encanta y ✕ en lo que no"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang ♥ sa gusto mo, ✕ sa ayaw mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur ♥ pour ce que tu aimes, sur ✕ pour le reste"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो पसंद हो उस पर ♥ दबाएँ, जो न हो उस पर ✕"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ♥ untuk yang kamu suka, ✕ untuk yang tidak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなものは♥、苦手なものは✕をタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 건 ♥, 별로인 건 ✕를 탭하세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ♥ ที่ชอบ แตะ ✕ ที่ไม่ชอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ♥ cho món bạn thích, ✕ cho món bạn không thích"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢的点 ♥,不喜欢的点 ✕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜歡的點 ♥,不喜歡的點 ✕"
          }
        }
      }
    },
    "Tap ✕ on anything that isn't you. Scouts stop using it on their next search. Like, pass and chat to teach them more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ✕ en lo que no va contigo. Los exploradores dejan de usarlo en su próxima búsqueda. Da Me gusta, descarta y chatea para enseñarles más."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang ✕ sa kahit anong hindi bagay sa iyo. Titigil na ang mga scout sa paggamit nito sa susunod nilang search. Mag-like, mag-pass at mag-chat para mas matuto sila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur ✕ pour tout ce qui n'est pas pour toi. Les éclaireurs arrêtent de l'utiliser dès leur prochaine recherche. Aime, passe et discute pour leur en apprendre plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आपके स्टाइल का नहीं है, उस पर ✕ दबाएँ। स्काउट अगली खोज में उसे इस्तेमाल नहीं करेंगे। Like, पास और चैट से उन्हें और सिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ✕ pada apa pun yang bukan kamu banget. Scout akan berhenti memakainya di pencarian berikutnya. Suka, lewati, dan chat untuk mengajari mereka lebih banyak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合わないものには✕をタップ。スカウトは次の検索からそれを使いません。いいね、パス、チャットでさらに教えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향이 아닌 건 ✕를 눌러 주세요. 스카우트가 다음 검색부터 제외해요. 좋아요, 패스, 채팅으로 더 알려주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ✕ ที่ทุกอย่างที่ไม่ใช่คุณ สเคาต์จะเลิกใช้สิ่งนั้นในการค้นหาครั้งต่อไป กดถูกใจ ข้าม และแชทเพื่อสอนเพิ่มได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ✕ vào món không hợp với bạn. Trinh sát sẽ ngừng dùng nó từ lần tìm tiếp theo. Thích, bỏ qua và trò chuyện để dạy thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对不适合你的点 ✕。猎手下次搜索就不再参考。点赞、跳过和聊天,能让它们更懂你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是你的菜就點 ✕。偵察員下次搜尋就不會再參考。多用喜歡、略過和聊天來教它們。"
          }
        }
      }
    },
