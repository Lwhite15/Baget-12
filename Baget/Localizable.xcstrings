    "\"saw this and thought of you\"": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“看到这个就想到你了”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« j'ai vu ça et j'ai pensé à toi »"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"thấy cái này là nghĩ ngay đến bạn\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"이거 보고 네 생각 났어\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ये देखा तो तुम्हारी याद आ गई\""
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"เห็นแล้วนึกถึงเธอเลย\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"vi esto y pensé en ti\""
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「看到這個就想到你」"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "\"nakita ko 'to, naalala kita\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「これ見て、あなたを思い出した」"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"lihat ini langsung ingat kamu\""
          }
        }
      }
    },
    "%@ %@, %@ you follow": {
