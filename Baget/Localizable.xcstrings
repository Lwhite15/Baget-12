            "state": "translated",
            "value": "Iyan ang sarili mong handle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ton propre pseudo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तो आपका अपना हैंडल है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu handle-mu sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のハンドルです。"
          }
        },
        "ko": {
