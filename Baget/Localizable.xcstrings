    "Nice taste. %lld noted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen gusto. %lld anotados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon goût. %lld enregistrés."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향 좋네요. %lld개 기억했어요."
          }
        }
      }
    },
    "Nice. It's off your list, and %@ will find more like it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genial. Ya no está en tu lista y %@ encontrará más como este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super. C'est retiré de ta liste, et %@ en trouvera d'autres du même genre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요. 목록에서 뺐고, %@가 비슷한 걸 더 찾아볼게요."
          }
        }
      }
    },
    "No Baget Pro subscription found for this Apple ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una suscripción a Baget Pro para este Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement Baget Pro trouvé pour cet identifiant Apple."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple ID로 가입된 Baget Pro 구독이 없어요."
          }
        }
      }
    },
    "No activity yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité pour l'instant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 활동이 없어요."
          }
        }
      }
    },
    "No backend set up yet, so metrics stay on this phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay backend configurado, así que las métricas se quedan en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de backend configuré : les métriques restent sur ce téléphone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 백엔드가 설정되지 않아 지표는 이 휴대폰에만 저장돼요."
          }
        }
      }
    },
    "No intel right now. Droplists, release calendars and news your scouts come across land here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin novedades por ahora. Aquí llegan las listas de lanzamientos, calendarios de estrenos y noticias que encuentren tus exploradores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'infos pour l'instant. Les listes de drops, calendriers de sorties et actus repérés par tes éclaireurs arrivent ici."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 소식이 없어요. 스카우트가 찾은 드롭리스트, 발매 일정, 뉴스가 여기에 모여요."
          }
        }
      }
    },
    "No limit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite"
          }
        },
        "fr": {
