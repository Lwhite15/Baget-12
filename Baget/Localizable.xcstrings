    "Pause a scout, or delete it from its card in Squad": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa un explorador o elimínalo desde su tarjeta en Squad"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-pause ang scout, o i-delete ito mula sa card nito sa Squad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez un éclaireur en pause, ou supprimez-le depuis sa carte dans Squad"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्काउट को पॉज़ करें, या Squad में उसके कार्ड से डिलीट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda atau hapus scout lewat kartunya di Squad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトは一時停止するか、Squadのカードから削除できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad의 스카우트 카드에서 일시 중지하거나 삭제할 수 있어요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดสเกาต์ชั่วคราว หรือลบจากการ์ดใน Squad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng scout, hoặc xóa scout ngay trên thẻ của nó trong Squad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可暂停侦察员,或在“Squad”中通过它的卡片删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停獵手,或從 Squad 裡的卡片刪除"
          }
        }
      }
    },
