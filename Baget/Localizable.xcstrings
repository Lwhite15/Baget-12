            "value": "ช่วงเวลาล่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung giờ săn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜寻时段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋時段"
          }
        }
      }
    },
    "Hunting's better with people who get your taste.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和懂你品味的人一起寻宝更有趣。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chasse est plus chouette avec des gens qui comprennent tes goûts."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Săn đồ vui hơn khi có người hiểu gu của bạn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향을 알아주는 사람들과 함께하면 더 재밌어요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आपका टेस्ट समझें, उनके साथ हंटिंग का मज़ा ही अलग है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล่าจะสนุกกว่า เมื่อมีคนที่เข้าใจเทสต์คุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar es mejor con quienes entienden tu gusto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟懂你品味的人一起尋寶更好玩。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas masaya ang paghahanap kasama ang mga kapareho mo ng taste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハントは、好みをわかってくれる人とのほうが楽しい。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berburu lebih seru bareng orang yang paham seleramu."
          }
        }
      }
    },
