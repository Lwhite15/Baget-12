            "state": "translated",
            "value": "Vous avez déjà ajouté @%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप @%@ को पहले ही जोड़ चुके हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah menambahkan @%@."
          }
        },
        "ja": {
