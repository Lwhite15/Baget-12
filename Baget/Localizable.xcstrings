    "Restock: %@ at %@, %@. Tap to review checkout.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Restock: %1$@ at %2$@, %3$@. Tap to review checkout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reposición: %1$@ en %2$@, %3$@. Toca para revisar el pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réassort : %1$@ chez %2$@, %3$@. Touchez pour vérifier le paiement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재입고: %2$@의 %1$@, %3$@. 탭해서 결제를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补货:%2$@ 的 %1$@,%3$@。点按查看结账。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再入荷:%2$@の%1$@、%3$@。タップしてチェックアウトを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "補貨通知:%2$@ 的 %1$@,%3$@。點一下查看結帳。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok ulang: %1$@ di %2$@, %3$@. Ketuk untuk cek checkout."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng về lại: %1$@ tại %2$@, %3$@. Chạm để xem lại thanh toán."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของเข้าใหม่: %1$@ ที่ %2$@, %3$@ แตะเพื่อตรวจสอบการชำระเงิน"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Restock: %1$@ sa %2$@, %3$@. I-tap para i-review ang checkout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीस्टॉक: %2$@, %3$@ पर %1$@। चेकआउट देखने के लिए टैप करें।"
          }
        }
      }
    },
