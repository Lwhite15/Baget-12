            "value": "스카우트 팀이 웹을 계속 검색해서 새로운 발견 %1$lld개%2$@를 찾았어요.%3$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณค้นหาเว็บต่อและเจอของใหม่ %1$lld ชิ้นให้คุณ%2$@%3$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout đã tiếp tục tìm trên web và có %1$lld món đồ mới%2$@ cho bạn.%3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团继续搜索网络,为你找到 %1$lld 件新商品%2$@。%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
