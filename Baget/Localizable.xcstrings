    "You've gone for %@ before": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya elegiste %@ antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà choisi %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전에 %@ 선택한 적 있어요"
          }
        },
