    "Add a friend and the things they send you show up here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un amigo y lo que te envíe aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un ami et ce qu'il t'envoie apparaîtra ici."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구를 추가하면 친구가 보낸 항목이 여기에 표시돼요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan teman, dan kiriman dari mereka muncul di sini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bạn bè và những gì họ gửi cho bạn sẽ hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增好友後,對方傳給你的內容會顯示在這裡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加好友后,他们发给你的内容会显示在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちを追加すると、その人から届いたものがここに表示されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเพื่อน แล้วสิ่งที่เขาส่งให้คุณจะมาอยู่ที่นี่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त जोड़ें और उनके भेजे सुझाव यहां दिखेंगे।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng friend at dito lalabas ang mga ipinapadala nila sa'yo."
          }
        }
      }
    },
    "Add a friend first, on the Friends tab.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero agrega un amigo en la pestaña Amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute d'abord un ami dans l'onglet Amis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 친구 탭에서 친구를 추가하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan teman dulu di tab Teman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm bạn trước, ở tab Bạn bè."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先到「好友」分頁新增好友。"
          }
        },
        "zh-Hans": {
