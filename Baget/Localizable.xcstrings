        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 친구 탭에서 친구를 추가하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเพื่อนก่อนที่แท็บเพื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm bạn trước, ở tab Bạn bè."
          }
        },
        "zh-Hans": {
