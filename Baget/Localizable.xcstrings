    "Intel from %@: worth knowing, not a product to buy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dato de %@: bueno saberlo, no es un producto para comprar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Info de %@ : bon à savoir, pas un produit à acheter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 정보: 알아두면 좋지만 살 제품은 아니에요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
