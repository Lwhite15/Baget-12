            "state": "translated",
            "value": "ทีมของคุณกำลังล่า"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghahanap ang squad mo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम खोज रही है"
          }
        }
      }
    },
    "Your squad keeps hunting in the background and will text you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón sigue buscando en segundo plano y te enviará un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe continue la chasse en arrière-plan et vous enverra un SMS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 백그라운드에서 계속 찾고, 문자로 알려 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团会在后台继续搜寻,并给你发短信。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームはバックグラウンドで探し続け、メッセージでお知らせします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊會在背景繼續搜尋，並傳簡訊通知你。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout tiếp tục săn ngầm và sẽ nhắn tin cho bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu terus berburu di latar belakang dan akan mengirimimu SMS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณล่าต่อเบื้องหลังและจะส่งข้อความหาคุณ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patuloy na naghahanap ang squad mo sa background at ite-text ka nila."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम बैकग्राउंड में खोजती रहती है और आपको टेक्स्ट करेगी।"
          }
        }
      }
    },
    "Your squad kept searching the web and found %lld new %@ for you.%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad kept searching the web and found %1$lld new %2$@ for you.%3$@"
          }
        },
