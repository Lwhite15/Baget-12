    "@%@ is taken. Try another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ya está en uso. Prueba otro."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamit na ang @%@. Subukan ang iba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ est déjà pris. Essaie un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ पहले से लिया जा चुका है। कोई और आज़माएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sudah dipakai. Coba yang lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@は使用済みです。別のものをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용 중인 핸들이에요: @%@. 다른 핸들을 써보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ มีคนใช้แล้ว ลองชื่ออื่นนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ đã có người dùng. Thử tên khác nhé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 已被占用,换一个试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 已被使用,請換一個。"
          }
        }
      }
    },
