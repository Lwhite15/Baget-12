          }
        }
      }
    },
    "Finds usually land within a few minutes. Pull down to check.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hallazgos suelen llegar en unos minutos. Desliza hacia abajo para revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trouvailles arrivent en général en quelques minutes. Tirez pour actualiser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견은 보통 몇 분 안에 도착해요. 아래로 당겨 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现通常几分钟内就会出现。下拉即可查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発見は通常、数分以内に届きます。下に引いて確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hiện thường về trong vài phút. Kéo xuống để kiểm tra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temuan biasanya masuk dalam beberapa menit. Tarik ke bawah untuk cek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發現通常幾分鐘內就會出現。下拉即可查看。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของที่เจอมักมาถึงภายในไม่กี่นาที ดึงลงเพื่อเช็ก"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadalasan ilang minuto lang dumarating ang finds. Mag-pull down para i-check."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोजें आमतौर पर कुछ मिनटों में आ जाती हैं। चेक करने के लिए नीचे खींचें।"
          }
        }
      }
    },
    "First finds are in": {
      "localizations": {
