    "Turn on sharing your taste (Friends, then What friends can see) to see your match, %@'s grails, gift ideas and swap Taste Cards.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa compartir tu gusto (Amigos, luego Lo que ven tus amigos) para ver tu afinidad, los grails de %@, ideas de regalo e intercambiar Tarjetas de gusto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang pagshe-share ng taste mo (Friends, tapos What friends can see) para makita ang match mo, mga grail ni %@, at gift ideas, at makapagpalitan ng Taste Cards."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le partage de vos goûts (Amis, puis Ce que les amis peuvent voir) pour voir votre match, les grails de %@, des idées de cadeaux et échanger vos Taste Cards."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना मैच, %@ के ग्रेल और गिफ्ट आइडिया देखने और टेस्ट कार्ड की अदला-बदली के लिए अपनी पसंद शेयर करना चालू करें (दोस्त, फिर दोस्त क्या देख सकते हैं)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan berbagi selera (Teman, lalu Yang bisa dilihat teman) untuk melihat kecocokan, grail %@, ide hadiah, dan tukar Taste Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テイストの共有をオンにすると(友だち → 友だちに見せる内容)、マッチ度、%@さんの憧れの一品、ギフトのアイデアが表示され、テイストカードも交換できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향 공유를 켜면(친구 → 친구에게 보이는 정보) 매치, %@ 님의 그레일, 선물 아이디어를 보고 취향 카드도 교환할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแชร์รสนิยมของคุณ (เพื่อน แล้วเลือก สิ่งที่เพื่อนเห็นได้) เพื่อดูความเข้ากัน ของในฝันของ %@ ไอเดียของขวัญ และแลกการ์ดรสนิยม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật chia sẻ gu của bạn (Bạn bè, rồi Bạn bè có thể thấy gì) để xem độ hợp, grail của %@, ý tưởng quà tặng và đổi Taste Card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启分享你的品味(好友,然后选“好友可见内容”),即可查看你们的契合度、%@的心头好、送礼灵感,并交换品味卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟分享你的品味（好友 › 好友可見內容），即可看到契合度、%@ 的夢幻單品、送禮靈感，並交換品味卡。"
          }
        }
      }
    },
