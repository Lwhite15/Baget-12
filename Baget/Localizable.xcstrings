    "Right to like, left to pass, up to buy. Every swipe teaches your squad.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha para dar me gusta, a la izquierda para descartar, arriba para comprar. Cada gesto enseña a tu equipo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Right para i-like, left para i-pass, up para bumili. Bawat swipe, may natututunan ang squad mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Droite pour aimer, gauche pour passer, haut pour acheter. Chaque swipe forme votre équipe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंद के लिए दाएँ, छोड़ने के लिए बाएँ, खरीदने के लिए ऊपर। हर स्वाइप आपकी टीम को सिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser kanan untuk suka, kiri untuk lewati, atas untuk beli. Setiap geseran melatih timmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右でいいね、左でパス、上で購入。スワイプするたびにチームが学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 좋아요, 왼쪽은 패스, 위로 밀면 구매예요. 스와이프할 때마다 스쿼드가 배워요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขวาถูกใจ ปัดซ้ายข้าม ปัดขึ้นซื้อ ทุกการปัดช่วยสอนทีมของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt phải để thích, trái để bỏ qua, lên để mua. Mỗi lần vuốt đều giúp đội của bạn hiểu bạn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑喜欢,左滑跳过,上滑购买。每次滑动都在教你的侦察队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑喜歡,左滑略過,上滑購買。每次滑動都會讓你的偵察隊更懂你。"
          }
        }
      }
    },
