    },
    "Nothing new from friends right now.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo de tus amigos por ahora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang bago mula sa friends ngayon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau de la part de tes amis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी दोस्तों से कुछ नया नहीं।"
          }
        },
        "id": {
