        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 선택"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเวลา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇時間"
          }
        }
      }
    },
    "Pick up to %lld. You'll get a personal scout for each, hunting drops, restocks and deals.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige hasta %lld. Tendrás un explorador personal para cada una, buscando lanzamientos, reposiciones y ofertas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng hanggang %lld. May sarili kang scout para sa bawat isa, naghahanap ng drops, restocks at deals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en jusqu'à %lld. Tu auras un éclaireur perso pour chacun, à l'affût des sorties, des retours en stock et des bons plans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा से ज़्यादा %lld चुनें। हर एक के लिए आपको एक पर्सनल स्काउट मिलेगा, जो ड्रॉप, रीस्टॉक और डील ढूँढेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih hingga %lld. Kamu akan dapat scout pribadi untuk masing-masing, yang memburu drop, restock, dan promo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大%lld個選べます。それぞれにパーソナルスカウトがつき、ドロップ、再入荷、お得情報を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld개까지 고르세요. 각각에 맞는 개인 스카우트가 발매, 재입고, 특가를 찾아드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกได้สูงสุด %lld อย่าง คุณจะได้สเคาท์ส่วนตัวสำหรับแต่ละอย่าง คอยล่าดรอป ของเข้าใหม่ และดีลเด็ด ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tối đa %lld. Mỗi mục bạn sẽ có một scout riêng, săn hàng mới, hàng về lại và ưu đãi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多选 %lld 个。每个都会有专属侦察员,帮你盯新品、补货和优惠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可選 %lld 個。每個都會有專屬偵察員,幫你追蹤新品發售、補貨與優惠。"
          }
        }
      }
    },
    "Pick your %@ first. Your scout only hunts what's in stock in it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elige tu %@. Tu explorador solo busca lo que hay en stock en esa opción."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin muna ang %@ mo. Ang scout mo ay maghahanap lang ng may stock nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis d'abord ta %@. Ton éclaireur ne cherche que ce qui est en stock dans cette taille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले अपना %@ चुनें। आपका स्काउट सिर्फ़ वही ढूँढेगा जो उसमें स्टॉक में हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih %@ dulu. Scout-mu hanya memburu yang stoknya tersedia di situ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に%@を選んでください。スカウトは、その在庫がある商品だけを探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 %@을(를) 골라 주세요. 스카우트가 해당 사이즈 재고가 있는 상품만 찾아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก %@ ของคุณก่อน สเคาท์จะล่าเฉพาะของที่มีไซส์นั้นในสต็อก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn %@ trước. Scout của bạn chỉ săn món còn hàng ở size đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择你的%@。你的侦察员只会搜索该尺码有货的商品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇你的%@。你的偵察員只會搜尋有該尺寸現貨的商品。"
          }
        }
      }
    },
    "Pick your %@. This scout only hunts things in stock in your size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu %@. Este explorador solo busca lo que hay en stock en tu talla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang %@ mo. Ang scout na ito ay maghahanap lang ng may stock sa size mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ta %@. Cet éclaireur ne cherche que ce qui est en stock dans ta taille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना %@ चुनें। यह स्काउट सिर्फ़ वही ढूँढेगा जो आपके साइज़ में स्टॉक में हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih %@ kamu. Scout ini hanya memburu barang yang stoknya ada di ukuranmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を選んでください。このスカウトは、あなたのサイズの在庫がある商品だけを探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 골라 주세요. 이 스카우트는 내 사이즈 재고가 있는 상품만 찾아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก %@ ของคุณ สเคาท์นี้จะล่าเฉพาะของที่มีไซส์คุณในสต็อก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn %@ của bạn. Scout này chỉ săn món còn hàng đúng size của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择你的%@。这个侦察员只会搜索你的尺码有货的商品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇你的%@。這位偵察員只會搜尋有你尺寸現貨的商品。"
          }
        }
      }
    },
    "Picked for %@'s taste by your scouts, under $150.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegidos por tus exploradores para el gusto de %@, por menos de $150."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili ng mga scout mo para sa taste ni %@, wala pang $150."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi pour les goûts de %@ par vos éclaireurs, moins de 150 $."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्काउट्स ने %@ की पसंद के हिसाब से चुना, $150 से कम में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipilih scout-mu sesuai selera %@, di bawah $150."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのスカウトが%@さんのテイストに合わせて選んだ、150ドル以下のアイテムです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 %@ 님의 취향에 맞춰 고른 150달러 이하 상품이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์ของคุณเลือกให้ตามรสนิยมของ %@ ราคาไม่เกิน $150"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các scout của bạn chọn theo gu của %@, dưới $150."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侦察员按%@的品味挑选,价格低于 $150。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的探員依 %@ 的品味挑選，$150 以下。"
          }
        }
      }
    },
    "Picked from everything Baget's scouts have found, ranked by your taste. Every ♥ and ✕ sharpens it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado entre todo lo que han encontrado los exploradores de Baget, ordenado según tu gusto. Cada ♥ y ✕ lo afina."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili mula sa lahat ng nahanap ng mga scout ng Baget, ayon sa taste mo. Bawat ♥ at ✕ ay nagpapatalas nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection parmi toutes les trouvailles des éclaireurs de Baget, classée selon tes goûts. Chaque ♥ et ✕ l'affine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget के स्काउट्स की सारी खोजों में से चुना गया, आपकी पसंद के हिसाब से क्रम में। हर ♥ और ✕ इसे और सटीक बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipilih dari semua yang ditemukan scout Baget, diurutkan sesuai seleramu. Setiap ♥ dan ✕ membuatnya makin tepat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetのスカウトが見つけたすべての中から、好みに合わせて選びました。♥と✕で精度が上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 스카우트가 찾은 모든 상품 중에서 취향 순으로 골랐어요. ♥와 ✕를 누를수록 더 정확해져요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดมาจากทุกอย่างที่สเคาท์ของ Baget เจอ จัดอันดับตามรสนิยมของคุณ ทุก ♥ และ ✕ ช่วยให้แม่นขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ mọi thứ các scout của Baget đã tìm thấy, xếp theo gu của bạn. Mỗi ♥ và ✕ giúp gợi ý chuẩn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Baget 侦察员的所有发现中精选,按你的口味排序。每个 ♥ 和 ✕ 都会让它更准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Baget 偵察員找到的所有商品中,依你的喜好排序。每個 ♥ 和 ✕ 都會讓推薦更精準。"
          }
        }
      }
    },
    "Picked from today's listings that match what %@ hunts%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Picked from today's listings that match what %1$@ hunts%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado de los anuncios de hoy que coinciden con lo que %1$@ busca%2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili mula sa mga listing ngayon na tugma sa hinahanap ni %1$@%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionné parmi les offres du jour qui correspondent à ce que %1$@ recherche%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की लिस्टिंग में से चुना गया, जो %1$@ की तलाश%2$@ से मेल खाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipilih dari listing hari ini yang cocok dengan yang diburu %1$@%2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が探している条件%2$@に合う、本日の出品から選びました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 올라온 상품 중 %1$@이(가) 찾는 %2$@에 맞는 것만 골랐어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดจากรายการวันนี้ที่ตรงกับสิ่งที่ %1$@ ล่าอยู่%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ các mẫu đăng hôm nay khớp với thứ %1$@ săn%2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从今日在售商品中精选,符合 %1$@ 所找的%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從今日商品中挑選符合 %1$@ 所搜尋的%2$@。"
          }
        }
      }
    },
