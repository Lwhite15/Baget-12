        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa gayamu?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんなスタイルですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일이 어떤가요?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สไตล์คุณเป็นแบบไหน?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phong cách của bạn là gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的风格是什么?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的風格是什麼？"
          }
        }
      }
    },
    "Whatever you're into, they find it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te guste, ellos lo encuentran"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano man ang trip mo, hahanapin nila"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu importe ce que tu aimes, ils le trouvent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको जो भी पसंद हो, वे ढूँढ लाते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa pun minatmu, mereka menemukannya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が好きでも、スカウトが見つけます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 좋아하면 스카우트가 찾아요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชอบอะไร สเกาต์ก็หาให้เจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thích gì, các scout đều tìm ra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不管你喜欢什么,它们都能找到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不管你愛什麼，他們都找得到"
          }
        }
      }
    },
    "When a friend joins, Baget compares your taste and unlocks:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友加入后，Baget 会比较你们的品味，并解锁："
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un ami te rejoint, Baget compare vos goûts et débloque :"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có bạn tham gia, Baget sẽ so gu của hai bạn và mở khóa:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 가입하면 Baget이 취향을 비교하고 아래 기능을 열어드려요:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई दोस्त जुड़ेगा, Baget आपका टेस्ट मिलाएगा और ये अनलॉक करेगा:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเพื่อนเข้าร่วม Baget จะเทียบเทสต์ของคุณและปลดล็อก:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un amigo se une, Baget compara sus gustos y desbloquea:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友加入後，Baget 會比對你們的品味並解鎖："
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag sumali ang isang kaibigan, ikukumpara ng Baget ang taste n'yo at mabubuksan ang:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちが参加すると、Bagetがテイストを比較して次が使えるようになります:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat teman bergabung, Baget membandingkan seleramu dan membuka:"
          }
        }
      }
    },
