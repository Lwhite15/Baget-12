    "Watch it and get a text when the price drops or it restocks": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Síguelo y recibe un mensaje cuando baje de precio o vuelva a haber stock"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantayan ito at makatanggap ng text kapag bumaba ang presyo o nag-restock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis-le et reçois un SMS dès que le prix baisse ou qu'il est de nouveau en stock"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे वॉच करें और कीमत घटने या दोबारा स्टॉक में आने पर मैसेज पाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau dan dapatkan pesan saat harga turun atau stok kembali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチすると、値下げや再入荷をメッセージでお知らせします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지켜보다가 가격이 내리거나 재입고되면 문자로 알려 줘요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอยดูให้ แล้วส่งข้อความเมื่อราคาลดหรือของกลับมามี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi món này và nhận tin nhắn khi giá giảm hoặc có hàng trở lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注它,降价或补货时给你发消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持續關注,降價或補貨時傳訊息通知你"
          }
        }
      }
    },
