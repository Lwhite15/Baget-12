        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ คือฟีดประจำวันของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay là bảng tin hằng ngày của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“今日”是你的每日推荐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」是你的每日動態"
          }
        }
      }
    },
