    "Easygoing, gives you the gist": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relajado, te da lo esencial"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Chill lang, ibibigay ang buod"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décontracté, va à l'essentiel"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिंदास, सार बता देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Santai, kasih intinya saja"
