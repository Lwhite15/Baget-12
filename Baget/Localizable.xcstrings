    "Texts for strong matches (85%+) only, at most 6 a day, plus price drops, restocks, Today's Drop and friends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes solo para coincidencias fuertes (85%+), máximo 6 al día, además de bajas de precio, reposiciones, Today's Drop y amigos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Texts para lang sa malalakas na match (85%+), hanggang 6 kada araw, kasama ang price drops, restocks, Today's Drop at friends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS uniquement pour les correspondances fortes (85 %+), 6 par jour maximum, plus les baisses de prix, les retours en stock, Today's Drop et tes amis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट सिर्फ़ दमदार मैच (85%+) के लिए, दिन में ज़्यादा से ज़्यादा 6, साथ में प्राइस ड्रॉप, रीस्टॉक, Today's Drop और दोस्तों के।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS hanya untuk kecocokan kuat (85%+), maksimal 6 per hari, plus penurunan harga, stok ulang, Today's Drop, dan kiriman teman."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いマッチ(85%以上)のみ、1日最大6通。値下げ、再入荷、Today's Drop、友だちからの知らせも届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치도 높은 상품(85%+)만 하루 최대 6번, 그리고 가격 인하, 재입고, Today's Drop, 친구 소식도 보내요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งข้อความเฉพาะรายการที่ตรงมาก (85%+) วันละไม่เกิน 6 ข้อความ รวมถึงราคาลด ของกลับมามีสต็อก Today's Drop และเพื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhắn khi khớp cao (85%+), tối đa 6 tin mỗi ngày, cộng thêm giảm giá, hàng về lại, Today's Drop và bạn bè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在高匹配(85%+)时发短信,每天最多 6 条,另含降价、补货、Today's Drop 和好友消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限高度符合（85%以上）才傳簡訊，每天最多 6 則，另有降價、補貨、Today's Drop 等通知。"
          }
        }
      }
    },
