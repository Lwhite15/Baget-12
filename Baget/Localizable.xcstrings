            "value": "正式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正式"
          }
        }
      }
    },
    "EU or UK sizing? Put it in your own words on the first screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tallas de la UE o del Reino Unido? Escríbelo con tus palabras en la primera pantalla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "EU o UK sizing? Sabihin sa sarili mong salita sa unang screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailles EU ou UK ? Dites-le avec vos mots sur le premier écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "EU या UK साइज़? पहली स्क्रीन पर अपने शब्दों में लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran EU atau UK? Tulis dengan kata-katamu sendiri di layar pertama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EUやUKのサイズですか？最初の画面でご自身の言葉で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EU나 UK 사이즈인가요? 첫 화면에서 직접 말해 주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไซส์ EU หรือ UK? บอกด้วยคำของคุณเองในหน้าแรกได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng size EU hoặc UK? Hãy nói bằng lời của bạn ở màn hình đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欧码或英码?请在第一屏用你自己的话说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歐規或英規尺寸?請在第一個畫面用你自己的話說明。"
          }
        }
      }
    },
    "Each find shows the price, the store and why your scout picked it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hallazgo muestra el precio, la tienda y por qué tu explorador lo eligió."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makikita sa bawat nahanap ang presyo, ang store at kung bakit ito pinili ng scout mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trouvaille indique le prix, la boutique et pourquoi ton éclaireur l'a choisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर खोज में कीमत, स्टोर और आपके स्काउट के चुनने की वजह दिखती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap temuan menampilkan harga, toko, dan alasan scout-mu memilihnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各発見には、価格、ストア、スカウトが選んだ理由が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 발견에는 가격, 스토어, 스카우트가 고른 이유가 표시돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของที่เจอทุกชิ้นบอกราคา ร้านค้า และเหตุผลที่สเกาต์เลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi phát hiện cho bạn biết giá, cửa hàng và lý do scout chọn nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每件好物都会显示价格、商店,以及你的侦察员为何选中它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個發現都會顯示價格、商店,以及你的偵察員為何挑中它。"
          }
        }
      }
    },
    "Each scout hunts one thing for you, and every one is yours to shape. Change what it hunts, its brands, styles, size and budget, or how often it texts you, any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada explorador busca una cosa para ti, y tú decides cómo ajustarlo. Cambia lo que busca, sus marcas, estilos, talla y presupuesto, o cada cuánto te escribe, cuando quieras."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang bagay ang hinahanap ng bawat scout para sa iyo, at ikaw ang bahala sa bawat isa. Puwede mong baguhin anumang oras ang hinahanap nito, mga brand, style, size at budget, o kung gaano kadalas ito magte-text sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque éclaireur traque une chose pour vous, et chacun se règle à votre goût. Modifiez à tout moment ce qu'il cherche, ses marques, styles, taille et budget, ou la fréquence de ses messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्काउट आपके लिए एक चीज़ ढूंढता है, और उसे आप अपने हिसाब से बदल सकते हैं। वह क्या ढूंढे, उसके ब्रांड, स्टाइल, साइज़ और बजट, या वह कितनी बार आपको मैसेज करे, यह सब कभी भी बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap scout memburu satu hal untukmu, dan semuanya bisa kamu atur sendiri. Ubah buruannya, merek, gaya, ukuran, dan budget, atau seberapa sering ia mengirim pesan, kapan saja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトはそれぞれ1つのものを探し、すべてあなた好みに調整できます。探すもの、ブランド、スタイル、サイズ、予算、メッセージの頻度は、いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트는 하나당 한 가지씩 찾아 주고, 모두 원하는 대로 바꿀 수 있어요. 찾는 상품, 브랜드, 스타일, 사이즈, 예산, 문자 받는 빈도를 언제든 바꿀 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์แต่ละตัวจะตามหาของให้คุณอย่างหนึ่ง และปรับแต่งได้ตามใจคุณ เปลี่ยนสิ่งที่ตามหา แบรนด์ สไตล์ ไซส์ และงบ หรือความถี่ที่ส่งข้อความหาคุณได้ทุกเมื่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi scout săn một món cho bạn, và bạn toàn quyền tùy chỉnh. Bạn có thể đổi món cần săn, thương hiệu, phong cách, size và ngân sách, hoặc tần suất scout nhắn tin cho bạn, bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个侦察员专为你搜寻一件东西,而且都可以由你随心调整。你可以随时更改它搜寻的内容、品牌、风格、尺码和预算,或是它给你发消息的频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位獵手只為你尋找一樣東西,而且完全由你決定。你可以隨時更改它要找的目標、品牌、款式、尺寸和預算,或是傳訊息給你的頻率。"
          }
        }
      }
    },
    "Each scout hunts one thing for you, on its own schedule.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada explorador busca una cosa para ti, a su propio ritmo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat scout ay naghahanap ng isang bagay para sa iyo, ayon sa sarili nitong schedule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque éclaireur chasse un article pour toi, à son rythme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्काउट आपके लिए एक ही चीज़ ढूँढता है, अपने शेड्यूल से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap scout memburu satu hal untukmu, dengan jadwalnya sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトはそれぞれ1つのものを、自分のペースで探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트는 하나씩 맡아서 각자의 일정대로 찾아다녀요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์แต่ละตัวล่าของให้คุณทีละอย่าง ตามเวลาของมันเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi scout săn một món cho bạn, theo lịch riêng của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位侦察员各自负责搜寻一样东西,按自己的节奏进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位偵察員依自己的節奏,專門為你搜尋一樣東西。"
          }
        }
      }
    },
    "Each scout searches the web": {
      "localizations": {
