        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ दिन में दो बार कीमत चेक करता है और गिरने पर आपको टेक्स्ट करता है%2$@।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cek harga dua kali sehari dan kirim SMS kalau turun%2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は1日2回価格をチェックし、値下がりしたらテキストでお知らせします%2$@。"
