    "Enter a friend's handle, like @maya.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el usuario de un amigo, como @maya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l'identifiant d'un ami, comme @maya."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구의 핸들을 입력하세요. 예: @maya"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入好友的用户名,例如 @maya。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちのハンドルを入力してください（例：@maya）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên người dùng của bạn bè, ví dụ @maya."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan handle teman, misalnya @maya."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入朋友的帳號,例如 @maya。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่แฮนเดิลของเพื่อน เช่น @maya"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglagay ng handle ng friend, gaya ng @maya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दोस्त का हैंडल डालें, जैसे @maya।"
          }
        }
      }
    },
    "Enter a handle like @maya or an email address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa un usuario como @maya o un correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un identifiant comme @maya ou une adresse e-mail."
