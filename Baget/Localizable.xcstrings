    "Add friends by their handle, send them finds and see what they're into.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega amigos con su usuario, envíales hallazgos y mira qué les gusta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-add ng friends gamit ang handle nila, magpadala ng mga nahanap at tingnan kung ano ang gusto nila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des amis via leur pseudo, envoie-leur des trouvailles et vois ce qui leur plaît."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्तों को उनके हैंडल से जोड़ें, उन्हें खोजें भेजें और देखें कि उन्हें क्या पसंद है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah teman lewat handle-nya, kirim temuan, dan lihat apa yang mereka suka."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドル名で友だちを追加して、「発見」を送ったり、好みをチェックしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디로 친구를 추가하고, 발견을 보내고, 친구의 취향을 확인해 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเพื่อนด้วยแฮนเดิล ส่งของที่เจอให้ และดูว่าเขาชอบอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bạn bè bằng tên người dùng, gửi cho họ các phát hiện và xem họ thích gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过用户名添加好友,给 TA 发好物,看看 TA 喜欢什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用帳號名稱加好友,傳送發現給他們,看看他們喜歡什麼。"
          }
        }
      }
    },
