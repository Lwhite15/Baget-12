    "This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na ito mababawi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak bisa dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อนกลับไม่ได้นะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原。"
          }
        }
      }
    },
    "This card is being made": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarjeta se está creando"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagawa pa ang card na ito"
          }
        },
        "fr": {
