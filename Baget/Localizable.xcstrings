    "Good news, the %@ is back in stock at %@. Want it?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Good news, the %1$@ is back in stock at %2$@. Want it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buenas noticias: el %1$@ volvió a estar disponible en %2$@. ¿Lo quieres?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Good news, may stock na ulit ang %1$@ sa %2$@. Gusto mo ba?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne nouvelle : le %1$@ est de nouveau en stock chez %2$@. Tu le veux ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अच्छी खबर, %1$@ %2$@ पर फिर स्टॉक में है। चाहिए?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabar baik, %1$@ sudah restock lagi di %2$@. Mau?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朗報です。%1$@が%2$@で再入荷しました。ほしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 소식이에요, %2$@에 %1$@ 재입고됐어요. 가질래요?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข่าวดี! %1$@ กลับมามีของที่ %2$@ แล้ว เอาไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin vui, %1$@ đã có hàng lại tại %2$@. Bạn lấy không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好消息,%1$@在%2$@已补货。要入手吗?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好消息,%1$@ 在 %2$@ 補貨了。要買嗎?"
          }
        }
      }
    },
