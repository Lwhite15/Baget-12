            "state": "translated",
            "value": "เพื่อนและความเป็นส่วนตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bè và quyền riêng tư"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友与隐私"
          }
