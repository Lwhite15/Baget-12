    "Just the 8am Today's Drop, plus price drops and restocks on things you're watching.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el Today's Drop de las 8 a. m., más bajadas de precio y reabastecimientos de lo que sigues."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop lang tuwing 8am, plus price drops at restocks ng mga binabantayan mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement le Today's Drop de 8h, plus les baisses de prix et retours en stock des articles suivis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ सुबह 8 बजे का Today's Drop, साथ में आपकी वॉचलिस्ट की चीज़ों पर प्राइस ड्रॉप और रीस्टॉक।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Today's Drop jam 8 pagi, plus penurunan harga dan restock barang yang kamu pantau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝8時のToday's Dropと、ウォッチ中アイテムの値下げ・再入荷だけをお届けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오전 8시 Today's Drop과 지켜보는 상품의 가격 인하 및 재입고만 알려드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับแค่ Today's Drop ตอน 8 โมงเช้า พร้อมราคาลดและของเข้าใหม่ของที่คุณติดตามอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ Today's Drop lúc 8 giờ sáng, cùng tin giảm giá và hàng về lại của những món bạn đang theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只推送早上8点的“Today's Drop”,以及你关注商品的降价和补货提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有早上 8 點的 Today's Drop,加上你關注商品的降價與補貨通知。"
          }
        }
      }
    },
