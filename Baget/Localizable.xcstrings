    "Pull down any time to check for new finds": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo en cualquier momento para ver nuevos hallazgos"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-pull down anumang oras para tingnan kung may bagong nahanap"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire vers le bas à tout moment pour voir les nouvelles trouvailles"
