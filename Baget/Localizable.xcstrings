    "Got it. Your scout will ping you at release.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Tu explorador te avisará cuando salga."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sige. I-ping ka ng scout mo pag nag-release na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris. Ton éclaireur te préviendra à la sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझ गया। रिलीज़ पर आपका स्काउट आपको पिंग करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oke. Scout-mu akan mengabarimu saat rilis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解です。発売時にスカウトがお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알겠어요. 출시되면 스카우트가 알려줄게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับทราบ สเกาต์จะแจ้งคุณตอนวางขาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hiểu. Scout sẽ báo bạn khi mở bán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了。发售时你的买手会提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了。發售時你的星探會通知你。"
          }
        }
      }
    },
    "Got photos of things you love?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
