        }
      }
    },
    "%@ will find more like this": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encontrará más como este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en trouvera d'autres comme ça"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 비슷한 상품을 더 찾아올게요"
          }
        }
      }
    },
    "%@ will text you on a price drop, restock or release": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te enviará un mensaje si baja el precio, hay reposición o un lanzamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ t'enverra un SMS en cas de baisse de prix, de réassort ou de sortie"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 가격 인하, 재입고, 출시 때 문자로 알려드려요"
          }
        }
      }
    },
