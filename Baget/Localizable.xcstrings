            "value": "나"
          }
        }
      }
    },
    "You already have that section.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes esa sección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as déjà cette section."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 있는 섹션이에요."
          }
        }
      }
    },
    "You already picked up the %@. This is close. Sure you want both?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya compraste el %@. Este es muy parecido. ¿Seguro que quieres ambos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as déjà récupéré les %@. C'est très proche. Tu veux vraiment les deux ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 %@ 샀어요. 이건 비슷한데, 둘 다 살까요?"
          }
        }
      }
    },
    "You and %@ are now friends": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora tú y %@ son amigos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toi et %@ êtes maintenant amis"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 %@님과 친구예요"
          }
        }
      }
    },
    "You and @%@ are now friends": {
      "localizations": {
        "es": {
