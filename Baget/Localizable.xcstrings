    "Sample checkout. No card is charged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago de muestra. No se cobra ninguna tarjeta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample checkout. Walang sisingilin na card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement d'exemple. Aucune carte n'est débitée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपल चेकआउट। कोई कार्ड चार्ज नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh checkout. Kartu tidak akan ditagih."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルのチェックアウトです。請求は発生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 결제예요. 카드는 청구되지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างการชำระเงิน ไม่มีการตัดบัตร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán mẫu. Không tính phí thẻ nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例结账。不会扣款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例結帳,不會扣款。"
          }
        }
      }
    },
    "Sample data. Sign in to have your squad search the real web.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de muestra. Inicia sesión para que tu equipo busque en la web real."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data. Mag-sign in para hanapin ng squad mo ang totoong web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données d'exemple. Connectez-vous pour que votre équipe explore le vrai web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपल डेटा। अपनी टीम से असली वेब पर खोज करवाने के लिए साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data contoh. Masuk agar timmu bisa mencari di web sungguhan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータです。サインインすると、チームが実際のウェブを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터예요. 로그인하면 스쿼드가 실제 웹을 검색해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลตัวอย่าง เข้าสู่ระบบเพื่อให้ทีมของคุณค้นหาบนเว็บจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu mẫu. Đăng nhập để đội của bạn tìm kiếm trên web thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例数据。登录后,让你的侦察队搜索真实网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例資料。登入後,讓你的偵察隊搜尋真實網路。"
          }
        }
      }
    },
    "Sample data: Dre, Maya and Sam are sample friends, and their replies are simulated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de muestra: Dre, Maya y Sam son amigos de muestra y sus respuestas son simuladas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data: sample friends lang sina Dre, Maya at Sam, at simulated ang mga reply nila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données d'exemple : Dre, Maya et Sam sont des amis fictifs, et leurs réponses sont simulées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपल डेटा: Dre, Maya और Sam सैंपल दोस्त हैं, और उनके जवाब नकली हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data contoh: Dre, Maya, dan Sam adalah teman contoh, dan balasan mereka hanya simulasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータ:Dre、Maya、Samはサンプルの友だちで、返信はシミュレーションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터: Dre, Maya, Sam은 샘플 친구이고 답장은 시뮬레이션이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลตัวอย่าง: Dre, Maya และ Sam เป็นเพื่อนตัวอย่าง และคำตอบของพวกเขาเป็นการจำลอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu mẫu: Dre, Maya và Sam là bạn bè mẫu, các phản hồi của họ chỉ là giả lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例数据:Dre、Maya 和 Sam 是示例好友,他们的回复为模拟内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例資料:Dre、Maya 和 Sam 是範例好友,他們的回覆為模擬內容。"
          }
        }
      }
    },
    "Sample data: listings, prices and drop times are illustrative, and nothing is purchased.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de muestra: los anuncios, precios y horarios de lanzamiento son ilustrativos y no se compra nada."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data: halimbawa lang ang listings, presyo at oras ng drop, at walang binibili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données d'exemple : annonces, prix et horaires de drop sont fictifs, et rien n'est acheté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपल डेटा: लिस्टिंग, कीमतें और ड्रॉप का समय सिर्फ़ उदाहरण हैं, और कुछ भी खरीदा नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data contoh: listingan, harga, dan waktu drop hanya ilustrasi, dan tidak ada yang dibeli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータ:出品、価格、ドロップ時間はイメージで、実際の購入は行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터: 상품, 가격, 드롭 시간은 예시이며 실제 구매는 되지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลตัวอย่าง: รายการสินค้า ราคา และเวลาดรอปเป็นเพียงตัวอย่าง และไม่มีการซื้อจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu mẫu: tin đăng, giá và giờ mở bán chỉ mang tính minh họa, không có gì được mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例数据:商品、价格和发售时间仅作演示,不会真实购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例資料:商品、價格和發售時間僅供示意,不會真的購買。"
          }
        }
      }
    },
    "Sample tour": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorrido de muestra"
          }
        },
        "fil": {
