            "state": "translated",
            "value": "朋友與隱私"
          }
        }
      }
    },
    "Friends' finds and picks for you land here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友的发现和为你推荐的好物会出现在这里。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trouvailles et sélections de tes amis arrivent ici."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các món bạn bè tìm được và gợi ý dành cho bạn sẽ hiện ở đây."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구들의 발견과 추천이 여기에 도착해요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्तों के फाइंड और आपके लिए पिक्स यहाँ दिखेंगे।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของที่เพื่อนเจอและของที่เลือกให้คุณจะมาอยู่ตรงนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí llegan los hallazgos y las recomendaciones de tus amigos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友的發現和為你精選的推薦都會出現在這裡。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito lalabas ang mga find at pick ng mga kaibigan mo para sa'yo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちの発見やおすすめがここに届きます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temuan dan pilihan dari teman muncul di sini."
          }
        }
      }
    },
