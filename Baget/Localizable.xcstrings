        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghihintay ng approval ang purchase mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d'approbation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खरीद मंज़ूरी का इंतज़ार कर रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu menunggu persetujuan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の承認待ちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 승인을 기다리고 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการซื้อของคุณกำลังรออนุมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua của bạn đang chờ duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買正在等待核准。"
          }
        }
      }
    },
    "Your scout": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्काउट"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout-mu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのスカウト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 스카우트"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的探員"
          }
        }
      }
    },
    "Your scout learns the most from what you actually buy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador aprende más de lo que realmente compras."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinakamarami ang natututunan ng scout mo sa mga talagang binibili mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur apprend surtout de ce que vous achetez vraiment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्काउट सबसे ज़्यादा उसी से सीखता है जो आप सच में खरीदते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout-mu paling banyak belajar dari apa yang benar-benar kamu beli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトは、実際に買ったものから最も多くを学びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트는 실제로 구매한 것에서 가장 많이 배워요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์เรียนรู้จากสิ่งที่คุณซื้อจริงได้มากที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout học được nhiều nhất từ những gì bạn thực sự mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "买手从你实际购买的东西中学到最多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你實際購買的東西，最能讓探員學到你的喜好。"
          }
        }
      }
    },
    "Your scout only flags pairs in stock in this size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador solo te avisa de pares disponibles en esta talla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pares lang na may stock sa size na ito ang ipapakita ng scout mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur ne signale que les paires en stock dans cette taille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्काउट इस साइज़ में सिर्फ़ स्टॉक वाले जोड़े दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout-mu hanya menandai sepatu yang tersedia di ukuran ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトは、このサイズの在庫がある靴だけをお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이즈 재고가 있는 신발만 알려 드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์จะแจ้งเฉพาะคู่ที่มีของในไซส์นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout chỉ báo những đôi còn hàng ở size này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手只会提示这个尺码有货的鞋款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的探員只會標示這個尺寸有現貨的鞋款。"
          }
        }
      }
    },
    "Your scout only flags pieces in stock in this size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador solo te avisa de prendas disponibles en esta talla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piraso lang na may stock sa size na ito ang ipapakita ng scout mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur ne signale que les pièces en stock dans cette taille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्काउट इस साइज़ में सिर्फ़ स्टॉक वाले पीस दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout-mu hanya menandai pakaian yang tersedia di ukuran ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトは、このサイズの在庫がある服だけをお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이즈 재고가 있는 옷만 알려 드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์จะแจ้งเฉพาะชิ้นที่มีของในไซส์นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout chỉ báo những món còn hàng ở size này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手只会提示这个尺码有货的款式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的探員只會標示這個尺寸有現貨的單品。"
          }
        }
      }
    },
    "Your scouts never clock out and dig twice as deep: more searches, more stores and more angles on every hunt.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus exploradores nunca descansan y buscan el doble de a fondo: más búsquedas, más tiendas y más ángulos en cada caza."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang pahinga ang mga scout mo at mas malalim maghukay: mas maraming search, store at anggulo sa bawat hunt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éclaireurs ne s'arrêtent jamais et creusent deux fois plus : plus de recherches, plus de boutiques et plus d'angles à chaque chasse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्काउट कभी छुट्टी नहीं लेते और दोगुना गहराई से खोजते हैं: ज़्यादा सर्च, ज़्यादा स्टोर और हर खोज के ज़्यादा नज़रिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout-mu tak pernah berhenti dan menggali dua kali lebih dalam: lebih banyak pencarian, toko, dan sudut pandang di setiap perburuan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトは休まず、2倍深く探します。検索も店舗も視点も、ハントのたびに増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트는 쉬지 않고 두 배 더 깊이 찾아요. 더 많은 검색, 더 많은 스토어, 더 다양한 방법으로요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์ไม่เคยเลิกงานและขุดลึกกว่าเดิมสองเท่า ค้นหามากขึ้น ร้านมากขึ้น และหลายมุมมองขึ้นในทุกการล่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các scout không bao giờ nghỉ và đào sâu gấp đôi: nhiều lượt tìm hơn, nhiều cửa hàng hơn và nhiều góc nhìn hơn cho mỗi lần săn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手全年无休,挖得更深:每次搜寻都有更多搜索、更多商店和更多角度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的探員全年無休，而且挖得更深：更多搜尋、更多商店，每次搜尋都有更多角度。"
          }
        }
      }
    },
    "Your scouts search again right now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus exploradores vuelven a buscar ahora mismo"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maghahanap ulit ang mga scout mo ngayon din"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éclaireurs relancent la recherche maintenant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्काउट अभी फिर से खोजते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout-mu mencari lagi sekarang juga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトが今すぐ再検索します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 지금 바로 다시 검색해요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์ของคุณค้นหาอีกครั้งเดี๋ยวนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các scout tìm lại ngay bây giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手马上再搜一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的探員現在立刻重新搜尋"
          }
        }
      }
    },
    "Your section · matches “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sección · coincide con “%@”"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Section mo · tugma sa “%@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre section · correspond à « %@ »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
