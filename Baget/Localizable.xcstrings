            "value": "Teman hype"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盛り上げ友だち"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분위기 메이커 친구"
          }
        },
        "th": {
          "stringUnit": {
