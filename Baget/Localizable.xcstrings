          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 찾는 중이에요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณกำลังล่า"
          }
        },
        "vi": {
          "stringUnit": {
