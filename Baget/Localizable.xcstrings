          "stringUnit": {
            "state": "translated",
            "value": "%@ anda de caza. Los hallazgos llegan aquí en cuanto los encuentra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en chasse. Les trouvailles arrivent ici au fur et à mesure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사냥 중이에요. 발견한 상품은 바로 여기에 도착해요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang berburu. Temuan muncul di sini begitu ketemu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang đi săn. Phát hiện mới sẽ hiện ở đây ngay khi nó thấy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在外頭搜尋。一有發現就會出現在這裡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在外出搜寻,有发现会即时显示在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が探索中。見つけ次第、ここに発見が届きます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ออกไปล่าอยู่ เจอของแล้วจะมาโผล่ที่นี่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ शिकार पर है। खोज मिलते ही यहां आ जाएंगी।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghahanap ang %@. Lalabas dito ang mga nahanap habang nakikita niya."
          }
        }
      }
    },
    "%@ is sold out. Restock watch is on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está agotado. Vigilancia de reposición activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est épuisé. Suivi du réassort activé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 품절이에요. 재입고 알림이 켜져 있어요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ habis terjual. Pantauan restock aktif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã hết hàng. Đã bật theo dõi hàng về."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已售完。已開啟補貨提醒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已售罄,补货提醒已开启。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は売り切れです。再入荷ウォッチはオンです。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ หมดสต็อก เปิดเฝ้าของเข้าไว้แล้ว"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सोल्ड आउट है। रीस्टॉक वॉच चालू है।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sold out ang %@. Naka-on ang restock watch."
          }
        }
      }
    },
    "%@ learned from your photo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aprendió de tu foto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a appris grâce à ta photo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사진으로 학습했어요"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belajar dari fotomu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã học hỏi từ ảnh của bạn"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 從你的照片中學到了新東西"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从你的照片中学到了新东西"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が写真から学びました"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เรียนรู้จากรูปของคุณแล้ว"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने आपकी फ़ोटो से सीखा"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Natuto ang %@ sa photo mo"
          }
        }
      }
    },
    "%@ only flags %@ in stock in your size, and it doesn't know yours yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ only flags %2$@ in stock in your size, and it doesn't know yours yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ solo avisa de %2$@ en existencia en tu talla, y aún no conoce la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne signale que les %2$@ en stock dans ta taille, et ne connaît pas encore la tienne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스카우트는 내 사이즈 재고가 있는 %2$@만 알려주는데, 아직 사이즈를 몰라요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hanya menandai %2$@ yang tersedia di ukuranmu, dan belum tahu ukuranmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chỉ báo %2$@ khi còn hàng đúng size của bạn, mà nó chưa biết size của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 只會標示你尺寸有貨的 %2$@,但它還不知道你的尺寸。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 只提示你的尺码有货的%2$@,但它还不知道你的尺码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は、あなたのサイズの在庫がある%2$@だけを通知しますが、まだあなたのサイズを知りません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะแจ้งเฉพาะ %2$@ ที่มีของในไซซ์คุณ แต่ยังไม่รู้ไซซ์ของคุณเลย"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ सिर्फ़ आपके साइज़ में स्टॉक वाले %2$@ दिखाता है, और उसे अभी आपका साइज़ नहीं पता।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang %1$@ ay nagfa-flag lang ng %2$@ na in stock sa size mo, at hindi pa niya alam ang size mo."
          }
        }
      }
    },
    "%@ releases %@ at %@, %@. Matches your %@ preference.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ releases %2$@ at %3$@, %4$@. Matches your %5$@ preference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lanza %2$@ en %3$@, %4$@. Coincide con tu preferencia de %5$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sort %2$@ chez %3$@, %4$@. Correspond à ta préférence %5$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 출시: %3$@, %4$@. %5$@ 취향에 맞아요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ merilis %2$@ di %3$@, %4$@. Cocok dengan preferensi %5$@-mu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ra mắt %2$@ tại %3$@, %4$@. Hợp với sở thích %5$@ của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 將於 %3$@ 發售 %2$@,%4$@。符合你的%5$@偏好。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将在 %3$@ %4$@ 发售 %2$@。符合你的 %5$@ 偏好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@を発売（%3$@、%4$@）。%5$@のお好みに合っています。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ปล่อย %2$@ ที่ %3$@ %4$@ ตรงกับความชอบ %5$@ ของคุณ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %3$@ पर %2$@ रिलीज़ कर रहा है, %4$@। आपकी %5$@ पसंद से मेल खाता है।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ire-release ng %1$@ ang %2$@ sa %3$@, %4$@. Bagay sa %5$@ preference mo."
          }
        }
      }
    },
