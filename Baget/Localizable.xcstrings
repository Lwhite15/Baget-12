    "Show %@ something you love, like a fit, a shelf, a car or a room. It reads the style and hunts for more of it. The photo is saved privately to your account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muéstrale a %@ algo que te encante, como un outfit, un estante, un auto o una habitación. Capta el estilo y busca más como eso. La foto se guarda de forma privada en tu cuenta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita kay %@ ang mga gusto mo, gaya ng fit, shelf, kotse o kwarto. Babasahin nito ang style at maghahanap pa ng kagaya nito. Ligtas na naka-save sa account mo ang photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre à %@ quelque chose que tu aimes : une tenue, une étagère, une voiture ou une pièce. Il repère le style et en cherche d'autres. La photo est enregistrée en privé sur ton compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को कुछ ऐसा दिखाएँ जो आपको पसंद हो, जैसे कोई आउटफ़िट, शेल्फ़, कार या कमरा। यह स्टाइल समझकर उसके जैसा और ढूँढता है। फ़ोटो आपके अकाउंट में निजी रूप से सेव होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan sesuatu yang kamu suka ke %@, misalnya outfit, rak, mobil, atau ruangan. Ia membaca gayanya dan mencari yang serupa. Foto disimpan secara privat di akunmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に、コーデ、棚、車、部屋など、あなたの好きなものを見せてください。スタイルを読み取って、似たものを探します。写真はあなたのアカウントに非公開で保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핏, 선반, 자동차, 방처럼 마음에 드는 것을 %@에게 보여 주세요. 스타일을 읽고 비슷한 걸 더 찾아 줄 거예요. 사진은 내 계정에 비공개로 저장돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ %@ ดูสิ่งที่คุณรัก เช่น ลุคการแต่งตัว ชั้นวางของ รถ หรือห้อง แล้วสเกาต์จะอ่านสไตล์และตามหาเพิ่มให้ รูปจะถูกบันทึกเป็นส่วนตัวในบัญชีของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho %@ xem thứ bạn yêu thích, như một bộ đồ, một giá kệ, một chiếc xe hay một căn phòng. Scout sẽ nắm bắt phong cách và săn thêm món tương tự. Ảnh được lưu riêng tư trong tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给%@看看你喜欢的东西,比如穿搭、书架、汽车或房间。它会读懂风格并搜寻更多同款。照片会私密保存到你的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給 %@ 看看你喜歡的東西,像是穿搭、層架、車子或房間。它會讀懂風格並找出更多類似的。照片會私密儲存在你的帳號中。"
          }
        }
      }
    },
    "Show %@ something you love, like a fit, a shelf, a car or a room. It reads the style and hunts for more of it. The photo stays on your phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muéstrale a %@ algo que te encante, como un outfit, un estante, un auto o una habitación. Capta el estilo y busca más como eso. La foto se queda en tu teléfono."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita kay %@ ang mga gusto mo, gaya ng fit, shelf, kotse o kwarto. Babasahin nito ang style at maghahanap pa ng kagaya nito. Nasa phone mo lang ang photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre à %@ quelque chose que tu aimes : une tenue, une étagère, une voiture ou une pièce. Il repère le style et en cherche d'autres. La photo reste sur ton téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को कुछ ऐसा दिखाएँ जो आपको पसंद हो, जैसे कोई आउटफ़िट, शेल्फ़, कार या कमरा। यह स्टाइल समझकर उसके जैसा और ढूँढता है। फ़ोटो आपके फ़ोन में ही रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan sesuatu yang kamu suka ke %@, misalnya outfit, rak, mobil, atau ruangan. Ia membaca gayanya dan mencari yang serupa. Foto tetap ada di ponselmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に、コーデ、棚、車、部屋など、あなたの好きなものを見せてください。スタイルを読み取って、似たものを探します。写真はお使いのiPhoneに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핏, 선반, 자동차, 방처럼 마음에 드는 것을 %@에게 보여 주세요. 스타일을 읽고 비슷한 걸 더 찾아 줄 거예요. 사진은 내 휴대폰에만 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ %@ ดูสิ่งที่คุณรัก เช่น ลุคการแต่งตัว ชั้นวางของ รถ หรือห้อง แล้วสเกาต์จะอ่านสไตล์และตามหาเพิ่มให้ รูปจะอยู่ในโทรศัพท์ของคุณเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho %@ xem thứ bạn yêu thích, như một bộ đồ, một giá kệ, một chiếc xe hay một căn phòng. Scout sẽ nắm bắt phong cách và săn thêm món tương tự. Ảnh chỉ lưu trên điện thoại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给%@看看你喜欢的东西,比如穿搭、书架、汽车或房间。它会读懂风格并搜寻更多同款。照片只保存在你的手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給 %@ 看看你喜歡的東西,像是穿搭、層架、車子或房間。它會讀懂風格並找出更多類似的。照片只會留在你的手機上。"
          }
        }
      }
    },
