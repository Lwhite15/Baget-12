    "Shows at the top left of every screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra arriba a la izquierda en cada pantalla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas sa kaliwang itaas ng bawat screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'affiche en haut à gauche de chaque écran."
          }
        },
