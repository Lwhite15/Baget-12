        }
      }
    },
    "What happened, and what did you expect?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pasó y qué esperabas?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano'ng nangyari, at ano'ng inaasahan mo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s'est-il passé, et à quoi t'attendais-tu ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या हुआ, और आपने क्या सोचा था?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang terjadi, dan apa yang kamu harapkan?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が起きましたか?期待していたことも教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무슨 일이 있었고, 어떤 결과를 기대했나요?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดอะไรขึ้น และคุณคาดหวังอะไร?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyện gì đã xảy ra, và bạn mong đợi điều gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生了什么?你原本期望什么?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生了什麼事？你原本預期什麼？"
          }
        }
      }
    },
