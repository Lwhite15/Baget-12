    "%@: asking %@, market %@. About %lld%% under.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: asking %2$@, market %3$@. About %4$lld%% under."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: piden %2$@, mercado %3$@. Aprox. %4$lld%% menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : prix demandé %2$@, marché %3$@. Environ %4$lld%% de moins."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 판매가 %2$@, 시세 %3$@. 약 %4$lld%% 저렴해요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: harga tawar %2$@, pasar %3$@. Sekitar %4$lld%% lebih murah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: giá niêm yết %2$@, thị trường %3$@. Rẻ hơn khoảng %4$lld%%."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:開價 %2$@,市價 %3$@。約低 %4$lld%%。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:要价 %2$@,市价 %3$@。低约 %4$lld%%。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：希望価格%2$@、相場%3$@。約%4$lld%%安い。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ตั้งราคา %2$@ ตลาด %3$@ ถูกกว่าราว %4$lld%%"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: मांग %2$@, बाज़ार %3$@। लगभग %4$lld%% कम।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: asking %2$@, market %3$@. Mga %4$lld%% na mas mababa."
          }
        }
      }
