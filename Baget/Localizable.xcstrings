            "value": "%@の一覧ページで、単一の商品ではありません"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้ารวมรายการบน %@ ไม่ใช่สินค้าชิ้นเดียว"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर लिस्टिंग का पेज, कोई एक आइटम नहीं"
          }
        },
        "fil": {
