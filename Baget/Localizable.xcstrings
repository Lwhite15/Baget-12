    "Never miss a drop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te pierdas ningún lanzamiento"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag palampasin ang drop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne rate aucun drop"
          }
        },
        "hi": {
