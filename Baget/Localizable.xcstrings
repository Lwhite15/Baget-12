    },
    "Notifications are off for Baget. Turn them on in iPhone Settings so your squad can text you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Baget están desactivadas. Actívalas en los Ajustes del iPhone para que tu escuadrón pueda escribirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Baget. Active-les dans les Réglages de l'iPhone pour que ta squad puisse t'écrire."
          }
        },
        "ko": {
          "stringUnit": {
