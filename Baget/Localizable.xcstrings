    "Your session expired. Sign in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión expiró. Inicia sesión de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire na ang session mo. Mag-sign in ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Reconnectez-vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सेशन खत्म हो गया। फिर से साइन इन करें।"
