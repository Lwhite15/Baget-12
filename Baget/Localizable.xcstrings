    "Something went wrong (%lld). Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal (%lld). Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu (%lld). Réessaie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 생겼어요 (%lld). 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
