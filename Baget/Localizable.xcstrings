          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ अभी कुछ नहीं है"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรที่นี่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡還沒有內容"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang laman"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa"
          }
        }
      }
    },
    "Nothing here yet. Tap Hunt now, or pull down on Today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada. Toca Buscar ahora o desliza hacia abajo en Hoy."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa rito. I-tap ang Hunt now, o mag-pull down sa Today."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici pour l'instant. Appuie sur Chasser maintenant, ou tire vers le bas sur Today."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ अभी कुछ नहीं। अभी हंट करें पर टैप करें, या Today पर नीचे खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa. Ketuk Berburu sekarang, atau tarik ke bawah di Today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。「今すぐ探す」をタップするか、Todayで下に引っ張ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무것도 없어요. 지금 찾기를 탭하거나 투데이에서 아래로 당겨 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไร แตะ ล่าเลย หรือดึงลงที่หน้า Today"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì. Chạm Săn ngay, hoặc kéo xuống ở Hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还空着。点按“立即搜寻”,或在 Today 页下拉刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡還沒有內容。點「立即搜尋」,或在「今日」下拉。"
          }
        }
      }
    },
    "Nothing in today's stories matches “%@” yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en las historias de hoy coincide con “%@” todavía."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang tugma sa “%@” sa stories ngayon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien dans les stories du jour ne correspond à « %@ » pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की स्टोरी में “%@” से मेल खाता अभी कुछ नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada cerita hari ini yang cocok dengan “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のストーリーに「%@」に一致するものはまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 스토리에 “%@”와 일치하는 내용이 아직 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสตอรี่วันนี้ที่ตรงกับ “%@”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tin nào hôm nay khớp với “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的故事里还没有符合“%@”的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日故事中還沒有符合「%@」的內容。"
          }
        }
      }
    },
    "Nothing learned yet. Buy, watch or pass on finds and I'll pick up your taste.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no he aprendido nada. Compra, vigila o descarta hallazgos y descubriré tu estilo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang natutunan. Bumili, mag-watch, o mag-pass sa mga nahanap at makukuha ko ang taste mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'appris pour l'instant. Achète, surveille ou ignore des trouvailles et je cernerai tes goûts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ नहीं सीखा। खोजें खरीदें, वॉच करें या पास करें, तो मुझे आपकी पसंद समझ आ जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dipelajari. Beli, pantau, atau lewati temuan dan aku akan paham seleramu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ学習していません。発見を購入・ウォッチ・パスすると、好みを覚えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 배운 게 없어요. 발견을 구매하거나 지켜보거나 넘기면 취향을 알아갈게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เรียนรู้อะไร ซื้อ ติดตาม หรือข้ามของที่เจอ แล้วฉันจะจับสไตล์คุณได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa học được gì. Hãy mua, theo dõi hoặc bỏ qua vài phát hiện để mình nắm được gu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没学到什么。购买、关注或略过一些发现,我就能了解你的品味。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒學到什麼。對發現購買、關注或略過,我就會掌握你的品味。"
          }
        }
      }
    },
    "Nothing liked yet. Tap ♥ on a find you love and your scouts will find more like it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay favoritos. Toca ♥ en un hallazgo que te encante y tus exploradores encontrarán más como ese."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang na-like. I-tap ang ♥ sa nahanap na love mo at hahanap pa ng kapareho ang mga scout mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun coup de cœur. Appuie sur ♥ sur une trouvaille que tu adores et tes éclaireurs en trouveront d'autres du même genre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ लाइक नहीं किया। जो खोज पसंद आए उस पर ♥ टैप करें, आपके स्काउट ऐसी और खोजें लाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang disukai. Ketuk ♥ pada temuan favoritmu dan scout-mu akan mencari yang serupa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいねしたものはまだありません。好きな発見に♥をつけると、スカウトが似たものをもっと探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 좋아요한 게 없어요. 마음에 드는 발견에 ♥를 탭하면 스카우트가 비슷한 걸 찾아드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีที่ถูกใจ แตะ ♥ ที่ของที่เจอที่คุณชอบ แล้วสเกาต์จะหาแบบนี้เพิ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thích món nào. Chạm ♥ ở món bạn mê, trinh sát sẽ tìm thêm món tương tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有喜欢的。在你爱的发现上点按 ♥,你的侦察员会找更多类似的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有喜歡的。對你愛的發現點 ♥,你的探員會找更多類似的。"
          }
        }
      }
    },
    "Nothing matches their taste right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada coincide con su estilo por ahora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugma sa taste nila ngayon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne correspond à ses goûts pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी इनकी पसंद से कुछ मेल नहीं खा रहा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang cocok dengan selera mereka."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は好みに合うものがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 취향에 맞는 게 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่มีอะไรตรงกับสไตล์เขา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa có gì hợp gu của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有符合他们品味的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有符合他們品味的東西。"
          }
        }
      }
    },
    "Nothing new fits you right now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo te queda bien por ahora"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang bagong bagay para sa iyo ngayon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau à ta taille pour l'instant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आपके लिए कुछ नया फ़िट नहीं बैठता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang baru dan cocok untukmu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はあなたに合う新着がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 새로 맞는 게 없어요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่มีของใหม่ที่เหมาะกับคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
