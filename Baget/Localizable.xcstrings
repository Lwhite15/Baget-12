    "Reminder: the %@ releases %@ at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reminder: the %1$@ releases %2$@ at %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio: el %1$@ sale el %2$@ a las %3$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paalala: ilalabas ang %1$@ sa %2$@ sa %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel : la %1$@ sort le %2$@ à %3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर: %1$@ %2$@ को %3$@ पर रिलीज़ हो रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat: %1$@ rilis %2$@ di %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー:%1$@は%2$@の%3$@に発売です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림: %1$@ 제품이 %2$@ %3$@에 출시돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือน: %1$@ วางขาย %2$@ ที่ %3$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc nhở: %1$@ phát hành %2$@ lúc %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒:%1$@ 将于 %2$@ 在 %3$@ 发售。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒:%1$@ 將於 %2$@ %3$@ 發售。"
          }
        }
      }
    },
