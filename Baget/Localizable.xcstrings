    "Logged and off your list. %@ will learn from it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado y fuera de tu lista. %@ aprenderá de esto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-log na at wala na sa list mo. Matututo si %@ dito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est noté et retiré de ta liste. %@ va en tirer des leçons."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज हो गया और आपकी लिस्ट से हट गया। %@ इससे सीख लेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercatat dan dihapus dari daftarmu. %@ akan belajar dari ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録してリストから外しました。%@が学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록하고 목록에서 뺐어요. %@가 참고할게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้วและลบออกจากรายการ %@ จะเรียนรู้จากสิ่งนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ghi lại và xóa khỏi danh sách. %@ sẽ học từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录并从清单移除。%@ 会从中学习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記錄並從清單移除。%@ 會從中學習。"
          }
        }
      }
    },
    "Long-press a find, or tap its trash, to remove one": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un hallazgo, o toca su papelera, para quitarlo"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-long-press ang nahanap, o i-tap ang trash nito, para alisin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie longuement sur une trouvaille, ou sur sa corbeille, pour la supprimer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी खोज को हटाने के लिए उसे देर तक दबाएँ, या उसके ट्रैश पर टैप करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama sebuah temuan, atau ketuk ikon tempat sampahnya, untuk menghapus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するには、発見を長押しするか、ゴミ箱をタップしてください"
