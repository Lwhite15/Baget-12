          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्ड बन रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini sedang dibuat"
          }
        },
        "ja": {
