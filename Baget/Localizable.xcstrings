    "Plans aren't available right now. Try again in a minute.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes no están disponibles ahora. Inténtalo de nuevo en un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les offres ne sont pas disponibles pour le moment. Réessaie dans une minute."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 플랜을 이용할 수 없어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在プランをご利用いただけません。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法使用套餐。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用方案。請稍後再試。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket belum tersedia saat ini. Coba lagi sebentar lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa có gói nào. Hãy thử lại sau ít phút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังใช้แพลนไม่ได้ ลองใหม่อีกครั้งในอีกสักครู่"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang mga plan ngayon. Subukan ulit mamaya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लान अभी उपलब्ध नहीं हैं। एक मिनट बाद फिर कोशिश करें।"
          }
        }
      }
    },
