        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스카우트가 하루 두 번 가격을 확인하고, 내려가면 문자로 알려드려요%2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เช็กราคาวันละสองครั้ง และส่งข้อความหาคุณถ้าราคาลด%2$@"
          }
