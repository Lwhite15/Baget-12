    "What friends see next to your handle.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ven tus amigos junto a tu usuario."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang nakikita ng friends sa tabi ng handle mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tes amis voient à côté de ton pseudo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हैंडल के साथ दोस्तों को क्या दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dilihat teman di samping handle-mu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルネームの横に友だちへ表示されます。"
