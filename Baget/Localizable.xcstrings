    "In the sample tour, sweeps are simulated each time you come back to the app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el recorrido de muestra, las búsquedas se simulan cada vez que vuelves a la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la visite d'exemple, les recherches sont simulées à chaque retour dans l'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 투어에서는 앱에 돌아올 때마다 탐색이 시뮬레이션돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルツアーでは、アプリに戻るたびにスイープが擬似的に実行されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong chuyến tham quan mẫu, các lượt quét được mô phỏng mỗi khi bạn quay lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在示例导览中,每次你回到应用,都会模拟一次扫描。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di tur contoh, penyisiran disimulasikan setiap kali kamu kembali ke app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在範例導覽中,每次你回到 App 都會模擬一次搜尋。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในทัวร์ตัวอย่าง การค้นหาจะเป็นแบบจำลองทุกครั้งที่คุณกลับมาที่แอป"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa sample tour, ginagaya ang mga sweep tuwing babalik ka sa app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपल टूर में, हर बार ऐप पर लौटने पर स्वीप सिम्युलेट होते हैं।"
          }
        }
      }
    },
