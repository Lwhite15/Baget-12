    "You both go for %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos van por %@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareho kayong mahilig sa %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aimez tous les deux %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप दोनों को %@ पसंद है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalian berdua suka %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人とも%@が好きです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 분 모두 %@을(를) 좋아해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทั้งคู่ชอบ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đều mê %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们都偏爱%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們都偏愛%@。"
          }
        }
      }
    },
    "You both go for %@. %@ leans more %@ than you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You both go for %1$@. %2$@ leans more %3$@ than you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos van por %1$@. %2$@ se inclina más por %3$@ que tú."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareho kayong mahilig sa %1$@. Mas %3$@ si %2$@ kaysa sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aimez tous les deux %1$@. %2$@ penche plus %3$@ que vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप दोनों को %1$@ पसंद है। %2$@ आपसे ज़्यादा %3$@ की ओर झुके हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalian berdua suka %1$@. %2$@ lebih condong ke %3$@ daripada kamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人とも%1$@が好きです。%2$@さんはあなたより%3$@寄りです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 분 모두 %1$@을(를) 좋아해요. %2$@ 님이 나보다 %3$@ 쪽에 더 가까워요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทั้งคู่ชอบ %1$@ แต่ %2$@ เอนไปทาง%3$@มากกว่าคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đều mê %1$@. %2$@ thiên về %3$@ hơn bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们都偏爱%1$@。%2$@比你更偏%3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們都偏愛%1$@。%2$@比你更偏%3$@。"
          }
        }
      }
    },
