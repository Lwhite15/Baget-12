    "Notes you love": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas que te encantan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes que tu aimes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 노트"
          }
        }
      }
    },
    "Nothing here yet. Tap Hunt now, or pull down on Today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada. Toca Buscar ahora o desliza hacia abajo en Hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici pour l'instant. Appuie sur Chasser maintenant, ou tire vers le bas sur Today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무것도 없어요. 지금 찾기를 탭하거나 투데이에서 아래로 당겨 보세요."
          }
        }
      }
    },
    "Nothing in today's stories matches “%@” yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en las historias de hoy coincide con “%@” todavía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien dans les stories du jour ne correspond à « %@ » pour l'instant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 스토리에 “%@”와 일치하는 내용이 아직 없어요."
          }
        }
      }
    },
    "Nothing learned yet. Buy, watch or pass on finds and I'll pick up your taste.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no he aprendido nada. Compra, vigila o descarta hallazgos y descubriré tu estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'appris pour l'instant. Achète, surveille ou ignore des trouvailles et je cernerai tes goûts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 배운 게 없어요. 발견을 구매하거나 지켜보거나 넘기면 취향을 알아갈게요."
          }
        }
      }
    },
    "Nothing liked yet. Tap ♥ on a find you love and your scouts will find more like it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay favoritos. Toca ♥ en un hallazgo que te encante y tus exploradores encontrarán más como ese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun coup de cœur. Appuie sur ♥ sur une trouvaille que tu adores et tes éclaireurs en trouveront d'autres du même genre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 좋아요한 게 없어요. 마음에 드는 발견에 ♥를 탭하면 스카우트가 비슷한 걸 찾아드려요."
          }
        }
      }
    },
    "Nothing matches their taste right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada coincide con su estilo por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne correspond à ses goûts pour l'instant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 취향에 맞는 게 없어요."
          }
        }
      }
    },
    "Nothing new fits you right now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo te queda bien por ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau à ta taille pour l'instant"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 새로 맞는 게 없어요"
          }
        }
      }
    },
    "Nothing new from friends right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo de tus amigos por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau de la part de tes amis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 친구들의 새 소식이 없어요."
          }
        }
      }
    },
    "Nothing on watch. Tap Watch it for me on a find, or Notify me on something sold out, and it shows up here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en vigilancia. Toca Vigílalo por mí en un hallazgo, o Avísame en algo agotado, y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien en surveillance. Appuie sur « Surveille-le pour moi » sur une trouvaille, ou sur « Préviens-moi » sur un article épuisé, et il apparaîtra ici."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지켜보는 게 없어요. 발견에서 지켜봐 줘를, 품절 상품에서 알림 받기를 탭하면 여기에 나타나요."
          }
        }
      }
    },
    "Nothing worth showing you yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún nada que valga la pena mostrarte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à te montrer pour l'instant"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 보여드릴 만한 게 없어요"
          }
        }
      }
    },
    "Nothing yet. Like or pass a few finds, or tell it what you love.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún nada. Dale me gusta o descarta algunos hallazgos, o cuéntale qué te encanta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Like ou ignore quelques trouvailles, ou dis-lui ce que tu aimes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없어요. 발견에 좋아요를 누르거나 넘기거나, 좋아하는 걸 알려주세요."
          }
        }
      }
    },
    "Nothing yet. Testers can shake their phone or use Settings → Send feedback.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún nada. Los testers pueden agitar su teléfono o usar Ajustes → Enviar comentarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Les testeurs peuvent secouer leur téléphone ou aller dans Réglages → Envoyer un commentaire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없어요. 테스터는 휴대폰을 흔들거나 설정 → 피드백 보내기를 이용해 주세요."
          }
        }
      }
    },
    "Nothing yet. When your squad finds something, it'll text you here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún nada. Cuando tu escuadrón encuentre algo, te escribirá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Quand ta squad trouvera quelque chose, elle t'écrira ici."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없어요. 스카우트가 뭔가 찾으면 여기로 문자를 보내줄 거예요."
          }
        }
      }
    },
    "Noticed you're really into %@ lately. Hunting more of that now!": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notamos que últimamente te interesa mucho %@. ¡Ahora buscamos más de eso!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai vu que tu kiffes %@ en ce moment. Je cherche d'autres pépites !"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요즘 %@에 푹 빠지셨네요. 지금 더 찾아볼게요!"
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones"
