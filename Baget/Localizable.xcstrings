    "Every like and pass makes their next picks sharper.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada like y cada descarte afinan sus próximas selecciones."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat like at pass ay nagpapatalas sa susunod nilang picks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque like et chaque refus affinent ses prochaines sélections."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर लाइक और पास से उनकी अगली पसंद और सटीक होती जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap suka dan lewati membuat pilihan berikutnya lebih tepat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいねとパスのたびに、次のおすすめがより的確になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요와 패스를 할 때마다 다음 추천이 더 정확해져요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่กดถูกใจหรือข้าม ช่วยให้ตัวเลือกถัดไปของสเกาต์แม่นขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt thích và bỏ qua giúp gợi ý tiếp theo của họ chuẩn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次喜欢或跳过,都会让它们下次的推荐更精准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你每次按讚或略過,都會讓探員下次的推薦更精準。"
          }
        }
      }
    },
    "Every tap teaches your scouts your taste": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque le enseña a tus exploradores lo que te gusta"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat tap, natututo ang mga scout mo sa taste mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tap apprend tes goûts à tes éclaireurs"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर टैप से आपके स्काउट्स आपकी पसंद सीखते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketukan mengajari scout-mu seleramu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするたびに、スカウトがあなたの好みを学びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭할 때마다 스카우트가 내 취향을 알아가요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการแตะทำให้สเกาต์รู้จักสไตล์คุณมากขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần chạm giúp các scout hiểu gu của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次点击都会让侦察员更懂你的品味"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的每次點擊,都讓偵察員更懂你的品味"
          }
        }
      }
    },
