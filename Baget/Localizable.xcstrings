    "Baget gives you personal scouts that learn your taste, hunt the web and tell you when they find something worth buying.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget te da exploradores personales que aprenden tu estilo, rastrean la web y te avisan cuando encuentran algo que vale la pena comprar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binibigyan ka ng Baget ng mga personal na scout na natututo sa taste mo, naghahanap sa web, at nagsasabi sa iyo kapag may nakita silang sulit bilhin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget te donne des éclaireurs personnels qui apprennent tes goûts, ratissent le web et te préviennent quand ils trouvent un article qui vaut le coup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget आपको पर्सनल स्काउट देता है, जो आपकी पसंद सीखते हैं, वेब खंगालते हैं और कुछ खरीदने लायक मिलते ही बता देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget memberimu scout pribadi yang mempelajari seleramu, memburu di web, dan memberi tahu saat menemukan sesuatu yang layak dibeli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetは、あなたの好みを学び、ウェブを探し回り、買う価値のあるものが見つかったら知らせてくれる専用スカウトを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget은 내 취향을 익히고 웹을 샅샅이 뒤져서, 살 만한 걸 찾으면 알려주는 나만의 스카우트를 선물해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget มีสเกาต์ส่วนตัวที่เรียนรู้รสนิยมของคุณ ออกตามหาทั่วเว็บ แล้วบอกคุณเมื่อเจอของที่น่าซื้อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget mang đến cho bạn các scout riêng, biết rõ gu của bạn, săn lùng khắp web và báo ngay khi tìm thấy món đáng mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 为你配备专属猎手,它们了解你的品味,搜遍全网,发现值得买的好物就告诉你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 為你配置專屬尋寶員，學習你的品味、搜遍全網，找到值得入手的好東西就通知你。"
          }
        }
      }
    },
    "Baget isn't connected to a server yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget aún no está conectado a un servidor."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nakakonekta ang Baget sa server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget n'est pas encore connecté à un serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget अभी किसी सर्वर से कनेक्टेड नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget belum terhubung ke server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetはまだサーバーに接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget이 아직 서버에 연결되지 않았어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget ยังไม่ได้เชื่อมต่อกับเซิร์ฟเวอร์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget chưa được kết nối với máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 尚未连接到服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 尚未連接伺服器。"
          }
        }
      }
    },
    "Baget writes a Taste Card from what someone likes and passes on. Check back after a few more likes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget crea una Tarjeta de gusto con lo que a alguien le gusta y descarta. Vuelve después de unos «me gusta» más."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagawa ang Baget ng Taste Card base sa mga gusto at nilampasan ng isang tao. Bumalik pagkatapos ng ilan pang like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget crée une Taste Card à partir de ce qu'une personne aime et ignore. Revenez après quelques likes de plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget किसी की लाइक और पास की हुई चीज़ों से टेस्ट कार्ड बनाता है। कुछ और लाइक के बाद फिर देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget membuat Taste Card dari apa yang disukai dan dilewati seseorang. Cek lagi setelah beberapa suka lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget は、その人のいいねとパスからテイストカードを作ります。もう少しいいねしてから、また見に来てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget은 좋아요와 패스를 바탕으로 취향 카드를 만들어요. 좋아요를 조금 더 누른 뒤에 다시 확인해 주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget สร้างการ์ดรสนิยมจากสิ่งที่ใครสักคนชอบและข้าม กดถูกใจเพิ่มอีกหน่อยแล้วกลับมาดูนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget viết Taste Card dựa trên những gì ai đó thích và bỏ qua. Hãy quay lại sau vài lượt thích nữa nhé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 会根据一个人的喜欢和略过生成品味卡。多点几个喜欢后再来看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 會根據某人的喜歡與略過來製作品味卡。多按幾個喜歡後再來看看。"
          }
        }
      }
    },
