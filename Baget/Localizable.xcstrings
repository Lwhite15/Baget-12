    "Liked. Baget will show more like this": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te gustó. Baget te mostrará más como esto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aimé. Baget t'en montrera plus du même genre"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요를 눌렀어요. Baget이 비슷한 걸 더 보여드려요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいねしました。Bagetが似たアイテムをもっと表示します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已喜欢。Baget 会推荐更多类似的"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thích. Baget sẽ cho xem thêm món tương tự"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disukai. Baget akan menampilkan lebih banyak yang seperti ini"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已按喜歡。Baget 會推薦更多類似的"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกใจแล้ว Baget จะโชว์แบบนี้เพิ่ม"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-like. Mas marami pang ganito ang ipapakita ng Baget"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंद किया। Baget ऐसी और चीज़ें दिखाएगा"
          }
        }
      }
    },
