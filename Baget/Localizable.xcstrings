        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 스타일"
          }
        }
      }
    },
    "Texts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자"
          }
        }
      }
    },
    "Texts are on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes activados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS activés"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 켜짐"
          }
        }
      }
    },
    "Texts for strong matches (85%+) only, at most 6 a day, plus price drops, restocks, Today's Drop and friends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes solo para coincidencias fuertes (85%+), máximo 6 al día, además de bajas de precio, reposiciones, Today's Drop y amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS uniquement pour les correspondances fortes (85 %+), 6 par jour maximum, plus les baisses de prix, les retours en stock, Today's Drop et tes amis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치도 높은 상품(85%+)만 하루 최대 6번, 그리고 가격 인하, 재입고, Today's Drop, 친구 소식도 보내요."
          }
        }
      }
    },
    "Texts from %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS de %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 문자"
          }
        }
      }
    },
    "Thanks! Sent straight to the Baget team.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Enviado directo al equipo de Baget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Envoyé directement à l'équipe Baget."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사해요! Baget 팀에 바로 전달했어요."
          }
        }
      }
    },
    "That email and password don't match. Check them, or switch to Create account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo y contraseña no coinciden. Revísalos o cambia a Crear cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet e-mail et ce mot de passe ne correspondent pas. Vérifie-les ou passe à Créer un compte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일과 비밀번호가 일치하지 않아요. 다시 확인하거나 계정 만들기로 전환해 주세요."
          }
        }
      }
    },
    "That image couldn't be opened. Try another one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir esa imagen. Prueba con otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir cette image. Essaie-en une autre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 열 수 없어요. 다른 이미지를 사용해 보세요."
          }
        }
      }
    },
    "That subscription has ended.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa suscripción ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet abonnement est terminé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 종료되었어요."
          }
        }
      }
    },
    "That time has already passed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa hora ya pasó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure est déjà passée"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 지난 시간이에요"
          }
        }
      }
    },
    "That's already taken.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est déjà pris."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용 중이에요."
          }
        }
      }
    },
    "That's your own handle.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese es tu propio usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ton propre pseudo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 핸들이에요."
          }
        }
      }
    },
    "The %@ is going for %@, roughly %lld%% under market. Worth a look if you still want one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The %1$@ is going for %2$@, roughly %3$lld%% under market. Worth a look if you still want one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ está a %2$@, aproximadamente %3$lld%% por debajo del mercado. Vale la pena verlo si aún lo quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %1$@ est à %2$@, soit environ %3$lld%% sous le prix du marché. Ça vaut le coup d'œil si tu en veux encore un."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 가격은 %2$@로, 시세보다 약 %3$lld%%  저렴해요. 아직 관심 있다면 확인해 보세요."
          }
        }
      }
    },
    "The %@ is sold out right now. I'll keep watching and tell you the second it's back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %@ está agotado por ahora. Seguiré vigilando y te aviso en cuanto vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %@ est en rupture de stock. Je continue de surveiller et je te préviens dès son retour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 지금 품절이에요. 계속 지켜보다가 재입고되면 바로 알려드릴게요."
          }
        }
      }
    },
    "The Market Is Cooling on the %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mercado se enfría para el %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le marché se refroidit pour %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시장이 식고 있어요"
          }
        }
      }
    },
    "The North Face": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "The North Face"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "The North Face"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "The North Face"
          }
        }
      }
    },
    "The more you share, the better Baget gets. Be as descriptive as you like: brands you love, styles, colors, materials, sizes, your budget, what you're hunting for and why. Anything not listed above, just describe it and your scouts will find it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras más compartas, mejor funciona Baget. Describe todo lo que quieras: marcas que amas, estilos, colores, materiales, tallas, tu presupuesto, qué buscas y por qué. Si algo no está en la lista, solo descríbelo y tus exploradores lo encontrarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tu partages, meilleur Baget devient. Sois aussi précis que tu veux : marques adorées, styles, couleurs, matières, tailles, budget, ce que tu cherches et pourquoi. Tout ce qui n'est pas listé ci-dessus, décris-le et tes éclaireurs le trouveront."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많이 알려줄수록 Baget이 더 똑똑해져요. 좋아하는 브랜드, 스타일, 색상, 소재, 사이즈, 예산, 찾는 이유까지 자유롭게 설명해 주세요. 위에 없는 건 그냥 말씀해 주세요. 스카우트가 찾아와요."
          }
        }
      }
    },
    "The purchase didn't go through. %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se completó. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas abouti. %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 완료되지 않았어요. %@"
          }
        }
      }
    },
    "The scout that found it is gone. Add a scout and you can ask it anything about your finds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El explorador que lo encontró ya no está. Agrega un explorador y podrás preguntarle lo que sea sobre tus hallazgos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éclaireur qui l'a trouvé n'est plus là. Ajoute un éclaireur pour l'interroger sur tes trouvailles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찾아준 스카우트가 없어졌어요. 스카우트를 추가하면 발견에 대해 무엇이든 물어볼 수 있어요."
          }
        }
      }
    },
    "The styles, brands and creators your scouts hunt, so what friends send you lands better.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estilos, marcas y creadores que buscan tus exploradores, para que lo que te envíen tus amigos te llegue mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les styles, marques et créateurs que tes éclaireurs chassent, pour que ce que tes amis t'envoient tombe mieux."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 찾는 스타일, 브랜드, 크리에이터예요. 친구가 보내는 추천이 더 잘 맞게 해줘요."
          }
        }
      }
    },
    "The styles, makers and creators your scouts hunt, so suggestions land better.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estilos, fabricantes y creadores que buscan tus exploradores, para que las sugerencias te lleguen mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les styles, fabricants et créateurs que tes éclaireurs chassent, pour de meilleures suggestions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 찾는 스타일, 메이커, 크리에이터예요. 추천이 더 잘 맞게 해줘요."
          }
        }
      }
    },
    "Then they hunt every 6 hours, around the clock": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego buscan cada 6 horas, todo el día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, ils chassent toutes les 6 heures, jour et nuit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 6시간마다 하루 종일 찾아요"
          }
        }
      }
    },
    "Then they hunt every day and keep your finds fresh": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego buscan todos los días y mantienen frescos tus hallazgos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, ils chassent chaque jour et gardent tes trouvailles fraîches"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 매일 찾아서 발견을 최신으로 유지해요"
          }
        }
      }
    },
    "There's already an account with that email. Switch to Sign in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con ese correo. Cambia a Iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cet e-mail. Passe à Se connecter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일로 만든 계정이 이미 있어요. 로그인으로 전환해 주세요."
          }
        }
      }
    },
    "They learn your taste": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenden tu gusto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils apprennent tes goûts"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향을 알아가요"
          }
        }
      }
    },
    "They leave Finds and your scouts won't show them again. What your scouts learned about your taste stays.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salen de Hallazgos y tus exploradores no los mostrarán de nuevo. Lo que aprendieron de tu gusto se queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles quittent Trouvailles et tes éclaireurs ne les montreront plus. Ce que tes éclaireurs ont appris sur tes goûts reste."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견에서 사라지고 스카우트가 다시 보여주지 않아요. 스카우트가 알게 된 취향은 그대로 남아요."
          }
        }
      }
    },
    "They tell you first": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisan primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils te préviennent en premier"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 먼저 알려줘요"
          }
        }
      }
    },
    "They're searching stores, release calendars and resale sites for you right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo buscan por ti en tiendas, calendarios de lanzamientos y sitios de reventa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils fouillent boutiques, calendriers de sorties et sites de revente pour toi en ce moment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 스토어, 발매 일정, 리셀 사이트를 찾아보고 있어요."
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réflexion…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각 중…"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없어요."
          }
        }
      }
    },
    "This isn't available yet. Your scout will hold your spot and ask again at release.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no está disponible. Tu explorador te guardará el lugar y volverá a preguntar en el lanzamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore disponible. Ton éclaireur te garde ta place et redemandera à la sortie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 구매할 수 없어요. 스카우트가 자리를 맡아두고 발매 때 다시 물어볼게요."
          }
        }
      }
    },
    "Tip %lld of %lld: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Tip %1$lld of %2$lld: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo %1$lld de %2$lld: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce %1$lld sur %2$lld : %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁 %1$lld/%2$lld: %3$@"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘"
          }
        }
      }
    },
    "Today's Drop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop"
          }
        }
      }
    },
    "Today's Drop is ready: your squad's best picks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop está listo: lo mejor de tu escuadrón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop est prêt : les meilleures sélections de ton équipe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Drop이 준비됐어요: 우리 팀의 베스트 추천이에요."
          }
        }
      }
    },
    "Too pricey, wrong style, not your brand: every reason sharpens the next hunt. The more you react, the better it gets.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy caro, estilo equivocado, no es tu marca: cada motivo mejora la próxima búsqueda. Mientras más reaccionas, mejor funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop cher, mauvais style, pas ta marque : chaque raison affine la prochaine chasse. Plus tu réagis, mieux ça marche."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 비싸거나, 스타일이 아니거나, 맘에 안 드는 브랜드거나, 어떤 이유든 다음 탐색이 더 정확해져요. 반응할수록 더 좋아져요."
          }
        }
      }
    },
