    "Sign in with Apple didn't finish. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el inicio de sesión con Apple. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Apple n'a pas abouti. Réessaie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인을 완료하지 못했어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录未完成。请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインが完了しませんでした。もう一度お試しください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登入未完成,請再試一次。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan Apple belum selesai. Coba lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Apple chưa hoàn tất. Hãy thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบด้วย Apple ไม่สำเร็จ ลองอีกครั้ง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang Sign in with Apple. Subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple से साइन इन पूरा नहीं हुआ। फिर से कोशिश करें।"
          }
        }
      }
    },
    "Sign in with email": {
