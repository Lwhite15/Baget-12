    "Nice taste. %lld noted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen gusto. %lld anotados."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganda ng taste. %lld na ang naitala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon goût. %lld enregistrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अच्छी पसंद। %lld नोट किए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selera bagus. %lld tercatat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいセンスですね。%lld件を記録しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향 좋네요. %lld개 기억했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รสนิยมดี บันทึกแล้ว %lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gu tốt đấy. Đã ghi nhận %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "品味不错。已记录%lld项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好品味。已記下 %lld 件。"
          }
        }
      }
    },
    "Nice. It's off your list, and %@ will find more like it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genial. Ya no está en tu lista y %@ encontrará más como este."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice. Wala na ito sa list mo, at hahanap pa si %@ ng kapareho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super. C'est retiré de ta liste, et %@ en trouvera d'autres du même genre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया। यह आपकी लिस्ट से हट गया, और %@ ऐसी और खोजें लाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oke. Sudah dihapus dari daftarmu, dan %@ akan mencari yang serupa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解です。リストから外して、%@が似たアイテムをもっと探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요. 목록에서 뺐고, %@가 비슷한 걸 더 찾아볼게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เยี่ยม ลบออกจากรายการแล้ว และ %@ จะหาแบบนี้เพิ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt. Đã xóa khỏi danh sách, và %@ sẽ tìm thêm món tương tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好的。已从清单移除,%@ 会找更多类似的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好的,已從清單移除,%@ 會找更多類似的。"
          }
        }
      }
    },
    "No Baget Pro subscription found for this Apple ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una suscripción a Baget Pro para este Apple ID."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang Baget Pro subscription sa Apple ID na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement Baget Pro trouvé pour cet identifiant Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple ID पर Baget Pro सब्सक्रिप्शन नहीं मिला।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan Baget Pro tidak ditemukan untuk Apple ID ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple IDではBaget Proのサブスクリプションが見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple ID로 가입된 Baget Pro 구독이 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบการสมัคร Baget Pro ของ Apple ID นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy gói Baget Pro nào cho Apple ID này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple ID 下未找到 Baget Pro 订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple ID 下找不到 Baget Pro 訂閱。"
          }
        }
      }
    },
    "No activity yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay actividad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang activity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई गतिविधि नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada aktivitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティはまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 활동이 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีกิจกรรม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无动态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無活動。"
          }
        }
      }
    },
    "No backend set up yet, so metrics stay on this phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay backend configurado, así que las métricas se quedan en este teléfono."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang backend, kaya sa phone na ito lang ang metrics."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de backend configuré : les métriques restent sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई बैकएंड सेट नहीं है, इसलिए मेट्रिक्स इसी फ़ोन पर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada backend, jadi metrik tetap di ponsel ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンド未設定のため、指標はこのiPhone内にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 백엔드가 설정되지 않아 지표는 이 휴대폰에만 저장돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งค่าแบ็กเอนด์ ตัวเลขจึงเก็บไว้ในเครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thiết lập backend, nên số liệu chỉ lưu trên điện thoại này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置后端,所以指标只保存在这部手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定後端,所以指標只會留在這支手機上。"
          }
        }
      }
    },
    "No intel right now. Droplists, release calendars and news your scouts come across land here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin novedades por ahora. Aquí llegan las listas de lanzamientos, calendarios de estrenos y noticias que encuentren tus exploradores."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang intel ngayon. Dito lalabas ang droplists, release calendars, at balitang nakikita ng mga scout mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'infos pour l'instant. Les listes de drops, calendriers de sorties et actus repérés par tes éclaireurs arrivent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई इंटेल नहीं। ड्रॉपलिस्ट, रिलीज़ कैलेंडर और आपके स्काउट को मिली खबरें यहाँ आएँगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada info. Droplist, kalender rilis, dan berita yang ditemukan scout-mu muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は情報がありません。スカウトが見つけたドロップリスト、発売カレンダー、ニュースがここに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 소식이 없어요. 스카우트가 찾은 드롭리스트, 발매 일정, 뉴스가 여기에 모여요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังไม่มีข่าวสาร ลิสต์ดรอป ปฏิทินวางขาย และข่าวที่สเกาต์เจอจะมาอยู่ตรงนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa có tin. Danh sách drop, lịch phát hành và tin tức trinh sát tìm thấy sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有情报。发售清单、发售日历和侦察员发现的资讯都会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有情報。你的探員找到的發售清單、發售日曆和新聞都會出現在這裡。"
          }
        }
      }
    },
    "No limit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite"
