    "Teach": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseñar"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Turuan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseigner"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिखाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajari"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려주기"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สอน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dạy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教它"
          }
        }
      }
    },
    "Teach it your taste, not just names. It surfaces things that share these traits, even ones you've never heard of.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enséñale tu gusto, no solo nombres. Encuentra cosas con estos rasgos, incluso las que nunca has oído nombrar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Turuan ito ng taste mo, hindi lang ng mga pangalan. Naglalabas ito ng mga bagay na may ganitong katangian, kahit hindi mo pa naririnig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends-lui tes goûts, pas seulement des noms. Il déniche des articles qui partagent ces traits, même des marques dont tu n'as jamais entendu parler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ नाम नहीं, अपनी पसंद सिखाएँ। यह ऐसी चीज़ें दिखाता है जिनमें यही ख़ासियतें हों, वो भी जिनके बारे में आपने कभी सुना न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajari seleramu, bukan cuma nama. Ia akan menemukan hal-hal dengan ciri serupa, bahkan yang belum pernah kamu dengar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前だけでなく、好みを教えてください。共通点のあるものを、知らなかったものまで見つけてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 말고 취향을 알려주세요. 이런 특징을 가진 것들을 찾아와요. 처음 듣는 것도요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สอนรสนิยมของคุณ ไม่ใช่แค่ชื่อแบรนด์ แล้วจะเจอของที่มีลักษณะคล้ายกัน แม้แต่ของที่คุณไม่เคยรู้จัก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dạy trinh sát gu của bạn, không chỉ tên thương hiệu. Nó sẽ tìm ra những món có cùng nét đó, kể cả món bạn chưa từng nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教它你的品味,而不只是品牌名。它会找出具有这些特点的东西,甚至是你没听说过的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教它你的喜好，而不只是名稱。它會找出具有這些特色的東西，連你沒聽過的也找得到。"
          }
        }
      }
    },
