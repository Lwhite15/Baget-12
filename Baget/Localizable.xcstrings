    "Sample checkout. No card is charged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago de muestra. No se cobra ninguna tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement d'exemple. Aucune carte n'est débitée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 결제예요. 카드는 청구되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例结账。不会扣款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルのチェックアウトです。請求は発生しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例結帳,不會扣款。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh checkout. Kartu tidak akan ditagih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán mẫu. Không tính phí thẻ nào."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างการชำระเงิน ไม่มีการตัดบัตร"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
