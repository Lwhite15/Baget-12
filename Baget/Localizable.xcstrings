    },
    "Your scout learns the most from what you actually buy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador aprende más de lo que realmente compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur apprend surtout de ce que vous achetez vraiment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트는 실제로 구매한 것에서 가장 많이 배워요."
          }
        }
      }
    },
    "Your scout only flags pairs in stock in this size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador solo te avisa de pares disponibles en esta talla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur ne signale que les paires en stock dans cette taille."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이즈 재고가 있는 신발만 알려 드려요."
          }
        }
      }
    },
    "Your scout only flags pieces in stock in this size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu explorador solo te avisa de prendas disponibles en esta talla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre éclaireur ne signale que les pièces en stock dans cette taille."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이즈 재고가 있는 옷만 알려 드려요."
          }
        }
      }
    },
    "Your scouts never clock out and dig twice as deep: more searches, more stores and more angles on every hunt.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus exploradores nunca descansan y buscan el doble de a fondo: más búsquedas, más tiendas y más ángulos en cada caza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éclaireurs ne s'arrêtent jamais et creusent deux fois plus : plus de recherches, plus de boutiques et plus d'angles à chaque chasse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트는 쉬지 않고 두 배 더 깊이 찾아요. 더 많은 검색, 더 많은 스토어, 더 다양한 방법으로요."
          }
        }
      }
    },
    "Your scouts search again right now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus exploradores vuelven a buscar ahora mismo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éclaireurs relancent la recherche maintenant"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 지금 바로 다시 검색해요"
          }
        }
      }
    },
    "Your section · matches “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
