            "state": "translated",
            "value": "%@에 문자를 보내 드려요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับข้อความ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nhận được tin nhắn %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
