          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu aimes dedans ? ex. daim, tons terre"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 점이 마음에 드나요? 예: 스웨이드, 어스 톤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこが気に入っていますか?例:スエード、アースカラー"
