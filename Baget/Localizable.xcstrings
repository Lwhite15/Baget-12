          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak bisa dibatalkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อนกลับไม่ได้นะ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na ito mababawi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे वापस नहीं किया जा सकता।"
          }
        }
      }
    },
    "This isn't available yet. Your scout will hold your spot and ask again at release.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no está disponible. Tu explorador te guardará el lugar y volverá a preguntar en el lanzamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore disponible. Ton éclaireur te garde ta place et redemandera à la sortie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 구매할 수 없어요. 스카우트가 자리를 맡아두고 발매 때 다시 물어볼게요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ購入できません。スカウトが順番を確保して、発売時にあらためて確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这款还没上线。你的侦察员会帮你占位,发售时再来问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這項商品尚未開賣。你的偵察員會幫你卡位，並在發售時再問你一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sản phẩm này chưa có hàng. Scout của bạn sẽ giữ chỗ và hỏi lại khi mở bán."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini belum tersedia. Scout-mu akan menyimpan tempatmu dan bertanya lagi saat rilis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่เปิดให้ซื้อ สเกาต์ของคุณจะจองคิวไว้ แล้วถามอีกครั้งตอนวางขาย"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa ito available. Hahawakan ng scout mo ang pwesto mo at magtatanong ulit pag release na."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अभी उपलब्ध नहीं है। आपका स्काउट आपकी जगह रोककर रखेगा और रिलीज़ पर फिर पूछेगा।"
          }
        }
      }
    },
