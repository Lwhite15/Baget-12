    "Got it. Your scout will ping you at release.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Tu explorador te avisará cuando salga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris. Ton éclaireur te préviendra à la sortie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알겠어요. 출시되면 스카우트가 알려줄게요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解です。発売時にスカウトがお知らせします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hiểu. Scout sẽ báo bạn khi mở bán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了。发售时你的买手会提醒你。"
          }
