    "Heads up, the %@ drops %@ at %@. It's very your %@ thing. Want me to get checkout ready?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Heads up, the %1$@ drops %2$@ at %3$@. It's very your %4$@ thing. Want me to get checkout ready?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: el %1$@ sale el %2$@ en %3$@. Va muy con tu estilo %4$@. ¿Quieres que prepare el pago?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Info : le %1$@ sort %2$@ chez %3$@. Très ton style %4$@. Je prépare le paiement ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려드려요, %3$@에서 %1$@ 제품이 %2$@에 출시돼요. 딱 %4$@ 취향이에요. 결제 준비해 둘까요?"
          }
        }
      }
    },
