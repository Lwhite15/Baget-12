    },
    "You bought this one": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compraste este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez acheté celui-ci"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸 구매하셨어요"
          }
        }
      }
    },
    "You buy it at %@; Baget never charges you. Tap \"I bought it\" afterwards so your scout learns from it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo compras en %@; Baget nunca te cobra. Toca \"Lo compré\" después para que tu explorador aprenda de eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'achetez sur %@ ; Baget ne vous facture jamais. Touchez « Je l'ai acheté » ensuite pour que votre éclaireur apprenne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 직접 구매해요. Baget은 절대 결제하지 않아요. 구매 후 \"샀어요\"를 눌러 주세요. 스카우트가 보고 배워요."
          }
        }
      }
    },
    "You sent": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보냄"
          }
        }
      }
    },
    "You'll get a text %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un mensaje %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez un SMS %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 문자를 보내 드려요"
          }
        }
      }
    },
    "You're Pro. Your scouts hunt around the clock now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres Pro. Tus exploradores ahora buscan las 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes Pro. Vos éclaireurs chassent maintenant jour et nuit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro가 되셨어요. 이제 스카우트가 24시간 찾아다녀요."
          }
        }
      }
    },
    "You're all caught up. Your squad keeps hunting in the background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás al día. Tu escuadrón sigue buscando en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à jour. Votre équipe continue la chasse en arrière-plan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 확인했어요. 스카우트 팀은 백그라운드에서 계속 찾고 있어요."
          }
        }
      }
    },
    "You're looking at sample data. Signing in lets your scouts search the real web, sync across your devices and connect with friends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo datos de muestra. Si inicias sesión, tus exploradores buscarán en la web real, se sincronizarán entre tus dispositivos y podrás conectar con amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez des données d'exemple. En vous connectant, vos éclaireurs fouillent le vrai web, se synchronisent sur vos appareils et se connectent à vos amis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 샘플 데이터예요. 로그인하면 스카우트가 실제 웹을 검색하고, 기기 간에 동기화하고, 친구와 연결할 수 있어요."
          }
        }
      }
    },
    "You're offline. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Vérifiez votre connexion et réessayez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이에요. 연결을 확인하고 다시 시도해 주세요."
          }
        }
      }
    },
    "You've already added @%@.": {
