            "value": "आपको %@ टेक्स्ट मिलेगा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan dapat SMS %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にメッセージでお知らせします"
          }
        },
        "ko": {
