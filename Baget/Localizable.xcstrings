    },
    "Never miss what you'd love.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te pierdas lo que te encantaría."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag palampasin ang magugustuhan mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne rate rien de ce que tu aimerais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आपको पसंद आए, वो कभी न छूटे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan lewatkan yang kamu suka."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなものを見逃さない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아할 만한 건 놓치지 마세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พลาดของที่คุณจะรัก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng bỏ lỡ món bạn sẽ mê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不错过你会爱的好物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不錯過你會愛的好物。"
          }
        }
      }
    },
