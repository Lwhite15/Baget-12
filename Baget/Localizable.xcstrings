    "How much do you usually spend on one thing?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto sueles gastar en una sola cosa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien dépenses-tu en général pour un achat ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 하나에 얼마나 쓰세요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1点にいつもいくらくらい使いますか?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thường chi bao nhiêu cho một món?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你通常单件花多少钱?"
          }
        },
