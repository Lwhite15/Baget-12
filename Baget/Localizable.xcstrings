          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo xuống bất cứ lúc nào để xem phát hiện mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
