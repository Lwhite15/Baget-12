          }
        }
      }
    },
    "Type or say it in your own words. Baget builds the right scout and it starts searching right away.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelo o dilo con tus propias palabras. Baget crea el explorador ideal y empieza a buscar de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris-le ou dis-le avec tes mots. Baget crée le bon éclaireur et il se met tout de suite en chasse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 대로 입력하거나 말해 보세요. Baget이 딱 맞는 스카우트를 만들어 바로 찾기 시작해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の言葉で入力するか話してください。Bagetが最適なスカウトを作り、すぐに探し始めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字或直接说出你的想法。Baget 会打造合适的侦察员,并立即开始搜寻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的話輸入或說出來。Baget 會打造合適的偵察員，並立刻開始搜尋。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ hoặc nói theo cách của bạn. Baget sẽ tạo scout phù hợp và bắt đầu tìm ngay."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik atau ucapkan dengan kata-katamu sendiri. Baget membuat scout yang pas dan langsung mulai mencari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์หรือพูดด้วยคำของคุณเอง Baget จะสร้างสเกาต์ที่ใช่ แล้วเริ่มค้นหาทันที"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-type o sabihin sa sarili mong salita. Gagawa ang Baget ng tamang scout at magsisimula agad itong maghanap."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शब्दों में लिखें या बोलें। Baget सही स्काउट बनाता है और वह तुरंत खोजना शुरू कर देता है।"
          }
        }
      }
    },
    "Type what this section should show, like “vinyl” or “Porsche”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe qué debe mostrar esta sección, como “vinilos” o “Porsche”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ce que cette section doit afficher, par ex. « vinyles » ou « Porsche »."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 섹션에 보여줄 내용을 입력하세요. 예: “바이닐”, “포르쉐”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセクションに表示したい内容を入力してください(例:「レコード」「Porsche」)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入这个版块要展示的内容,比如“黑胶”或“保时捷”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入此區塊要顯示的內容，例如「黑膠」或「Porsche」。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập nội dung mục này sẽ hiển thị, như “vinyl” hoặc “Porsche”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik apa yang harus tampil di bagian ini, misalnya “vinyl” atau “Porsche”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์สิ่งที่อยากให้หมวดนี้แสดง เช่น “แผ่นเสียง” หรือ “Porsche”"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-type kung ano ang dapat ipakita ng section na ito, gaya ng “vinyl” o “Porsche”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखें कि इस सेक्शन में क्या दिखे, जैसे “विनाइल” या “Porsche”।"
          }
        }
      }
    },
    "Ugh, the %@ sold out before I could get to it. I'm camped out for the restock.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uf, los %@ se agotaron antes de que pudiera comprarlos. Estoy al acecho del restock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zut, les %@ sont épuisées avant que je puisse les avoir. Je guette le réassort."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아, %@ 품절됐어요. 다시 들어올 때까지 기다리는 중이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あぁ、%@が間に合わず売り切れました。再入荷を待ち構えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哎,%@ 还没等到我就卖光了。我就守着等补货了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唉，%@ 在我下手前就賣完了。我會守著等補貨。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trời ơi, %@ hết hàng trước khi mình kịp mua. Mình sẽ canh đến khi có hàng lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Duh, %@ habis sebelum sempat kubeli. Aku siaga menunggu restock."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โธ่ %@ ขายหมดก่อนที่ฉันจะทันได้ซื้อ ขอรอของเข้าใหม่อยู่นี่แหละ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naku, sold out na ang %@ bago ko pa nakuha. Nakaabang ako sa restock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उफ़्फ़, %@ मेरे पहुँचने से पहले ही सोल्ड आउट हो गया। अब रीस्टॉक के इंतज़ार में डटे हैं।"
          }
        }
      }
    },
    "Under the radar": {
      "localizations": {
