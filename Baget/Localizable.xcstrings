    "Every day your scouts' best finds land at the top, with more picks for you below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día, los mejores hallazgos de tus exploradores aparecen arriba, y más opciones para ti abajo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Araw-araw, nasa taas ang pinakamagagandang nahanap ng mga scout mo, at may iba pang pick para sa iyo sa ibaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour, les meilleures trouvailles de tes éclaireurs arrivent en haut, avec d'autres idées pour toi en dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन आपके स्काउट्स की सबसे बढ़िया खोजें सबसे ऊपर आती हैं, और नीचे आपके लिए और पसंद।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiap hari, temuan terbaik scout-mu muncul paling atas, dengan pilihan lain untukmu di bawahnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、スカウトのイチオシの発見が一番上に届き、その下にはあなたへのおすすめが並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 스카우트들의 최고 발견이 맨 위에 뜨고, 아래에는 추천이 더 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกวัน ของที่เจอที่ดีที่สุดจากสเกาต์จะอยู่บนสุด และมีของคัดมาให้อีกด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngày, những phát hiện hay nhất của các scout sẽ lên đầu, kèm thêm nhiều gợi ý cho bạn bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天,侦察员找到的最佳好物会排在最上方,下面还有更多为你精选的推荐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天,偵察員的最佳發現會排在最上面,下方還有更多為你推薦的精選。"
          }
        }
      }
    },
    "Every find, as it happens.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hallazgo, al instante."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat find, agad-agad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trouvaille, en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर खोज, उसी पल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap temuan, saat itu juga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての発見をリアルタイムで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견하는 즉시 모두 알려드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกชิ้นที่เจอ ทันทีที่เจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi phát hiện, ngay khi xuất hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个发现,实时推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個發現,即時通知。"
          }
        }
      }
    },
    "Every hour": {
      "localizations": {
        "es": {
