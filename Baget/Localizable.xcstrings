    "Got it for you: the %@, %@. It's in your Finds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Got it for you: the %1$@, %2$@. It's in your Finds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: el %1$@, %2$@. Está en tus Hallazgos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakuha ko na para sa iyo: ang %1$@, %2$@. Nasa Mga Nahanap mo na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est fait : le %1$@, %2$@. Il est dans tes Trouvailles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए मिल गया: %1$@, %2$@। यह आपकी खोजों में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dapat: %1$@, %2$@. Ada di Temuan-mu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確保しました:%1$@、%2$@。発見に入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찾았어요: %2$@의 %1$@. 발견 목록에 담아뒀어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดให้แล้ว: %1$@ %2$@ อยู่ในของที่เจอของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có rồi nhé: %1$@, %2$@. Nằm trong Phát hiện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给你拿下了:%1$@,%2$@。已放入你的发现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫你拿到了:%1$@,%2$@。已放進你的發現。"
          }
        }
      }
    },
