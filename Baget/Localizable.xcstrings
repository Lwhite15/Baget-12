            "value": "예: %@"
          }
        }
      }
    },
    "e.g. New Balance 990s in grey or earth tones, size 10.5, under $200. Also hunting a vintage Carhartt chore coat.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., New Balance 990 en gris o tonos tierra, talla 10.5, por menos de $200. También busco un chaquetón Carhartt vintage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. New Balance 990 grises ou terre, pointure 44, moins de 200 $. Je cherche aussi une veste Carhartt vintage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 회색이나 어스 톤 New Balance 990, 사이즈 10.5, 200달러 이하. 빈티지 Carhartt 초어 코트도 찾고 있어요."
          }
        }
      }
    },
