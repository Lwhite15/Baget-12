    "Shows on its card and on every text it sends you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en su tarjeta y en cada mensaje de texto que te envía."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas sa card nito at sa bawat text na ipinapadala nito sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaît sur sa carte et dans chaque SMS qu'il t'envoie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कार्ड पर और आपको भेजे हर टेक्स्ट पर दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muncul di kartunya dan di setiap pesan yang dikirimkannya padamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードと、送信するすべてのテキストに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드와 보내는 모든 문자에 표시돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงบนการ์ดและในทุกข้อความที่ส่งถึงคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trên thẻ của scout và trong mọi tin nhắn nó gửi cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在它的卡片上,以及它发给你的每条短信里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在它的卡片上,以及它傳給你的每則訊息。"
          }
        }
      }
    },
