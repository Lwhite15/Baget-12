        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견을 길게 누르거나 휴지통을 탭해서 삭제하세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างที่ของที่เจอ หรือแตะถังขยะเพื่อลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ một phát hiện, hoặc chạm biểu tượng thùng rác, để xóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按某个发现,或点按其垃圾桶图标即可移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按發現,或點垃圾桶圖示即可移除"
          }
        }
      }
