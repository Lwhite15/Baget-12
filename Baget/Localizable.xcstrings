    },
    "Friends add you by your handle, @%@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos te agregan con tu usuario, @%@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idinadagdag ka ng mga kaibigan gamit ang handle mo, @%@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos amis vous ajoutent avec votre identifiant, @%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त आपको आपके हैंडल @%@ से जोड़ते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman menambahkanmu lewat handle-mu, @%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちはあなたのハンドル「@%@」で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구는 내 핸들 @%@로 나를 추가해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อนเพิ่มคุณได้ด้วยแฮนเดิล @%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bè thêm bạn qua tên người dùng @%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友可通过你的用户名 @%@ 添加你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友可用你的用戶名稱 @%@ 加你。"
          }
        }
      }
    },
    "Friends add you by your handle. Deleting your account permanently removes your scouts, finds, purchases, photos and friends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos te agregan con tu usuario. Al eliminar tu cuenta se borran de forma permanente tus exploradores, hallazgos, compras, fotos y amigos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idinadagdag ka ng mga kaibigan gamit ang handle mo. Kapag binura ang account mo, permanenteng mawawala ang mga scout, nahanap, purchases, photos, at kaibigan mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos amis vous ajoutent avec votre identifiant. Supprimer votre compte efface définitivement vos éclaireurs, trouvailles, achats, photos et amis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त आपको आपके हैंडल से जोड़ते हैं। अकाउंट डिलीट करने पर आपके स्काउट, खोजें, खरीदारियाँ, फ़ोटो और दोस्त हमेशा के लिए हट जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman menambahkanmu lewat handle-mu. Menghapus akunmu akan menghapus permanen scout, temuan, pembelian, foto, dan temanmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちはあなたのハンドルで追加できます。アカウントを削除すると、スカウト、発見、購入履歴、写真、友だちが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구는 내 핸들로 나를 추가해요. 계정을 삭제하면 스카우트, 발견, 구매 내역, 사진, 친구가 영구적으로 삭제돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อนเพิ่มคุณได้ด้วยแฮนเดิลของคุณ การลบบัญชีจะลบสเกาต์ ของที่เจอ การซื้อ รูปภาพ และเพื่อนของคุณอย่างถาวร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bè thêm bạn qua tên người dùng. Xóa tài khoản sẽ xóa vĩnh viễn scout, phát hiện, đơn mua, ảnh và bạn bè của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友通过你的用户名添加你。删除账号将永久移除你的买手、发现、购买记录、照片和好友。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友可用你的用戶名稱加你。刪除帳號會永久移除你的星探、發現、購買紀錄、照片和朋友。"
          }
        }
      }
    },
    "Friends and privacy": {
      "localizations": {
        "es": {
          "stringUnit": {
