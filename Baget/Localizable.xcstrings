    "Up to 5 scouts, hunting every 6 hours and twice as deep": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 5 exploradores, buscando cada 6 horas y al doble de profundidad"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 5 scouts, naghahanap kada 6 na oras at dalawang beses na mas malalim"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à 5 éclaireurs, en chasse toutes les 6 heures et deux fois plus en profondeur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 स्काउट तक, हर 6 घंटे में खोज और दोगुनी गहराई"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga 5 scout, berburu tiap 6 jam dan dua kali lebih dalam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大5つのスカウトが6時間ごとに2倍の深さで探索"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 최대 5개, 6시간마다 두 배 더 깊게 탐색해요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์สูงสุด 5 ตัว ล่าทุก 6 ชั่วโมง และลึกขึ้นสองเท่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa 5 scout, săn mỗi 6 giờ và sâu gấp đôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 5 个侦察员,每 6 小时搜寻一次,深度翻倍"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 5 位偵察員，每 6 小時搜尋一次，深度加倍"
          }
