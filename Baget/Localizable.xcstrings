    "%lld liked, %lld passed. Your squad just got sharper; their next search uses it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld liked, %2$lld passed. Your squad just got sharper; their next search uses it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld me gustaron, %2$lld descartados. Tus exploradores están más afinados; su próxima búsqueda lo usará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld aimés, %2$lld écartés. Ton équipe d'éclaireurs est plus affûtée : leur prochaine recherche en tiendra compte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개 좋아요, %2$lld개 패스. 스카우트가 더 똑똑해졌어요. 다음 검색에 반영돼요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld disukai, %2$lld dilewati. Timmu makin tajam; pencarian berikutnya memakainya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thích %1$lld, bỏ qua %2$lld. Đội scout của bạn vừa tinh hơn; lần tìm kế tiếp sẽ dùng điều này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜歡 %1$lld 個,略過 %2$lld 個。你的探員團更敏銳了,下次搜尋就會用上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢 %1$lld 个,略过 %2$lld 个。你的星探团更敏锐了,下次搜索就会用上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld件いいね、%2$lld件パス。スカウトがさらに賢くなり、次の検索に反映されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกใจ %1$lld ข้าม %2$lld ทีมของคุณแม่นขึ้นแล้ว การค้นครั้งหน้าจะใช้ข้อมูลนี้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld पसंद, %2$lld छोड़े। आपकी टोली और तेज़ हो गई; अगली खोज में यही काम आएगा।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld nagustuhan, %2$lld nilampasan. Mas matalas na ang squad mo; gagamitin nila ito sa susunod na paghahanap."
          }
        }
      }
    },
