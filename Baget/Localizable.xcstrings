    "A heads-up when something you'd love drops, restocks or goes on sale.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso cuando algo que te encantaría se lance, se reponga o esté en oferta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte quand un article qui te plaît sort, revient en stock ou passe en promo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아할 만한 상품이 출시되거나 재입고, 할인되면 알려드려요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabar saat barang incaranmu rilis, restock, atau diskon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cho bạn khi món bạn mê sắp ra mắt, có hàng lại hoặc giảm giá."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你心儀的商品發售、補貨或特價時,馬上通知你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心仪的商品发售、补货或打折时,第一时间提醒你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になるアイテムが発売・再入荷・セールになったらお知らせします。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนเมื่อของที่คุณรักวางขาย ของเข้า หรือลดราคา"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी पसंद की चीज़ आए, रीस्टॉक हो या सेल में लगे, तो झट से खबर पाएं।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abiso kapag may bagong drop, restock o sale ng gusto mo."
          }
        }
      }
    },
    "A page of listings on %@, not a single item": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página de listados en %@, no un solo artículo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page d'annonces sur %@, pas un article unique"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 상품이 아닌 %@의 목록 페이지"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman daftar produk di %@, bukan satu barang"
