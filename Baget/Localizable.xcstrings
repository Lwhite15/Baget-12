    "EU or UK sizing? Put it in your own words on the first screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tallas de la UE o del Reino Unido? Escríbelo con tus palabras en la primera pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailles EU ou UK ? Dites-le avec vos mots sur le premier écran."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EU나 UK 사이즈인가요? 첫 화면에서 직접 말해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欧码或英码?请在第一屏用你自己的话说明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EUやUKのサイズですか？最初の画面でご自身の言葉で入力してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng size EU hoặc UK? Hãy nói bằng lời của bạn ở màn hình đầu tiên."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran EU atau UK? Tulis dengan kata-katamu sendiri di layar pertama."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歐規或英規尺寸?請在第一個畫面用你自己的話說明。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไซส์ EU หรือ UK? บอกด้วยคำของคุณเองในหน้าแรกได้เลย"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "EU o UK sizing? Sabihin sa sarili mong salita sa unang screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "EU या UK साइज़? पहली स्क्रीन पर अपने शब्दों में लिखें।"
          }
        }
      }
    },
    "Each scout searches the web": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada explorador busca en la web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque éclaireur fouille le web"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트마다 웹을 검색해요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位侦察员都会搜遍全网"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スカウトがウェブを検索"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi scout tìm kiếm trên web"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap scout menjelajahi web"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位探員都會搜遍網路"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์แต่ละตัวค้นหาทั่วเว็บ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat scout ay naghahanap sa web"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्काउट पूरा वेब खंगालता है"
          }
        }
      }
    },
    "Earthy & green": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terroso y verde"
          }
        },
        "fr": {
          "stringUnit": {
