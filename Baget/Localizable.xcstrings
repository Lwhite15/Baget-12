    "Price drop: the %@ is now %@ at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Price drop: the %1$@ is now %2$@ at %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajó de precio: el %1$@ ahora está en %2$@ en %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse de prix : le %1$@ est maintenant à %2$@ chez %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 인하: %1$@ 상품이 %3$@에서 %2$@로 내려갔어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値下げ:%1$@が%3$@で%2$@になりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降价了:%1$@ 在 %3$@ 现价 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "降價了:%1$@ 在 %3$@ 現在只要 %2$@。"
          }
        },
        "id": {
