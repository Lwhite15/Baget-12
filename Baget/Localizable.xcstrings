          "stringUnit": {
            "state": "translated",
            "value": "살펴보는 중…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดู…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xem thử…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看中…"
          }
        }
      }
    },
    "Talk to %@": {
      "localizations": {
        "es": {
