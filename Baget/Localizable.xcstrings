          "stringUnit": {
            "state": "translated",
            "value": "你的小隊正在搜尋"
          }
        }
      }
    },
    "Your squad keeps hunting in the background and will text you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón sigue buscando en segundo plano y te enviará un mensaje."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patuloy na naghahanap ang squad mo sa background at ite-text ka nila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe continue la chasse en arrière-plan et vous enverra un SMS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम बैकग्राउंड में खोजती रहती है और आपको टेक्स्ट करेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu terus berburu di latar belakang dan akan mengirimimu SMS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームはバックグラウンドで探し続け、メッセージでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 백그라운드에서 계속 찾고, 문자로 알려 드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณล่าต่อเบื้องหลังและจะส่งข้อความหาคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout tiếp tục săn ngầm và sẽ nhắn tin cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团会在后台继续搜寻,并给你发短信。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊會在背景繼續搜尋，並傳簡訊通知你。"
          }
        }
      }
    },
    "Your squad kept searching the web and found %lld new %@ for you.%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad kept searching the web and found %1$lld new %2$@ for you.%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo siguió buscando en la web y encontró %1$lld %2$@ nuevos para ti.%3$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patuloy na naghanap sa web ang squad mo at nakahanap ng %1$lld bagong %2$@ para sa iyo.%3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe a continué de fouiller le web et a déniché %1$lld %2$@ de plus pour vous.%3$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम ने वेब पर खोज जारी रखी और आपके लिए %1$lld नई %2$@ ढूँढीं।%3$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu terus menelusuri web dan menemukan %1$lld %2$@ baru untukmu.%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームがWebを探し続け、新しい%2$@を%1$lld件見つけました。%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트 팀이 계속 웹을 검색해서 새 %2$@ %1$lld개를 찾았어요.%3$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมของคุณค้นหาเว็บต่อและเจอ%2$@ใหม่ %1$lld ชิ้นให้คุณ%3$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đội scout đã tiếp tục tìm trên web và có %1$lld %2$@ mới cho bạn.%3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的买手团继续搜索网络,为你找到 %1$lld 个新%2$@。%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊持續搜尋網路，為你找到 %1$lld 個新%2$@。%3$@"
          }
        }
      }
    },
    "Your squad kept searching the web and found %lld new thing%@ for you.%@": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your squad kept searching the web and found %1$lld new thing%2$@ for you.%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuadrón siguió buscando en la web y encontró %1$lld novedad%2$@ para ti.%3$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
