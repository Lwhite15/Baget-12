    "Describe what you love and what you're looking for": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe lo que te encanta y lo que buscas"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilarawan ang mga gusto mo at ang hinahanap mo"
