    "Baget gives you personal scouts that learn your taste, hunt the web and tell you when they find something worth buying.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget te da exploradores personales que aprenden tu estilo, rastrean la web y te avisan cuando encuentran algo que vale la pena comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget te donne des éclaireurs personnels qui apprennent tes goûts, ratissent le web et te préviennent quand ils trouvent un article qui vaut le coup."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget은 내 취향을 익히고 웹을 샅샅이 뒤져서, 살 만한 걸 찾으면 알려주는 나만의 스카우트를 선물해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 为你配备专属猎手,它们了解你的品味,搜遍全网,发现值得买的好物就告诉你。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget mang đến cho bạn các scout riêng, biết rõ gu của bạn, săn lùng khắp web và báo ngay khi tìm thấy món đáng mua."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 為你配置專屬尋寶員，學習你的品味、搜遍全網，找到值得入手的好東西就通知你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetは、あなたの好みを学び、ウェブを探し回り、買う価値のあるものが見つかったら知らせてくれる専用スカウトを提供します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget memberimu scout pribadi yang mempelajari seleramu, memburu di web, dan memberi tahu saat menemukan sesuatu yang layak dibeli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget มีสเกาต์ส่วนตัวที่เรียนรู้รสนิยมของคุณ ออกตามหาทั่วเว็บ แล้วบอกคุณเมื่อเจอของที่น่าซื้อ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget आपको पर्सनल स्काउट देता है, जो आपकी पसंद सीखते हैं, वेब खंगालते हैं और कुछ खरीदने लायक मिलते ही बता देते हैं।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binibigyan ka ng Baget ng mga personal na scout na natututo sa taste mo, naghahanap sa web, at nagsasabi sa iyo kapag may nakita silang sulit bilhin."
          }
        }
      }
    },
    "Baget isn't connected to a server yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget aún no está conectado a un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget n'est pas encore connecté à un serveur."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget이 아직 서버에 연결되지 않았어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 尚未连接到服务器。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget chưa được kết nối với máy chủ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 尚未連接伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetはまだサーバーに接続されていません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget belum terhubung ke server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget ยังไม่ได้เชื่อมต่อกับเซิร์ฟเวอร์"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget अभी किसी सर्वर से कनेक्टेड नहीं है।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nakakonekta ang Baget sa server."
          }
        }
      }
    },
