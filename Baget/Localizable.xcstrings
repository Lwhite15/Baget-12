    "Today is your daily feed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es tu feed diario"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Today ang daily feed mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, c'est ton fil du jour"
          }
        },
        "hi": {
