            "value": "ใช่ ฉันซื้อแล้ว"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Oo, binili ko ito"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ, खरीद लिया"
          }
        }
      }
    },
    "Yo! The %@ drops %@ at %@. Total %@ energy. Want me to line up checkout?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Yo! The %1$@ drops %2$@ at %3$@. Total %4$@ energy. Want me to line up checkout?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Ey! El %1$@ sale %2$@ en %3$@. Pura energía %4$@. ¿Quieres que prepare la compra?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hé ! Le %1$@ sort %2$@ à %3$@. Grosse énergie %4$@. Je prépare le paiement ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야! %1$@ %2$@에 %3$@에서 출시돼요. 완전 %4$@ 느낌이에요. 결제 준비해 둘까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ねえ!%1$@が%3$@で%2$@に発売だよ。まさに%4$@って感じ。購入の準備しとこうか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿!%1$@ 将于 %2$@ 在 %3$@ 发售。满满的 %4$@ 风。要我帮你准备结账吗?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿！%1$@ 將於 %2$@ 在 %3$@ 發售，滿滿的 %4$@ 感。要我幫你準備結帳嗎？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ê! %1$@ ra mắt %2$@ lúc %3$@. Đúng chất %4$@ luôn. Muốn mình chuẩn bị thanh toán không?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo! %1$@ rilis %2$@ di %3$@. Vibes %4$@ banget. Mau kuatur checkout-nya?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฮ้ย! %1$@ จะวางขาย %2$@ ที่ %3$@ ฟีลแบบ %4$@ สุด ๆ ให้ฉันเตรียมชำระเงินไหม?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Uy! Magda-drop ang %1$@ ng %2$@ sa %3$@. Sobrang %4$@ energy. Gusto mo bang ihanda ko ang checkout?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अरे! %1$@ %2$@ को %3$@ पर ड्रॉप हो रहा है। पूरा %4$@ वाला मूड। चेकआउट तैयार करवा दूँ?"
          }
        }
      }
    },
