    "Nothing here yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有内容"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì ở đây"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
