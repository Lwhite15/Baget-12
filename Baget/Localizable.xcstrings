          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我在 Baget 上尋寶。加我 @%@，一起比比品味吧。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagha-hunt ako sa Baget. I-add mo ako, @%@, para ma-compare natin ang taste natin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetでハント中です。@%@ を追加して、お互いのテイストを比べましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku lagi berburu di Baget. Tambahkan aku, @%@, biar kita bisa bandingkan selera."
          }
        }
      }
    },
    "I'm on it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voy con todo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako na bahala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'en occupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं लगा हुआ हूँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku urus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任せてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맡겨주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันจัดการเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình lo vụ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给我吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交給我。"
          }
        }
      }
    },
    "I'm on it. I'll text you when I find something.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me pongo a ello. Te escribo cuando encuentre algo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako na bahala. Ite-text kita pag may nahanap ako."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'en occupe. Je t'écris dès que je trouve quelque chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं लगा हुआ हूँ। कुछ मिलते ही आपको टेक्स्ट मिलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku urus. Nanti kukabari kalau ada yang ketemu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任せてください。見つかったらメッセージします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맡겨주세요. 뭔가 찾으면 문자 드릴게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันจัดการเอง เจออะไรจะส่งข้อความบอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình lo vụ này. Có gì mình nhắn bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给我吧。有发现就发消息给你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交給我。找到東西就傳訊給你。"
          }
        }
      }
    },
    "I'm seeing %@, mostly in %@. I'll hunt %@ with that energy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "I'm seeing %1$@, mostly in %2$@. I'll hunt %3$@ with that energy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo %1$@, sobre todo en %2$@. Buscaré %3$@ con esa vibra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakikita ko ang %1$@, kadalasan sa %2$@. Ganyang vibe ang hahanapin ko sa %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vois %1$@, surtout en %2$@. Je chasse les %3$@ dans cet esprit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ दिख रहा है, ज़्यादातर %2$@ में। उसी एनर्जी वाले %3$@ हंट करने हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku melihat %1$@, terutama di %2$@. Aku akan berburu %3$@ dengan nuansa itu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が気になっているようですね。特に%2$@。その雰囲気で%3$@を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스타일이 보여요, 특히 %2$@ 위주로요. 그 느낌으로 %3$@ 찾아볼게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเห็น %1$@ ส่วนใหญ่เป็น %2$@ ฉันจะล่า%3$@ ด้วยฟีลนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình thấy %1$@, chủ yếu ở %2$@. Mình sẽ săn %3$@ theo hướng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到%1$@,主要是%2$@。我会按这种风格搜寻%3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到 %1$@,多半是 %2$@。我會用這種感覺去找%3$@。"
          }
        }
      }
    },
