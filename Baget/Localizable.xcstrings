    "Sold out at the source. I'll watch for a restock and won't let you overpay resale.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agotado en la fuente. Estaré atento a que lo repongan y no dejaré que pagues de más en reventa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sold out sa source. Babantayan ko ang restock at hindi kita hahayaang magbayad nang sobra sa resale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épuisé à la source. Je surveille le réassort et je t'évite de payer trop cher en revente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोर्स पर स्टॉक ख़त्म है। मैं रीस्टॉक पर नज़र रखूँगा और रीसेल में आपको ज़्यादा पैसे नहीं देने दूँगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Habis di sumbernya. Aku akan pantau stok ulangnya dan nggak akan biarkan kamu bayar kemahalan di resale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "販売元で売り切れです。再入荷を見張って、転売で高く買わないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 판매처에서 품절됐어요. 재입고를 지켜보고, 비싼 리셀가는 사지 않게 할게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดที่ต้นทางแล้ว เดี๋ยวคอยดูตอนของเข้า และจะไม่ปล่อยให้คุณจ่ายแพงเกินในตลาดรีเซล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn đã hết hàng. Mình sẽ canh hàng về lại và không để bạn mua lại với giá cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "货源已售罄。我会盯着补货,不让你多花冤枉钱买转售款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原店已售完。我會盯著補貨，不讓你多花錢買轉售價。"
          }
        }
      }
    },
    "Sold out right now. %@ will watch for a restock and tell you the moment it's back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agotado por ahora. %@ estará atento a la reposición y te avisará en cuanto vuelva."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sold out ngayon. Babantayan ng %@ ang restock at sasabihan ka agad pag bumalik na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épuisé pour l'instant. %@ surveillera le retour en stock et te préviendra dès qu'il sera là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी स्टॉक में नहीं है। %@ रीस्टॉक पर नज़र रखेगा और वापस आते ही आपको बता देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagi habis. %@ akan memantau stok ulangnya dan langsung mengabarimu begitu tersedia lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在売り切れです。%@が再入荷を見張って、戻りしだいすぐお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 품절이에요. %@이(가) 재입고를 지켜보다가 들어오는 즉시 알려 드릴게요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ของหมด %@ จะคอยดูว่ากลับมาเมื่อไหร่ แล้วบอกคุณทันทีที่มีของ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện đã hết hàng. %@ sẽ canh hàng về và báo ngay khi có lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已售罄。%@ 会盯着补货,一到货就告诉你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已售完。%@ 會盯著補貨，一有貨就通知你。"
          }
        }
      }
    },
