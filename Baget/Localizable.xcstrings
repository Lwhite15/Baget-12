    " Everything else still shows up in your inbox.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Todo lo demás sigue apareciendo en tu bandeja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tout le reste arrive toujours dans ta boîte de réception."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 나머지는 모두 받은편지함에 그대로 표시돼요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Semua yang lain tetap muncul di kotak masukmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Mọi thứ khác vẫn hiện trong hộp thư của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 其他通知仍會顯示在你的收件匣。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 其他内容仍会显示在收件箱中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外はすべて受信ボックスに届きます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " ส่วนที่เหลือยังอยู่ในกล่องข้อความเหมือนเดิม"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " बाकी सब कुछ अब भी आपके इनबॉक्स में दिखेगा।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": " Lahat ng iba ay makikita pa rin sa inbox mo."
          }
        }
      }
    },
