    "Love that. Thanks for thinking of me.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me encanta. Gracias por pensar en mí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'adore. Merci d'avoir pensé à moi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋네요. 생각해 줘서 고마워요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うれしい!思い出してくれてありがとう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太好了,谢谢你想着我。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thích quá. Cảm ơn bạn đã nghĩ đến mình."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suka banget. Makasih sudah mengingatku."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了,謝謝你想到我。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชอบเลย ขอบคุณที่นึกถึงนะ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Love ko 'yan. Salamat sa pag-alala sa akin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अच्छा लगा। मेरे बारे में सोचने के लिए शुक्रिया।"
          }
        }
      }
    },
    "Love the palette: %@. I'll look for %@ in those tones.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Love the palette: %1$@. I'll look for %2$@ in those tones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me encanta la paleta: %1$@. Buscaré %2$@ en esos tonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'adore la palette : %1$@. Je chercherai %2$@ dans ces tons."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔레트가 좋네요: %1$@. 그 톤의 %2$@를 찾아볼게요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパレット、素敵です:%1$@。その色合いで%2$@を探しますね。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢这个色调:%1$@。我会找这些色调的%2$@。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mê bảng màu này: %1$@. Mình sẽ tìm %2$@ theo tông đó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suka palet warnanya: %1$@. Aku akan cari %2$@ dengan nuansa itu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好喜歡這個色調:%1$@。我會用這些色調尋找%2$@。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชอบโทนสีนี้: %1$@ เดี๋ยวหา%2$@ในโทนนี้ให้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Love ang palette: %1$@. Hahanap ako ng %2$@ sa mga tone na 'yan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैलेट पसंद आया: %1$@। इन रंगों में %2$@ की तलाश रहेगी।"
          }
        }
      }
    },
