    "Busy right now. Try again in a minute.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos ocupados. Inténtalo en un minuto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy ngayon. Subukan ulit mamaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de monde. Réessaie dans une minute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी व्यस्त है। एक मिनट बाद फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
