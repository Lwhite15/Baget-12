            "value": "और बताएँ"
          }
        }
      }
    },
    "Tell me what you're into, or ask me to find something": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dime qué te gusta o pídeme que busque algo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-moi ce qui te plaît, ou demande-moi de trouver quelque chose"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심사를 알려주시거나 찾아달라고 말해 보세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなものを教えてください。探し物の依頼もOKです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我你的喜好,或让我帮你找东西"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我你喜歡什麼，或請我幫你找東西"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho mình biết bạn thích gì, hoặc nhờ mình tìm món nào đó"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang kamu suka, atau minta aku mencarikan sesuatu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกได้เลยว่าชอบอะไร หรือให้ช่วยหาของก็ได้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin mo kung ano'ng type mo, o ipahanap sa akin ang isang bagay"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताइए आपको क्या पसंद है, या कुछ ढूँढने को कहिए"
          }
        }
      }
    },
    "Tell the scout what to hunt.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile al explorador qué buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à l'éclaireur quoi chasser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트에게 찾을 것을 알려주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトに探すものを伝えましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉猎手要找什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴偵察員要找什麼。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho trinh sát biết cần săn gì."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu scout apa yang harus diburu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกสเคาต์ว่าให้ตามหาอะไร"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin sa scout kung ano ang hahanapin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्काउट को बताएँ कि क्या ढूँढना है।"
          }
        }
      }
    },
    "Tell this scout what to hunt. Anything works.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a este explorador qué buscar. Lo que sea sirve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à cet éclaireur quoi chasser. Tout est permis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스카우트에게 찾을 것을 알려주세요. 뭐든 좋아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスカウトに探すものを伝えましょう。何でもOKです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉这位猎手要找什么。什么都行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴這位偵察員要找什麼，什麼都可以。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho trinh sát này biết cần săn gì. Gì cũng được."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu scout ini apa yang harus diburu. Apa saja boleh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกสเคาต์ตัวนี้ว่าให้ตามหาอะไร อะไรก็ได้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin sa scout na ito kung ano ang hahanapin. Kahit ano."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्काउट को बताएँ कि क्या ढूँढना है। कुछ भी चलेगा।"
          }
        }
