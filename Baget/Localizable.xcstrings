        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Envoyé directement à l'équipe Baget."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुक्रिया! सीधे Baget टीम को भेज दिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih! Langsung terkirim ke tim Baget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます!Bagetチームに届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사해요! Baget 팀에 바로 전달했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณ! ส่งถึงทีม Baget แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn! Đã gửi thẳng đến đội ngũ Baget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢!已直接发给 Baget 团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝！已直接傳送給 Baget 團隊。"
          }
        }
      }
    },
    "That email and password don't match. Check them, or switch to Create account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo y contraseña no coinciden. Revísalos o cambia a Crear cuenta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tugma ang email at password. Suriin ito, o lumipat sa Create account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet e-mail et ce mot de passe ne correspondent pas. Vérifie-les ou passe à Créer un compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल और पासवर्ड मेल नहीं खा रहे। जाँच लें, या खाता बनाएँ पर जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email dan kata sandi tidak cocok. Periksa lagi, atau beralih ke Buat akun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスかパスワードが違います。確認するか、「アカウント作成」に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일과 비밀번호가 일치하지 않아요. 다시 확인하거나 계정 만들기로 전환해 주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลกับรหัสผ่านไม่ตรงกัน ตรวจสอบอีกครั้ง หรือเปลี่ยนไปที่สร้างบัญชี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email và mật khẩu không khớp. Hãy kiểm tra lại, hoặc chuyển sang Tạo tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱和密码不匹配。请检查,或切换到“创建账户”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件與密碼不符。請檢查，或改選「建立帳號」。"
          }
        }
      }
    },
    "That image couldn't be opened. Try another one.": {
