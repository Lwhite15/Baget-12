          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的小隊目前最推薦的 %lld 個。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld món hay nhất của đội scout lúc này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld terbaik timmu saat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld อันดับเด่นของทีมคุณตอนนี้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinakamagagandang %lld ng squad mo ngayon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी टीम की अभी की बेस्ट %lld।"
          }
        }
      }
    },
    "Your squad's first hunt is on": {
      "localizations": {
