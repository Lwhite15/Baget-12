    "No new finds right now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay hallazgos nuevos por ahora"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang bagong nahanap ngayon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune nouvelle trouvaille pour l'instant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई नई खोज नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada temuan baru"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は新しい発見がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 새 발견이 없어요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่มีของที่เจอใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa có phát hiện mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有新发现"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有新發現"
          }
        }
      }
    },
    "No one on Baget goes by @%@. Check the spelling.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie en Baget usa @%@. Revisa la ortografía."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang gumagamit ng @%@ sa Baget. Tingnan ang spelling."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne sur Baget ne s'appelle @%@. Vérifie l'orthographe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget पर @%@ नाम से कोई नहीं है। स्पेलिंग जाँच लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang bernama @%@ di Baget. Periksa ejaannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagetに@%@さんはいません。スペルをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget에 @%@ 님은 없어요. 철자를 확인해 주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีใครใน Baget ใช้ @%@ ลองเช็กตัวสะกดดู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai trên Baget dùng @%@. Kiểm tra lại chính tả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 上没有人叫 @%@,请检查拼写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baget 上沒有人叫 @%@。請檢查拼字。"
          }
        }
      }
    },
    "No scouts yet. Tell Baget what you're hunting above.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay exploradores. Cuéntale arriba a Baget qué estás buscando."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ka pang scout. Sabihin sa Baget sa itaas kung ano ang hinahanap mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'éclaireur. Dis à Baget ce que tu cherches ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई स्काउट नहीं। ऊपर बताएँ कि आप क्या ढूँढ रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada scout. Ceritakan ke Baget apa yang kamu buru di atas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトはまだいません。上で探しているものをBagetに伝えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스카우트가 없어요. 위에 찾는 걸 알려주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสเกาต์ บอก Baget ด้านบนว่ากำลังล่าอะไรอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trinh sát. Hãy nói với Baget bạn đang săn gì ở trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有侦察员。在上方告诉 Baget 你想找什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有探員。在上方告訴 Baget 你想找什麼。"
          }
        }
      }
    },
    "No scouts yet. Tell Baget what you're hunting on Today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay exploradores. Cuéntale a Baget qué buscas en Hoy."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ka pang scout. Sabihin sa Baget sa Today kung ano ang hinahanap mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'éclaireur. Dis à Baget ce que tu cherches sur Today."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई स्काउट नहीं। Today पर बताएँ कि आप क्या ढूँढ रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada scout. Ceritakan ke Baget apa yang kamu buru di Today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトはまだいません。Todayで探しているものをBagetに伝えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스카우트가 없어요. 투데이에서 찾는 걸 알려주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสเกาต์ บอก Baget ในหน้า Today ว่ากำลังล่าอะไรอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trinh sát. Hãy nói với Baget bạn đang săn gì ở Hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有侦察员。在“Today”页告诉 Baget 你想找什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有探員。在「今日」告訴 Baget 你想找什麼。"
          }
        }
      }
    },
