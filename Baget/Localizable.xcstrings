          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた：アイコン、設定、アカウント"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我：圖示、設定與帳號"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn: biểu tượng, cài đặt và tài khoản"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu: ikon, pengaturan, dan akun"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณ: ไอคอน การตั้งค่า และบัญชี"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw: icon, settings at account"
          }
        },
        "hi": {
