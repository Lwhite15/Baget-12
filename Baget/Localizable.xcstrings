    "Non-urgent texts wait for morning. Restocks, purchases and drops starting within 90 minutes still come through.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes no urgentes esperan hasta la mañana. Reposiciones, compras y lanzamientos que empiecen en menos de 90 minutos sí llegan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maghihintay ng umaga ang mga hindi urgent na text. Papasok pa rin ang restocks, purchases, at drops na magsisimula sa loob ng 90 minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les SMS non urgents attendent le matin. Réassorts, achats et drops dans moins de 90 minutes passent quand même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरी न होने वाले टेक्स्ट सुबह तक रुकते हैं। रीस्टॉक, खरीदारी और 90 मिनट में शुरू होने वाले ड्रॉप फिर भी आएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan tidak mendesak menunggu pagi. Restock, pembelian, dan drop yang mulai dalam 90 menit tetap dikirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急でないメッセージは朝までお待ちします。再入荷、購入、90分以内に始まるドロップはお届けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급하지 않은 문자는 아침까지 기다려요. 재입고, 구매, 90분 안에 시작하는 드롭은 그대로 알려드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความไม่เร่งด่วนจะรอถึงเช้า ส่วนของเข้าใหม่ การซื้อ และดรอปที่เริ่มใน 90 นาทียังส่งตามปกติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn không gấp sẽ chờ đến sáng. Hàng về lại, đơn mua và drop bắt đầu trong 90 phút vẫn được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非紧急短信会等到早上发送。补货、购买以及90分钟内开始的发售仍会正常提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非緊急簡訊會等到早上。補貨、購買,以及 90 分鐘內開始的發售仍會通知你。"
          }
        }
      }
    },
