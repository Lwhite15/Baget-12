    "%@ will text you on a price drop, restock or release": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te enviará un mensaje si baja el precio, hay reposición o un lanzamiento"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magte-text sa'yo ang %@ kapag bumaba ang presyo, nag-restock o nag-release"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ t'enverra un SMS en cas de baisse de prix, de réassort ou de sortie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमत गिरने, रीस्टॉक या रिलीज़ पर %@ आपको टेक्स्ट करेगा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan kirim SMS saat harga turun, restock, atau rilis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値下げ、再入荷、発売の際は%@がテキストでお知らせします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 가격 인하, 재입고, 출시 때 문자로 알려드려요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะส่งข้อความหาคุณเมื่อราคาลด ของเข้า หรือมีของใหม่วางขาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ nhắn tin khi giá giảm, hàng về hoặc có bản phát hành mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会在降价、补货或发售时发短信通知你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會在降價、補貨或發售時傳訊息給你"
          }
        }
      }
    },
