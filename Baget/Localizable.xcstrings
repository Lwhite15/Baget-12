    "By continuing, you agree to the Terms of Use and Privacy Policy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas los Términos de Uso y la Política de Privacidad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa pagpapatuloy, sumasang-ayon ka sa Terms of Use at Privacy Policy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les Conditions d'utilisation et la Politique de confidentialité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे बढ़ने पर आप उपयोग की शर्तों और गोपनीयता नीति से सहमत होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan melanjutkan, kamu menyetujui Ketentuan Penggunaan dan Kebijakan Privasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると、利用規約とプライバシーポリシーに同意したものとみなされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 이용약관과 개인정보 처리방침에 동의하는 거예요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อดำเนินการต่อ แสดงว่าคุณยอมรับข้อกำหนดการใช้งานและนโยบายความเป็นส่วนตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng việc tiếp tục, bạn đồng ý với Điều khoản sử dụng và Chính sách quyền riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示你同意《使用条款》和《隐私政策》。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續即表示你同意使用條款與隱私權政策。"
          }
        }
      }
    },
