          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時下拉即可查看新發現"
          }
        }
      }
    },
    "Purchased %@ for %@. It's in your Finds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Purchased %1$@ for %2$@. It's in your Finds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compraste %1$@ por %2$@. Está en tus Hallazgos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabili ang %1$@ sa halagang %2$@. Nasa Mga Nahanap mo na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ acheté pour %2$@. Il est dans tes Trouvailles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को %2$@ में खरीदा। यह आपकी खोज में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membeli %1$@ seharga %2$@. Sudah ada di Temuanmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を%2$@で購入しました。発見に入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 상품을 %2$@에 구매했어요. 발견에 저장됐어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อ %1$@ ในราคา %2$@ แล้ว อยู่ในของที่เจอของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mua %1$@ với giá %2$@. Món này nằm trong Phát hiện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已以 %2$@ 购买 %1$@。它在你的发现中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已以 %2$@ 購買 %1$@。已在你的發現中。"
          }
        }
      }
    },
