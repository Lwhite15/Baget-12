    "%@. Ships from outside the US, so duties or import fees may apply.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se envía desde fuera de EE. UU., así que podrían aplicar aranceles o cargos de importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Expédié hors des États-Unis : des droits de douane ou frais d'importation peuvent s'appliquer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 미국 외 지역에서 배송돼 관세나 수입 수수료가 부과될 수 있어요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Dikirim dari luar AS, jadi bea atau biaya impor mungkin berlaku."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Gửi từ ngoài Hoa Kỳ nên có thể phát sinh thuế hoặc phí nhập khẩu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。從美國境外出貨,可能需支付關稅或進口費用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。从美国境外发货,可能需缴关税或进口费用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。米国外から発送されるため、関税や輸入手数料がかかる場合があります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ส่งจากนอกสหรัฐฯ อาจมีภาษีหรือค่าธรรมเนียมนำเข้า"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। US के बाहर से शिप होता है, इसलिए ड्यूटी या इंपोर्ट फ़ीस लग सकती है।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Galing sa labas ng US ang shipping, kaya posibleng may duties o import fees."
          }
        }
      }
    },
