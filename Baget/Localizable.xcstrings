            "state": "translated",
            "value": "對，我買了"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, mình đã mua rồi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, sudah kubeli"
          }
        },
        "th": {
          "stringUnit": {
