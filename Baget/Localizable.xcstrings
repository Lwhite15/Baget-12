    "A heads-up when something you'd love drops, restocks or goes on sale.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso cuando algo que te encantaría se lance, se reponga o esté en oferta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abiso kapag may bagong drop, restock o sale ng gusto mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte quand un article qui te plaît sort, revient en stock ou passe en promo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी पसंद की चीज़ आए, रीस्टॉक हो या सेल में लगे, तो झट से खबर पाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabar saat barang incaranmu rilis, restock, atau diskon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になるアイテムが発売・再入荷・セールになったらお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아할 만한 상품이 출시되거나 재입고, 할인되면 알려드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนเมื่อของที่คุณรักวางขาย ของเข้า หรือลดราคา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cho bạn khi món bạn mê sắp ra mắt, có hàng lại hoặc giảm giá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心仪的商品发售、补货或打折时,第一时间提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你心儀的商品發售、補貨或特價時,馬上通知你。"
          }
        }
      }
    },
    "A new scout hunts it for you, the way %@ loves it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuevo explorador lo busca para ti, como a %@ le encanta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May bagong scout na maghahanap nito para sa iyo, gaya ng gusto ni %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouvel éclaireur part à sa chasse, comme %@ l'aime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नया स्काउट इसे आपके लिए ढूँढेगा, वैसे ही जैसे %@ को पसंद है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout baru memburunya untukmu, sesuai selera %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんの好みに合わせて、新しいスカウトが探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 스카우트가 %@ 님이 좋아하는 방식으로 찾아줄 거예요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเกาต์ตัวใหม่จะตามหาให้คุณ ในสไตล์ที่ %@ ชอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một scout mới sẽ săn món này cho bạn, đúng gu %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新侦察员会按%@喜欢的方式为你搜寻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新探員會依 %@ 喜歡的方式幫你搜尋。"
          }
        }
      }
    },
    "A page of listings on %@, not a single item": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página de listados en %@, no un solo artículo"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahina ng mga listing sa %@, hindi isang item"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page d'annonces sur %@, pas un article unique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर लिस्टिंग का पेज, कोई एक आइटम नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman daftar produk di %@, bukan satu barang"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の一覧ページで、単一の商品ではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 상품이 아닌 %@의 목록 페이지"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้ารวมรายการบน %@ ไม่ใช่สินค้าชิ้นเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một trang danh sách trên %@, không phải một sản phẩm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
